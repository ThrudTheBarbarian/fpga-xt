   289 				;==========================================================================
   290 				; Run a test.
   291
   292 				; X = test index
   293 A1E2			.proc	runtest
   294 						;check if this test exists
   295 A1E2 BD 01 BF				lda		segaddrlo+1,x
   296 A1E5 1D 81 BF				ora		segaddrhi+1,x
   297 A1E8 D0 01				bne		testOK
   298 A1EA 60					rts	
   299 A1EB			testOK:
   300 A1EB 8A					txa
   301 A1EC 48					pha
   302 A1ED 38 E9 00				sub		#TEST_FIRST-1
   303 A1F0 85 C9				sta		d1
   304 A1F2 A5 C0				lda		a0
   305 A1F4 48					pha
   306 A1F5 A5 C1				lda		a0+1
   307 A1F7 48					pha
   308 A1F8 20 59 41				jsr		_imprintf
   309 A1FB 4C 6F 61 64 69 6E + 		dta		c"Loading test %d",0
   310 A20B 68					pla
   311 A20C 85 C1				sta		a0+1
   312 A20E 68					pla
   313 A20F 85 C0				sta		a0
   314 								
   315 						;store return stack ptr
   316 A211 BA					tsx
   317 A212 E8					inx
   318 A213 E8					inx
   319 A214 8D 88 02				sta		_exitTestS
   320 						
   321 						;load segment
   322 A217 68					pla
   323 A218 AA					tax
   324 A219 20 D6 43				jsr		_loadSeg
   325 						
   326 						;clear loading message
   327 A21C 20 46 41				jsr		_imprint
   328 A21F 9C 00				dta		$9c,0
   329 						
   330 						;run segment
   331 A221 4C DA 43				jmp		_runSeg
   332 				.endp
