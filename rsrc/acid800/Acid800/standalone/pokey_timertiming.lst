   266 						;====== 16-bit timer tests ========================================
   267 						; Checks the cycle at which the IRQ bit is asserted in IRQST.
   268 						; A/B values are cycles after STIMER write before/after bit 0/1 is
   269 						; cleared for timer 1/2. In general, the timer 1 values are similar
   270 						; to the 8-bit case except for the additional 3 cycles on the
   271 						; period, and the timer 2 values lag the timer 1 values by 3 cycles.
   272 						;
   273 						;					IRQST1		IRQST2
   274 						; AUDF=$0000 T1		 7c/ 8c		14c/15c		*extrapolated
   275 						; AUDF=$0000 T2		10c/11c		17c/18c		*extrapolated
   276 						; AUDF=$0010 T1		23c/24c		43c/44c
   277 						; AUDF=$0010 T2		26c/27c		46c/47c
   278 						;
   279 						
   280 						;switch to linked timers
