   520 						dta		c"SAP",$0d,$0a
   521 						dta		c"AUTHOR ",$22,c"Avery Lee",$22,$0d,$0a
   522 						dta		c"NAME ",$22,c":1",$22,$0d,$0a
   523 						dta		c"TYPE D",$0d,$0a
   524 						dta		c"INIT 2000",$0d,$0a
