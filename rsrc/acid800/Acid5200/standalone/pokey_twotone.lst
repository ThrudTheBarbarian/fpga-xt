  1556 A462 06 CC			asl		d4
  1557 A464 90 05			bcc		all_literals
  1558 					
  1559 					;nope... read next byte as flags byte
  1560 A466 20 B8 A4			jsr		getrawbyte
  1561 A469 85 C8			sta		d0
  1562
  1563 A46B			all_literals:
