    45 				;==========================================================================
    46 				.proc _kybd_handler
    47 					;The bass-ackward design of the 5200 keyboard causes an IRQ to occur
    48 					;every 32 scanlines while a key is held down. We require keys to be
    49 					;released for at least one full frame before we recognize another
    50 					;one.
    51 					ldx		keydel
    52 					sne:sta	ch
    53 					lda		#2
    54 					sta		keydel
    55 					pla
    56 					tay
    57 					pla
    58 					tax
    59 					pla
    60 					rti
    61 				.endp
    62
    63 				;==========================================================================
    64 				.proc _vbd_handler
    65 					lda		keydel
    66 					seq:dec	keydel
    67 					
    68 					plr
    69 					rti
    70 				.endp
