    27
    28 				.macro _DELAY_CYCLES_X
    29 					;validate parameters
    30 					.if :0 != 1
    31 					.error "Cycle count required." c' '
    32 					.endif
    33 						
    34 					.if :1 < 2
    35 					.error "Cycle count must be at least 2." c' '
    36 					.endif
    37 					
    38 					.if :1 > 1000
    39 					.error "Cycle count is too large." c' '
    40 					.endif
    41 					
    42 					.def ?cycles = :1
    43 					
    44 					.if ?cycles == 660 || ?cycles >= 662
    45 						.def ?cycles = ?cycles - 660
    46 						jsr		delay660
    47 					.endif
    48 				
    49 					.if ?cycles == 408 || ?cycles >= 410
    50 						.def ?cycles = ?cycles - 408
    51 						jsr		delay408
    52 					.endif
    53 				
    54 					.if ?cycles == 252 || ?cycles >= 254
    55 						.def ?cycles = ?cycles - 252
    56 						jsr		delay252
    57 					.endif
    58 				
    59 					.if ?cycles == 156 || ?cycles >= 158
    60 						.def ?cycles = ?cycles - 156
    61 						jsr		delay156
    62 					.endif
    63 				
    64 					.if ?cycles == 96 || ?cycles >= 98
    65 						.def ?cycles = ?cycles - 96
    66 						jsr		delay96
    67 					.endif
    68 				
    69 					.if ?cycles == 60 || ?cycles >= 62
    70 						.def ?cycles = ?cycles - 60
    71 						jsr		delay60
    72 					.endif
    73 				
    74 					.if ?cycles == 36 || ?cycles >= 38
    75 						.def ?cycles = ?cycles - 36
    76 						jsr		delay36
    77 					.endif
    78 				
    79 					.if ?cycles == 24 || ?cycles >= 26
    80 						.def ?cycles = ?cycles - 24
    81 						jsr		delay24
    82 					.endif
    83 				
    84 					;14-23 cycles we can hit exactly
    85 					.if ?cycles >= 23
    86 						.def ?cycles = ?cycles - 23
    87 						jsr		delay23
    88 					.endif
    89 				
    90 					.if ?cycles >= 22
    91 						.def ?cycles = ?cycles - 22
    92 						jsr		delay22
    93 					.endif
    94 				
    95 					.if ?cycles >= 21
    96 						.def ?cycles = ?cycles - 21
    97 						jsr		delay21
    98 					.endif
    99 				
   100 					.if ?cycles >= 20
   101 						.def ?cycles = ?cycles - 20
   102 						jsr		delay20
   103 					.endif
   104 				
   105 					.if ?cycles >= 19
   106 						.def ?cycles = ?cycles - 19
   107 						jsr		delay19
   108 					.endif
   109 				
   110 					.if ?cycles >= 18
   111 						.def ?cycles = ?cycles - 18
   112 						jsr		delay18
   113 					.endif
   114 				
   115 					.if ?cycles >= 17
   116 						.def ?cycles = ?cycles - 17
   117 						jsr		delay17
   118 					.endif
   119 				
   120 					.if ?cycles >= 16
   121 						.def ?cycles = ?cycles - 16
   122 						jsr		delay16
   123 					.endif
   124 				
   125 					.if ?cycles >= 15
   126 						.def ?cycles = ?cycles - 15
   127 						jsr		delay15
   128 					.endif
   129 				
   130 					.if ?cycles >= 14
   131 						.def ?cycles = ?cycles - 14
   132 						jsr		delay14
   133 					.endif
   134 				
   135 					;12 cycles we can hit exactly
   136 					.if ?cycles == 12
   137 						.def ?cycles = ?cycles - 12
   138 						jsr		delay12
   139 					.endif
   140 					
   141 					;At this point we have 2-11 or 13 cycles, which we handle through combinations of
   142 					;nop + jmp to avoid changing any state. This can take up to 4 JMPs and two NOPs.
   143 					.if ?cycles > 4 || ?cycles == 3
   144 						.def ?cycles = ?cycles - 3
   145 						jmp		*+3
   146 					.endif
   147 					.if ?cycles > 4 || ?cycles == 3
   148 						.def ?cycles = ?cycles - 3
   149 						jmp		*+3
   150 					.endif
   151 					.if ?cycles > 4 || ?cycles == 3
   152 						.def ?cycles = ?cycles - 3
   153 						jmp		*+3
   154 					.endif
   155 					.if ?cycles > 4 || ?cycles == 3
   156 						.def ?cycles = ?cycles - 3
   157 						jmp		*+3
   158 					.endif
   159 					.if ?cycles == 4
   160 						nop
   161 						nop
   162 					.elseif ?cycles == 2
   163 						nop
   164 					.elseif ?cycles != 0
   165 						.error "Internal error" c' '
   166 					.endif
   167 				.endm
   168
   169 				;==========================================================================
   170 				; POKEY timer timing tests
   171 				;
   172 				; Many timings are given below in the form XX/YY where XX and YY are cycles
   173 				; after a write to STIMER. They indicate a tight cycle count bound for when
   174 				; an event occurs. For instance, 15c/16c for IRQST bit 0 means that IRQST
   175 				; bit 0 is deasserted (1) when read 15 cycles after the cycle on which
   176 				; STIMER is written, and asserted (0) when read 16 cycles after. Thus, the
   177 				; second number indicates the first cycle on which the change is visible.
   178 				; These are also the two cycle offsets at which the test checks to
   179 				; precisely check the cycle delay.
   180 				;
   181 				; *extrapolated means timing values that are not directly measured due to
   182 				; difficulty, i.e. 6502 not fast enough, but are inferred from the measured
   183 				; cases.
   184 				;
   185
   186 						org		$2000
   187
   188 				.nowarn .proc main
   189 2000					_INITTEST c"POKEY: Timer timing"
Macro: _INITTEST [Source: library.s]
     1 FFFF> 2000-3912> 20 21 + 	jsr		_imTestInit
     2 2003 50 4F 4B 45 59 3A + 	dta		c"POKEY: Timer timing",0
Source: pokey_timertiming.s
   190
