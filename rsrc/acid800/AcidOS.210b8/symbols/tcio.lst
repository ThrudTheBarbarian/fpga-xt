   228 				;=======================================================================
   229 				.nowarn .proc _log_clearline
   230 						ldy		#39
   231 						lda		#0
   232 						sta:rpl	(_log_curln),y-
   233 				xit:
   234 						ldy		#2
   235 						sty		_log_curx
   236 						lda		#$80
   237 						sta		(_log_curln),y
   238 						rts
   239 				.endp
   240
   241 				;=======================================================================
   242 				; Modified:
   243 				;	A, Y
   244 				;
   245 				; Preserved:
   246 				;	X
   247 				;
   248 				; Control codes handled:
   249 				;	$7D		clear
   250 				;	$9B		end of line
   251 				;	$9C		clear line
   252 				;
   253 				.nowarn .proc _log_putchar
   254 						;check for EOL
   255 						cmp		#$9b
   256 						bne		not_eol
   257 						ldy		_log_curx
   258 						lda		#0
   259 						sta		(_log_curln),y
   260 						beq		wrap
   261 				not_eol:
   262 						;check for clear
   263 						cmp		#$7d
   264 						beq		_log_cls
   265 						
   266 						;check for clear line
   267 						cmp		#$9c
   268 						beq		_log_clearline
   269 						
   270 						;convert ATASCII to INTERNAL
   271 						pha
   272 						rol
   273 						rol
   274 						rol
   275 						rol
   276 						and		#$03
   277 						tay
   278 						pla
   279 						eor		conv_tab,y
   280
   281 						ldy		_log_curx
   282 						sta		(_log_curln),y
   283 						iny
   284 						cpy		#40
   285 						bcs		wrap
   286 						sty		_log_curx
   287 				done:
   288 						lda		#$80
   289 						sta		(_log_curln),y
   290 						rts
   291 				wrap:
   292 						ldy		#2
   293 						sty		_log_curx
   294 						lda		_log_curln
   295 						adc		#39
   296 						sta		_log_curln
   297 						scc:inc	_log_curln+1
   298 						
   299 						lda		_log_curln+1
   300 						cmp		#>_log_displayend
   301 						bne		no_scroll
   302 				scroll:
   303 						ldy		#<(_log_display+40)
   304 						mva:rne	_log_display&$ff00,y +(_log_display&$ff00)-40,y+
   305 						mva:rne	$100+(_log_display&$ff00),y $100+(_log_display&$ff00)-40,y+
   306 						mva:rne	$200+(_log_display&$ff00),y $200+(_log_display&$ff00)-40,y+
   307 						mva:rne	$300+(_log_display&$ff00),y $300+(_log_display&$ff00)-40,y+
   308
   309 						mva		#$d8 _log_curln
   310 						dec		_log_curln+1
   311
   312 						jsr		_log_clearline
   313 				no_scroll:
   314 						;check if paging is enabled
   315 						bit		_log_flags
   316 						bpl		done
   317 						
   318 						;check if we've done a page
   319 						inc		_log_lncnt
   320 						lda		_log_lncnt
   321 						cmp		#21
   322 						bcc		done
   323 						mva		#0 _log_lncnt
   324 						
   325 						ldy		#9
   326 				more_loop:
   327 						lda		more_msg-2,y
   328 						sta		(_log_curln),y
   329 						dey
   330 						cpy		#1
   331 						bne		more_loop
   332 						
   333 						jsr		_waitKey
   334 						jsr		_log_clearline
   335 						jmp		done
   336 						
   337 				more_msg:
   338 						dta		"--More--"
   339
   340 				conv_tab:
   341 						dta		$40
   342 						dta		$20
   343 						dta		$60
   344 						dta		$00
   345 				.endp
