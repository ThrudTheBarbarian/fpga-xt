   177 				;=======================================================================
   178 				;	A = column
   179 				;	X = row
   180 				.nowarn .proc _log_gotoxy
   181 						;save new X
   182 						pha
   183 						
   184 						;erase existing cursor
   185 						ldy		_log_curx
   186 						lda		(_log_curln),y
   187 						eor		#$80
   188 						sta		(_log_curln),y
   189 						
   190 						;recompute line addr
   191 						mva		#>[_log_display/2] _log_curln+1
   192 						lda		pos_table,x
   193 						asl
   194 						rol		_log_curln+1
   195 						asl
   196 						rol		_log_curln+1
   197 						sta		_log_curln
   198 						
   199 						;update X and redraw cursor
   200 						pla
   201 						tay
   202 						sty		_log_curx
   203 						lda		(_log_curln),y
   204 						eor		#$80
   205 						sta		(_log_curln),y
   206 						rts
   207 						
   208 				pos_table:
   209 						:22 dta [#*40+(<_log_display)]/4
   210 				.endp
