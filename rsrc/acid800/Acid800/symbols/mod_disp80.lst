   484 91F2			.proc	clearScreen
   485 91F2 A9 60				lda		#$60
   486 91F4 85 E3				sta		rowptr1+1
   487 91F6 A9 A0				lda		#$a0
   488 91F8 85 E5				sta		rowptr2+1
   489 91FA A9 00				lda		#0
   490 91FC 85 E2				sta		rowptr1
   491 91FE 85 E4				sta		rowptr2
   492 9200 A2 20				ldx		#$20
   493 9202			xloop:
   494 9202 A0 00				ldy		#0
   495 9204			yloop:
   496 9204 91 E2				sta		(rowptr1),y
   497 9206 91 E4				sta		(rowptr2),y
   498 9208 C8					iny
   499 9209 D0 F9				bne		yloop
