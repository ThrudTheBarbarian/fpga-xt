   749 0B84			.proc DOSPutByte
   750 0B84 A0 85				ldy		#CIOStatNotOpen
   751 0B86 BD 07 09				lda		dos_fcb_table[0].secbuf,x
   752 0B89 30 02				bmi		not_open
   753 0B8B A0 87				ldy		#CIOStatReadOnly
   754 0B8D			not_open:
   755 0B8D 60					rts
   756 				.endp
