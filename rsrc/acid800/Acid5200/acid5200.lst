  1531
  1532 444A			doinit:
  1533 444A 6C E2 02			jmp		(initad)
  1534 					
  1535 444D			getbyte:
  1536 					;check if we have a run in progress
  1537 444D A5 CA			lda		d2
  1538 444F D0 4E			bne		getrunbyte
  1539
  1540 					;check if we need to reload flag bits
  1541 4451 06 C9			asl		d1
  1542 4453 D0 1A			bne		havebits
  1543 					
  1544 					;check if we need to reload superflag bits
  1545 4455 06 CD			asl		d5
  1546 4457 D0 09			bne		havesuperbits
  1547 					
  1548 					;load next superflag byte
  1549 4459 20 B8 44			jsr		getrawbyte
  1550 445C 85 CC			sta		d4
  1551 445E A9 7F			lda		#$7f
  1552 4460 85 CD			sta		d5
  1553 					
  1554 4462			havesuperbits:
  1555 					;pull next superflag and check if it's all literals (0)
  1556 4462 06 CC			asl		d4
  1557 4464 90 05			bcc		all_literals
  1558 					
  1559 					;nope... read next byte as flags byte
  1560 4466 20 B8 44			jsr		getrawbyte
  1561 4469 85 C8			sta		d0
  1562
  1563 446B			all_literals:
  1564 446B A9 7F			lda		#$7f
  1565 446D 85 C9			sta		d1
  1566 446F			havebits:
  1567 446F 06 C8			asl		d0
  1568 4471 B0 06			bcs		isrun
