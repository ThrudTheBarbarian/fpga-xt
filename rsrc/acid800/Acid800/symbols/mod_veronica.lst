   445 				; MACROS
   446 				;
   447 				.macro _INITTEST
   448 					jsr		_imTestInit
   449 					dta		:1,0
   450 				.endm
   451
   452 				.macro _ASSERT1
   453 					lda	:1
   454 					cmp	#:2
   455 					beq	pass
   456 					
   457 					sta	d1
   458 					jsr	_testFailed
   459 					dta	:3,0
   460 				pass:
   461 				.endm
   462
   463 				.macro _ASSERT1_DUAL
   464 					lda	:1
   465 					cmp	#:2
   466 					beq	pass
   467 					cmp	#:3
   468 					beq	pass
   469 					
   470 					sta	d1
   471 					jsr	_testFailed
   472 					dta	:4,0
   473 				pass:
   474 				.endm
   475
   476 				.macro _ASSERTA
   477 					cmp	#:1
   478 					beq	pass
   479 					
   480 					sta	d1
   481 					jsr	_testFailed
   482 					dta	:2,0
   483 				pass:
   484 				.endm
   485
   486 				.macro _ASSERTX
   487 					cpx	#:1
   488 					beq	pass
   489 					
   490 					stx	d1
   491 					jsr	_testFailed
   492 					dta	:2,0
   493 				pass:
   494 				.endm
   495
   496 				.macro _ASSERTY
   497 					cpy	#:1
   498 					beq	pass
   499 					
   500 					sty	d1
   501 					jsr	_testFailed
   502 					dta	:2,0
   503 				pass:
   504 				.endm
   505
   506 				.macro _FAIL
   507 					jsr		_testFailed
   508 					dta		:1,0
   509 				.endm
   510
