  1410 3D55 F0 21				beq		postpia
  1411 3D57 A2 38				ldx		#$38
  1412 3D59 A0 3C				ldy		#$3c
  1413 3D5B 8E 03 D3				stx		pbctl
  1414 3D5E A9 FF 8D 01 D3			mva		#$ff portb
  1415 3D63 8C 03 D3				sty		pbctl
  1416 3D66 A5 83 8D 01 D3			mva		save_orb portb
  1417 3D6B 8E 03 D3				stx		pbctl
  1418 3D6E A5 82 8D 01 D3			mva		save_ddrb portb
  1419 3D73 A5 81 8D 01 D3			mva		save_crb portb
