  1407 					
  1408 					;begin relocation
  1409 43DA A9 01 8D E0 02 A9 + 	mwa		#relocloop runad
  1410
  1411 					.ifdef SEGS_IN_ROM
  1412 43E4 AE E4 02			ldx		_lastMod
  1413 43E7 BD 00 BF 85 C0		mva		segaddrlo,x a0
  1414 43EC BD 80 BF 85 C1		mva		segaddrhi,x a0+1
