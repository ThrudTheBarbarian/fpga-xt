   217 A10C 43 6F 70 79 72 69 + 		dta		c"Copyright (C) 2010-2022 Avery Lee.",$9B
   218 A12F 41 6C 6C 20 52 69 + 		dta		c"All Rights Reserved.",$9B,$9B,0
