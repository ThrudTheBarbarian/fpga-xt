  1251 				; _loadSeg()
  1252 				;
  1253 				; Module loader.
  1254 				;
  1255 				;	X = index of module to load
  1256 				;
  1257 				.ifdef SEGS_MIN_MEM
  1258 1E61			.nowarn .proc	_loadSeg
  1259 					;get starting sector
  1260 1E61 BD 00 19 8D 0A 03		mva		segaddrlo,x	daux1
  1261 1E67 BD 80 19 8D 0B 03		mva		segaddrhi,x	daux2
  1262 						
  1263 					;get ending sector
  1264 1E6D BD 01 19			lda		segaddrlo+1,x
  1265 1E70 38 ED 0A 03			sub		daux1
  1266 1E74 85 CF			sta		d7
  1267
  1268 					;setup sector load command and relocation
  1269 1E76 A9 52 8D 02 03		mva		#'R' dcomnd
  1270 1E7B A9 01 8D 01 03		mva		#1 dunit
  1271 1E80 A9 00			lda		#$00
  1272 1E82 8D 04 03			sta		dbuflo
  1273 1E85 85 C0			sta		a0
  1274 1E87 8D E1 02			sta		runad+1
  1275 1E8A A9 0B			lda		#$0b
  1276 1E8C 8D 05 03			sta		dbufhi
  1277 1E8F 85 C1			sta		a0+1
  1278 					
  1279 					;preload first two sectors
  1280 1E91 20 FE 1E			jsr		step_sector
  1281 1E94			relocloop:
  1282 					;load starting address
  1283 1E94 B1 C0 85 C2			mva		(a0),y a1
  1284 1E98 C8 D0 03 20 FE 1E		iny:sne:jsr step_sector
  1285 1E9E B1 C0 85 C3			mva		(a0),y a1+1
  1286 1EA2 C8 D0 03 20 FE 1E		iny:sne:jsr step_sector
  1287 					
  1288 					;skip $ffff words
  1289 1EA8 A5 C2			lda		a1
  1290 1EAA 25 C3			and		a1+1
  1291 1EAC C9 FF			cmp		#$ff
  1292 1EAE F0 E4			beq		relocloop
  1293 					
  1294 					;load ending address
  1295 1EB0 B1 C0 85 C4			mva		(a0),y a2
  1296 1EB4 C8 D0 03 20 FE 1E		iny:sne:jsr step_sector
  1297 1EBA B1 C0 85 C5			mva		(a0),y a2+1
  1298 1EBE C8 D0 03 20 FE 1E		iny:sne:jsr step_sector
  1299 1EC4 E6 C4 D0 02 E6 C5		inw		a2
  1300
  1301 1ECA A9 1D 8D E2 02 A9 + 	mwa		#definit initad
  1302 					
  1303 					;copy data (slow, but oh well)
  1304 1ED4 A2 00			ldx		#0
  1305 1ED6			copyloop:
  1306 1ED6 B1 C0			lda		(a0),y
  1307 1ED8 81 C2			sta		(a1,x)
  1308 1EDA C8 D0 03 20 FE 1E		iny:sne:jsr step_sector
  1309 1EE0 E6 C2 D0 02 E6 C3		inw		a1
  1310 1EE6 A5 C2			lda		a1
  1311 1EE8 C5 C4			cmp		a2
  1312 1EEA D0 EA			bne		copyloop
  1313 1EEC A5 C3			lda		a1+1
  1314 1EEE C5 C5			cmp		a2+1
  1315 1EF0 D0 E4			bne		copyloop
  1316 					
  1317 					;init a segment
  1318 1EF2 20 FB 1E			jsr		doinit
  1319 					
  1320 					;check if we're done
  1321 1EF5 AD E1 02			lda		runad+1
  1322 1EF8 F0 9A			beq		relocloop
  1323 1EFA 60				rts
  1324
  1325 1EFB			doinit:
  1326 1EFB 6C E2 02			jmp		(initad)
  1327 					
  1328 1EFE			step_sector:
  1329 1EFE A5 CF			lda		d7
  1330 1F00 F0 17			beq		no_sectors_left
  1331 1F02 20 53 E4			jsr		dskinv
  1332 1F05 C6 CF			dec		d7
  1333 1F07 EE 0A 03 D0 03 EE + 	inw		daux1
  1334 1F0F AD 04 03			lda		dbuflo
  1335 1F12 49 80			eor		#$80
  1336 1F14 8D 04 03			sta		dbuflo
  1337 1F17 D0 E5			bne		step_sector
  1338 1F19			no_sectors_left:
  1339 1F19 A0 00			ldy		#0
  1340 1F1B A2 00			ldx		#0
