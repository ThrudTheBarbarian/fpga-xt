   611
   612 						;====== 16-bit hi timer reprogramming tests========================
   613 						; AUDF1/2 setting is $000D, for a period of 13 + 7 = 20 cycles. We
   614 						; are testing for the last cycle where AUDF2 can be changed to $01
   615 						; without raising the period of the next cycle to 276 cycles.
   616 						;
   617 						; The timing verified by the below is as follows:
   618 						;
   619 						; - Writes to AUDF2 up to 18 cycles after write to STIMER do affect
   620 						;   the second loop and cause IRQST bit 2 to assert 256 cycles
   621 						;   later starting at 300 cycles past STIMER (4 + 20 + 276).
   622 						;
   623 						; - Writes to AUDF2 at 19 cycles after write to STIMER do not
   624 						;   affect the first two loops and cause IRQST bit 2 to assert
   625 						;   starting at 44 cycles past STIMER (4 + 20 + 20). This is 3 cycles
   626 						;   after IRQST bit 1.
   627 						;
   628 						; AUDF1=0	 9c/10c		*extrapolated
   629 						; AUDF1=13	22c/23c
   630
   631 28AA A9 50 8D 08 D2			mva		#$50 audctl
   632 28AF A9 0D 8D 00 D2			mva		#$0d audf1
   633 28B4 A0 01				ldy		#$01
   634
   635 						;------------------------------------------------------------------
   636 						;lower bound 1.79MHz 16-bit hi IRQST timing, latest AUDF2 write to take effect
   637 28B6 A9 00 8D 02 D2			mva		#$00 audf2
   638 28BB 8D 0A D4				sta		wsync
   639 28BE 8D 0A D4				sta		wsync
   640 28C1					_DELAY_CYCLES_X 60
