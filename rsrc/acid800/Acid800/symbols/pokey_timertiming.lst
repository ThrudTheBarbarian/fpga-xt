     2 2C58 F0 32			beq	pass
     4 2C5A 85 C9			sta	d1
     5 2C5C 20 E3 1D			jsr	_testFailed
     6 2C5F 55 6E 61 62 6C 65 + 	dta	c"Unable to reset serial output for 2tn tests.",0
     7 2C8C			pass:
