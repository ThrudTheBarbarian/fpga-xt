   323 				;=========================================================================
   324 21A0			.proc	dli
   325 21A0 48					pha
   326 								
   327 						;check if we've should run
   328 21A1 A5 97				lda		profrdy
   329 21A3 F0 2C				beq		xit
   330 						
   331 						;immediately block to prevent recursion
   332 21A5 E6 97				inc		profrdy
   333 						
   334 						;save X/Y
   335 21A7 84 9A				sty		ysave
   336 21A9 86 99				stx		xsave
   337
   338 						;modify display list mode byte
   339 21AB A0 00				ldy		#0
   340 21AD B1 94				lda		(testptr),y
   341 21AF 4A					lsr
   342 21B0 08					php
   343 21B1 4A					lsr
   344 21B2 09 40				ora		#$40
   345 21B4 8D 02 28				sta		dlmode
   346 						
   347 21B7 A9 21				lda		#$21
   348 21B9 69 00				adc		#0
   349 21BB 8D 00 D4				sta		dmactl
   350 21BE 28					plp
   351 						
   352 						;check if we need to skip an extra line
   353 21BF 90 03				bcc		noxline
   354 21C1 8D 0A D4				sta		wsync			;end scanline 16
   355 21C4			noxline:
   356
   357 21C4 8D 0A D4				sta		wsync			;end scanline 16/17
   358
   359 						;dispatch to routine
   360 21C7 20 D3 21				jsr		doProfile
   361 						
   362 						;decode the starting offset
   363 21CA 20 68 22				jsr		unrand
   364
   365 21CD A6 99				ldx		xsave
   366 21CF A4 9A				ldy		ysave
   367
   368 21D1			xit:
   369 21D1 68					pla
   370 21D2 40					rti
   371
   372 21D3			doProfile:
   373 21D3 A6 96				ldx		delyidx
   374 21D5 BD DF 21				lda		routines+1,x
   375 21D8 48					pha
   376 21D9 BD DE 21				lda		routines,x
   377 21DC 48					pha
   378 21DD 60					rts
   379 						
   380 21DE			routines:
   381 21DE 2E 23				dta		a(profileDelay0-1)
   382 21E0 46 23				dta		a(profileDelay1-1)
   383 21E2 5E 23				dta		a(profileDelay2-1)
   384 21E4 77 23				dta		a(profileDelay3-1)
   385 21E6 91 23				dta		a(profileDelay4-1)
   386 21E8 AC 23				dta		a(profileDelay5-1)
   387 21EA C7 23				dta		a(profileDelay6-1)
   388 				.endp
