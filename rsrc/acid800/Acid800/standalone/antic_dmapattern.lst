   128 2048 D0 07				bne		nowaitvbl
   129 						
   130 204A A9 08				lda		#8
   131 204C CD 0B D4 D0 FB			cmp:rne	vcount
   132 						
   133 2051			nowaitvbl:
   134 						;turn off playfield and display list DMA
   135 2051 A9 00 8D 00 D4			mva		#0 dmactl
   136 						
   137 						;wait for end of scanline
