  1436 3D8D			.proc FailTest816
  1437 						;okay, let's get this thing back to home base -- first, go to 8-bit
  1438 						;registers.
  1439 3D8D E2 30				sep		#$30
  1440 						
  1441 						;restore direct page
  1442 3D8F A9 00				lda.b	#0
  1443 3D91 EB					xba
  1444 3D92 A9 00				lda.b	#0
  1445 3D94 5B					tcd
  1446 						
  1447 						;pull the return address (for the message)
  1448 3D95 FA					plx
  1449 3D96 7A					ply
  1450 						
  1451 						;restore the stack
  1452 3D97 A9 01				lda.b		#1
  1453 3D99 EB					xba
  1454 3D9A AF 80 00 00				lda.l	emusp
  1455 3D9E 1B					tcs
  1456 						
  1457 						;put the return address back
  1458 3D9F 5A					phy
  1459 3DA0 DA					phx
  1460 						
  1461 						;restore data bank
  1462 3DA1 A9 00				lda.b	#0
  1463 3DA3 48					pha
  1464 3DA4 AB					plb
  1465 						
  1466 						;jump to emulation mode
  1467 3DA5 38					sec
  1468 3DA6 FB					xce
  1469
  1470 						;check if we're on Veronica
  1471 3DA7 2C 2E 1A				bit		_veronica
  1472 3DAA 10 07				bpl		maincpu_ret
  1473
  1474 						;load message address - 1 to A:X
  1475 3DAC FA					plx
  1476 3DAD 68					pla
  1477 3DAE A0 80				ldy		#$80
  1478 3DB0 4C E0 FF				jmp		$ffe0
  1479
  1480 3DB3			maincpu_ret:
  1481 						;restore the RAM OS, if there is one
  1482 3DB3 20 44 3D				jsr		RestoreOS
  1483 						
  1484 						;fail
  1485 3DB6 4C E3 1D				jmp		_testFailed
  1486 				.endp
