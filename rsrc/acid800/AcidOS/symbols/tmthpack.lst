   644 				;==========================================================================
   645 				; _load_seg
   646 				;
   647 				; Module loader.
   648 				;
   649 				;	X:A = address of filename to load
   650 				;
   651 				.nowarn .proc	_load_seg
   652 						;open IOCB #1
   653 						sta		icbal+$10
   654 						stx		icbah+$10
   655 						lda		#$04
   656 						sta		icax1+$10
   657 						lda		#CIOCmdOpen
   658 						jsr		do_io
   659 						bmi		other_fail
   660
   661 						;begin relocation
   662 						mwa		#definit runad
   663
   664 				relocloop:
   665 						;load starting address
   666 						mwa		#a0 icbal+$10
   667 						jsr		load_two
   668 						bmi		startaddr_fail
   669 						
   670 						;check for $FFFF signature
   671 						lda		a0
   672 						and		a0+1
   673 						cmp		#$ff
   674 						beq		relocloop
   675 						
   676 						;load ending address
   677 						mwa		#a1 icbal+$10
   678 						jsr		load_two
   679 						bmi		other_fail
   680 						
   681 						;compute length and load
   682 						sbw		a1 a0 icbll+$10
   683 						inw		icbll+$10
   684 						mwa		a0 icbal+$10
   685 						jsr		load_bytes
   686 						bmi		other_fail
   687 						
   688 						;init a segment
   689 						mwa		#definit initad
   690 						jsr		doinit
   691 						jmp		relocloop
   692
   693 				startaddr_fail:
   694 						cpy		#CIOStatEndOfFile
   695 						bne		other_fail
   696 						ldy		#1
   697 				other_fail:
   698 						;save status
   699 						sty		a0
   700 						
   701 						;close IOCB #1
   702 						lda		#CIOCmdClose
   703 						jsr		do_io
   704 						
   705 						;restore status and exit
   706 						ldy		a0
   707 						rts
   708 						
   709 				load_two:
   710 						mwa		#2 icbll+$10
   711 				load_bytes:
   712 						lda		#CIOCmdGetChars
   713 				do_io:
   714 						sta		iccmd+$10
   715 						ldx		#$10
   716 						jmp		ciov
   717
   718 				doinit:
   719 						jmp		(initad)
   720 					
   721 				definit:
   722 						rts
   723
   724 				.endp
   725
   726 				;==========================================================================
   727 				; _run_seg
   728 				;
   729 				; Module relocator and executor.
   730 				;
   731 				; The last segment loaded by _load_seg is relocated and executed.
   732 				;
   733 				.nowarn .proc _run_seg
   734 						jmp		(runad)
   735 				.endp
   736
   737 				;=======================================================================
   738 				.nowarn .proc _Exec
   739 						jsr		_load_seg
   740 						jmp		_run_seg
   741 				.endp
   742
   743 				;=======================================================================
   744 				.nowarn .proc _ExecMenu
   745 						ldx		#>menu_exe
   746 						lda		#<menu_exe
   747 						jmp		_Exec
   748
   749 				menu_exe:
   750 						dta		'D:MENU.EXE',$9B		
   751 				.endp
