    45 				;==========================================================================
    46 4519			.proc _kybd_handler
    47 					;The bass-ackward design of the 5200 keyboard causes an IRQ to occur
    48 					;every 32 scanlines while a key is held down. We require keys to be
    49 					;released for at least one full frame before we recognize another
    50 					;one.
    51 4519 AE 8F 02			ldx		keydel
    52 451C D0 03 8D 8E 02		sne:sta	ch
    53 4521 A9 02			lda		#2
    54 4523 8D 8F 02			sta		keydel
    55 4526 68				pla
    56 4527 A8				tay
    57 4528 68				pla
    58 4529 AA				tax
    59 452A 68				pla
    60 452B 40				rti
    61 				.endp
    62
    63 				;==========================================================================
    64 452C			.proc _vbd_handler
    65 452C AD 8F 02			lda		keydel
    66 452F F0 03 CE 8F 02		seq:dec	keydel
    67 					
    68 4534 68 A8 68 AA 68		plr
    69 4539 40				rti
    70 				.endp
    71
