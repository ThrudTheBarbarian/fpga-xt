   773
   774 						;====== two-tone test prep ========================================
   775 						;
   776 						; We need to use timer 1 for 8-bit two tone tests to have access
   777 						; to the 1.79MHz clock, but there is no direct way to reset the
   778 						; serial output state, which is not affected by init mode or
   779 						; serial reset (they can halt the shifter, but not clear it).
   780 						; Therefore, we need to push a byte through to ensure that the
   781 						; shifter has completed the stop bit, and therefore output a 1.
   782 						; After that, we can use force break to get a 0 as needed.
   783
   784 2C28 A0 00				ldy		#0
   785 2C2A 8C 0F D2				sty		skctl			;reset serial port as much as we can
   786 2C2D 8C 04 D2				sty		audf3
   787 2C30 8C 06 D2				sty		audf4
   788 2C33 8C 0E D2				sty		irqen
   789 2C36 A9 23 8D 0F D2			mva		#$23 skctl		;ch4 transmit synchronous
   790 2C3B A9 28 8D 08 D2			mva		#$28 audctl		;ch3+4 linked 1.79MHz
   791 2C40 A9 18 8D 0E D2			mva		#$18 irqen		;serial output ready + complete
   792 2C45 8C 0D D2				sty		serout			;write dummy byte (~140-153 cycles)
   793 2C48 8D 0A D4				sta		wsync
   794 2C4B 8D 0A D4				sta		wsync
   795 2C4E 8D 0A D4				sta		wsync
   796 2C51 AD 0E D2				lda		irqst
   797 2C54 29 18				and		#$18
   798 2C56					_ASSERTA $00, c"Unable to reset serial output for 2tn tests.",0
Macro: _ASSERTA [Source: library.s]
     1 2C56 C9 00			cmp	#$00
     2 2C58 F0 32			beq	pass
     4 2C5A 85 C9			sta	d1
     5 2C5C 20 0D 1E			jsr	_testFailed
     6 2C5F 55 6E 61 62 6C 65 + 	dta	c"Unable to reset serial output for 2tn tests.",0
     7 2C8C			pass:
