   452 				.macro _ASSERT1
   453 					lda	:1
   454 					cmp	#:2
   455 					beq	pass
   456 					
   457 					sta	d1
   458 					jsr	_testFailed
   459 					dta	:3,0
   460 				pass:
   461 				.endm
   462
   463 				.macro _ASSERT1_DUAL
   464 					lda	:1
   465 					cmp	#:2
   466 					beq	pass
   467 					cmp	#:3
   468 					beq	pass
   469 					
   470 					sta	d1
   471 					jsr	_testFailed
   472 					dta	:4,0
   473 				pass:
   474 				.endm
