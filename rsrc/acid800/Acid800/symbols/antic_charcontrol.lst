  1115 				;=========================================================================
  1116 				.nowarn .proc	_testRestore
  1117 					cld
  1118 					php
  1119 					sei
  1120 					
  1121 					;check if the screen is off; if so, make sure we kill DLIs
  1122 					lda		_scrnOff
  1123 					beq		scrnOK
  1124 					
  1125 					lda		#0
  1126 					inc		wsync
  1127 					sta		nmien
  1128 					
  1129 				scrnOK:
  1130
  1131 					mva		sskctl skctl
  1132 						
  1133 					.ifdef SYSSAP
  1134 					;kill PIA port A interrupt
  1135 					mva		#$3c pactl
  1136 					
  1137 					;force kernel ROMs back _out_
  1138 					mva		#$38 pbctl
  1139 					mva		#$ff portb
  1140 					mva		#$3c pbctl
  1141 					mva		#$82 portb
  1142 					.endif
  1143 					
  1144 					.ifdef SYS5200
  1145 					mva		#$00 prior
  1146 					mva		#$f8 chbase
  1147 					mva		#$02 chactl
  1148 					mva		#$04 consol
  1149 					.endif
  1150 					
  1151 					.ifdef SYS800
  1152 					;kill PIA port A interrupt
  1153 					mva		#$3c pactl
  1154 					
  1155 					;force kernel ROMs back in	
  1156 					mva		#$38 pbctl
  1157 					mva		#$00 portb
  1158 					mva		#$3c pbctl
  1159 					mva		#$83 portb
  1160 					
  1161 					;kill OS timer 1
  1162 					ldx		#$ff
  1163 					stx		wsync
  1164 					stx		cdtmv1
  1165 					inx
  1166 					stx		cdtmv1
  1167 					stx		cdtmv1+1
  1168 					.endif
  1169
  1170 					plp
  1171 					jsr	_interruptsOn
  1172 					jsr	_screenOn
  1173 					jsr	_resetAV
  1174 					
  1175 					;unmask interrupts
  1176 					cli
  1177 					rts
  1178 				.endp
