    99 						; $0065
   100 				toadr	= $0066			;temporary storage (display code)
   101 						; $0067
   102 				frmadr	= $0068			;temporary storage (display code)
   103 						; $0069
   104 				ramtop	= $006a			;ram size
   105 				bufcnt	= $006b
   106 				bufstr	= $006c			;row/column of start of logical line
   107 				bitmsk	= $006e			;Screen Editor
   108 				shfamt	= $006f			;Screen Editor
   109 				rowac	= $0070			;Screen Editor: line drawing
   110 						; $0071			;
   111 				colac	= $0072			;Screen Editor: line drawing
   112 						; $0073			;
   113 				endpt	= $0074			;Screen Editor: line drawing
   114 						; $0075			;
   115 				deltar	= $0076			;Screen Editor: delta row (line drawing)
