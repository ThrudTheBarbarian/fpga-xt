    46 				;==========================================================================
    47 				; 16K boot support (A8 only)
    48 						.ifdef SYS800
    49 						org		$2000
    50 				.proc _main
    51 						;initialize library
    52 						jsr		_crt0init
    53
    54 						;check if we have 16K of memory
    55 						lda		memtop+1
    56 						cmp		#$40
    57 						scc:jmp	main
    58 						
    59 						;OS-B has a dumb bug where its screen editor clears up to one page
    60 						;more than it should, so we install our own mini display module
    61 						;that doesn't have such bugs.
    62 						ldx		#MOD_DISPMIN
    63 						jsr		_loadSeg
    64 						jsr		_runSeg
    65
    66 						jmp		main
    67 				.endp
    68 						.endif
    69
    70 				;==========================================================================
    71 						.ifndef SYS5200
    72 						org		$1000
    73 						.endif
