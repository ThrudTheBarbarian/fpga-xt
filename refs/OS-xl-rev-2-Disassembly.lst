      = 000A      BEEPFN  EQU     10      ;NTSC 0.16 second beep separation

      = 03C0      WLEADP  EQU     960     ;PAL 19.2 second WRITE file leader
      = 01E0      RLEADP  EQU     480     ;PAL 9.6 second READ file leader
