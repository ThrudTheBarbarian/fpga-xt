   398 				;=======================================================================
   399 				.nowarn .proc _log_printf
   400 						sta		a0
   401 						sty		a0+1
   402 						ldy		#0
   403 						sty		d0
   404 						
   405 				charloop:
   406 						lda		(a0),y
   407 						beq		done
   408 						inw		a0
   409 						cmp		#'%'
   410 						beq		special
   411 				escaped:
   412 						jsr		_log_putchar
   413 				nextchar:
   414 						ldy		#0
   415 						beq		charloop
   416
   417 				done:
   418 						rts
   419
   420 				special:
   421 						inc		d0
   422 						ldx		d0
   423 						lda		(a0),y
   424 						inw		a0
   425 						cmp		 #'d'
   426 						bne		notdec
   427 						tya
   428 						sty		a1
   429 						ldy		#6
   430 						sei
   431 						sed
   432 				decloop1:
   433 						rol		d0,x
   434 						adc		a1
   435 						sta		a1
   436 						dey
   437 						bne		decloop1
   438 						sty		a1+1
   439 						ldy		#2
   440 				decloop2:
   441 						rol		d0,x
   442 						adc		a1
   443 						sta		a1
   444 						rol		a1+1
   445 						dey
   446 						bne		decloop2
   447 						cld
   448 						cli
   449 						lda		a1+1
   450 						beq		decdigit2
   451 						tax
   452 						lda		_hexdig,x
   453 						jsr		putbyte
   454 						lda		a1
   455 						jmp		puthex_nextchar
   456 						
   457 				decdigit2:
   458 						lda		a1
   459 						cmp		#$10
   460 						bcc		decdigit1
   461 						jmp		puthex_nextchar
   462 						
   463 				decdigit1:
   464 						tax
   465 						lda		_hexdig,x
   466 						jmp		escaped
   467
   468 				notdec:
   469 						cmp		#'x'
   470 						bne		nothex
   471 						lda		d0,x
   472 						jmp		puthex_nextchar
   473
   474 				nothex:
   475 						cmp		#'X'
   476 						bne		nothexword
   477 						inc		d0
   478 						lda		d1,x
   479 						jsr		puthex
   480 						ldx		d0
   481 						lda		d0-1,x
   482 						jmp		puthex_nextchar
   483
   484 				nothexword:
   485 						cmp		 #'D'
   486 						bne		notdecword
   487
   488 						ldy		#8
   489 						lda		#0
   490 						sta		a1
   491 						sta		a1+1
   492 						sta		a2
   493 						sei
   494 						sed
   495 				decword1:
   496 						rol		d1,x
   497 						lda		a1
   498 						adc		a1
   499 						sta		a1
   500 						lda		a1+1
   501 						adc		a1+1
   502 						sta		a1+1
   503 						dey
   504 						bne		decword1
   505 					
   506 						ldy		#8
   507 				decword2:
   508 						rol		d0,x
   509 						lda		a1
   510 						adc		a1
   511 						sta		a1
   512 						lda		a1+1
   513 						adc		a1+1
   514 						sta		a1+1
   515 						lda		a2
   516 						adc		a2
   517 						sta		a2
   518 						dey
   519 						bne		decword2
   520 						cld
   521 						cli
   522 					
   523 						tax
   524 						beq		decword3
   525 						jsr		puthexcond
   526 						
   527 						lda		a1+1
   528 						jsr		puthex
   529 						lda		a1
   530 						jmp		puthex_nextchar
   531
   532 				decword3:
   533 						lda		a1+1
   534 						beq		decword4
   535 						jsr		puthexcond
   536 						lda		a1
   537 				puthex_nextchar:
   538 						jsr		puthex
   539 						jmp		nextchar
   540 					
   541 				decword4:
   542 						lda		a1
   543 						jsr		puthexcond
   544 						jmp		nextchar
   545
   546 				notdecword:
   547 						cmp		 #'c'
   548 						bne		notchar
   549 						lda		d0,x
   550 						jsr		putbyte
   551 				strdone:
   552 						jmp		nextchar
   553 					
   554 				notchar:
   555 						cmp		 #'s'
   556 						bne		notstr
   557 					
   558 						inc		d0
   559 						lda		d0,x
   560 						sta		a1
   561 						lda		d0+1,x
   562 						sta		a1+1
   563
   564 				strloop:
   565 						ldy		#0
   566 						lda		(a1),y
   567 						beq		strdone
   568 						jsr		_log_putchar
   569 						inw		a1
   570 						jmp		strloop
   571 					
   572 				notstr:
   573 						cmp		#'f'
   574 						bne		notfloat
   575
   576 						inc		d0
   577 						lda		d0+1,x
   578 						tay
   579 						lda		d0,x
   580 						tax
   581 						jsr		fld0r
   582 						jsr		fasc
   583 						ldx		inbuff
   584 				nextfloatchar:
   585 						lda		+(lbuff&$ff00),x
   586 						inx
   587 						pha
   588 						and		#$7f
   589 						jsr		_log_putchar
   590 						pla
   591 						bpl		nextfloatchar
   592 						jmp		nextchar
   593
   594 				notfloat:
   595 						dec		d0
   596 						jmp		escaped
   597 					
   598 				puthexcond:
   599 						cmp		#$10
   600 						bcs		puthex
   601 						tax
   602 						lda		_hexdig,x
   603 						jmp		putbyte
   604
   605 				puthex:	
   606 						pha
   607 						lsr
   608 						lsr
   609 						lsr
   610 						lsr
   611 						tax
   612 						lda		_hexdig,x
   613 						jsr		putbyte
   614 						pla
   615 						and		#$0f
   616 						tax
   617 						lda		_hexdig,x
   618 				putbyte:
   619 						tax
   620 						jsr		_log_putchar
   621 						txa
   622 						rts
   623 				.endp
   624
   625 				;==========================================================================
   626 				.nowarn .proc _waitKey
   627 						lda		#$ff
   628 						sta		ch
   629 						sta		ch1
   630 						cmp:req	ch
   631 						rts
   632 				.endp
   633
   634 				;==========================================================================
   635 				.nowarn .proc _waitKeyPrompt
   636 						jsr		_log_imprint
   637 						dta		c"Press a key...",0
   638 						jsr		_waitKey
   639 						jsr		_log_imprint
   640 						dta		$9c,0
   641 						rts
   642 				.endp
   643
   644 				;==========================================================================
   645 				; _load_seg
   646 				;
   647 				; Module loader.
   648 				;
   649 				;	X:A = address of filename to load
   650 				;
   651 				.nowarn .proc	_load_seg
   652 						;open IOCB #1
   653 						sta		icbal+$10
   654 						stx		icbah+$10
   655 						lda		#$04
   656 						sta		icax1+$10
   657 						lda		#CIOCmdOpen
   658 						jsr		do_io
   659 						bmi		other_fail
   660
   661 						;begin relocation
   662 						mwa		#definit runad
   663
   664 				relocloop:
   665 						;load starting address
   666 						mwa		#a0 icbal+$10
   667 						jsr		load_two
   668 						bmi		startaddr_fail
   669 						
   670 						;check for $FFFF signature
   671 						lda		a0
   672 						and		a0+1
   673 						cmp		#$ff
   674 						beq		relocloop
   675 						
   676 						;load ending address
   677 						mwa		#a1 icbal+$10
   678 						jsr		load_two
   679 						bmi		other_fail
   680 						
   681 						;compute length and load
   682 						sbw		a1 a0 icbll+$10
   683 						inw		icbll+$10
   684 						mwa		a0 icbal+$10
   685 						jsr		load_bytes
   686 						bmi		other_fail
   687 						
   688 						;init a segment
   689 						mwa		#definit initad
   690 						jsr		doinit
   691 						jmp		relocloop
   692
   693 				startaddr_fail:
   694 						cpy		#CIOStatEndOfFile
   695 						bne		other_fail
   696 						ldy		#1
   697 				other_fail:
   698 						;save status
   699 						sty		a0
   700 						
   701 						;close IOCB #1
   702 						lda		#CIOCmdClose
   703 						jsr		do_io
   704 						
   705 						;restore status and exit
   706 						ldy		a0
   707 						rts
   708 						
   709 				load_two:
   710 						mwa		#2 icbll+$10
   711 				load_bytes:
   712 						lda		#CIOCmdGetChars
   713 				do_io:
   714 						sta		iccmd+$10
   715 						ldx		#$10
   716 						jmp		ciov
   717
   718 				doinit:
   719 						jmp		(initad)
   720 					
   721 				definit:
   722 						rts
   723
   724 				.endp
   725
   726 				;==========================================================================
   727 				; _run_seg
   728 				;
   729 				; Module relocator and executor.
   730 				;
   731 				; The last segment loaded by _load_seg is relocated and executed.
   732 				;
   733 				.nowarn .proc _run_seg
   734 						jmp		(runad)
   735 				.endp
   736
   737 				;=======================================================================
   738 				.nowarn .proc _Exec
   739 						jsr		_load_seg
   740 						jmp		_run_seg
   741 				.endp
   742
   743 				;=======================================================================
   744 				.nowarn .proc _ExecMenu
   745 						ldx		#>menu_exe
   746 						lda		#<menu_exe
   747 						jmp		_Exec
   748
   749 				menu_exe:
   750 						dta		'D:MENU.EXE',$9B		
   751 				.endp
   752
   753 				;=======================================================================
   754 				.nowarn .proc _RunTests
   755 				test_loop:
   756 						;read next test line
   757 						mva		#$80 icbll+$20
   758 						mva		#$00 icblh+$20
   759 						ldx		#$20
   760 						jsr		ciov
   761 						bpl		testOK
   762 						jmp		_ExecMenu
   763 				testOK:
   764 						;replace EOL with 0
   765 						ldx		#$ff
   766 						lda		#$9b
   767 				eol_loop:
   768 						inx
   769 						cmp		$0480,x
   770 						bne		eol_loop
   771 						lda		#0
   772 						sta		$0480,x
   773
   774 						mwa		#$0482 d1
   775 						jsr		_log_imprintf
   776 						dta		'--- Test %s ---',$9B,'Loading...',0
   777 								
   778 						;store return stack ptr
   779 						tsx
   780 						inx
   781 						inx
   782 						sta		_test_sp
   783 						
   784 						;load segment
   785 						mva		#'D' $0480
   786 						mva		#':' $0481
   787 						ldx		#$04
   788 						lda		#$80
   789 						jsr		_load_seg
   790 						bmi		fail
   791 						
   792 						;clear loading message
   793 						jsr		_log_imprint
   794 						dta		$9c,0
   795 						
   796 						;run segment
   797 						jsr		_run_seg
   798 						jmp		test_loop
   799 						
   800 				fail:
   801 						sty		d1
   802 						jsr		_log_imprintf
   803 						dta		'FAILED to load: %x',$9b,0
   804 						jsr		_waitKeyPrompt
   805 						jmp		test_loop
   806 				.endp
   807
   808 				;=======================================================================
   809 						.if *>$2c00
   810 						.error	'Library too long: ',*,' > $2C00'
   811 						.endif
