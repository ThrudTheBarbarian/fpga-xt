  1325 3CEC			.proc JmpAbsLongTest
  1326 3CEC B2 3C 01				dta		a(SetCarryTest),$01		;patched to bank $00 in bank $01
  1327 3CEF			dispatch:
  1328 3CEF DC EC 3C				jmp		[JmpAbsLongTest]		;should read from bank $00
  1329 				.endp
