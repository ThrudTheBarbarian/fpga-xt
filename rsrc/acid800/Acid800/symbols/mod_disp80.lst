    38
    39 00EC					org		$2000
    40
    41 2000			.proc main
    42 						;check if we have a cartridge
    43 2000-2109> AD 00 A0			lda		$a000
    44 2003 AA					tax
    45 2004 49 FF				eor		#$ff
    46 2006 8D 00 A0				sta		$a000
    47 2009 CD 00 A0				cmp		$a000
    48 200C 8E 00 A0				stx		$a000
    49 200F F0 50				beq		mem_ok
    50 						
    51 						;check if we have an XL or newer
    52 2011 AD D8 FC				lda		$fcd8
    53 2014 C9 A2				cmp		#$a2
    54 2016 D0 03 4C A3 20			sne:jmp	damn_cart
    55
    56 						;check if BASIC is enabled
    57 201B AD F8 03				lda		basicf
    58 201E F0 03 4C A3 20			seq:jmp	damn_cart
    59 						
    60 						;see if we can disable basic
    61 2023 AD 03 D3				lda		pbctl
    62 2026 AA					tax
    63 2027 29 FB				and		#$fb			;switch to DDR
    64 2029 8D 03 D3				sta		pbctl
    65 202C AD 01 D3				lda		portb			;read DDR
    66 202F 29 02				and		#$02			;test BASIC bit
    67 2031 F0 6D				beq		damn_cart_pbres	;set to input, so can't be BASIC
    68 2033 8A					txa
    69 2034 09 04				ora		#$04			;switch to IOR
    70 2036 8D 03 D3				sta		pbctl
    71 2039 AD 01 D3				lda		portb			;read IOR
    72 203C 29 02				and		#$02			;test BASIC bit
    73 203E D0 60				bne		damn_cart_pbres	;set to high, so can't be BASIC
    74 2040 AD 01 D3				lda		portb			;read IOR
    75 2043 09 02				ora		#$02			;clear BASIC bit (enable BASIC)
    76 2045 8D 01 D3				sta		portb
    77 2048 8A					txa
    78 2049 29 FB				and		#$fb			;switch to DDR
    79 204B 8D 03 D3				sta		pbctl
    80 204E AD 01 D3				lda		portb			;read DDR
    81 2051 09 02				ora		#$02			;enable BASIC bit for output
    82 2053 8D 01 D3				sta		portb
    83 2056 8E 03 D3				stx		pbctl			;restore control mode
    84 						
    85 2059 A9 FF 8D F8 03			mva		#$ff basicf		;mark basic as not enabled in OS
    86 205E 4C 00 20				jmp		main			;restart
