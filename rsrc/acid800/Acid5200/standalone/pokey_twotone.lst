    42 A63E			copyloop1:
    43 A63E BD AF A7 9D 80 03			mva		_disp_rowaddrinit,x _disp_rowaddrlo,x
    44 A644 CA					dex
    45 A645 10 F7				bpl		copyloop1
    46
    47 						;clear screen memory
    48 A647 20 98 A7				jsr		_disp_clearScreen
    49 						
    50 						;set up new display list
    51 A64A 20 5C A7				jsr		_disp_rewriteDisplayList
    52 						
    53 						;setup colors
    54 A64D A9 CA 85 0D				mva		#$ca color1
    55 A651 A9 94 85 0E				mva		#$94 color2
    56 A655 A9 F8 8D 09 D4			mva		#$f8 chbase
    57 A65A A9 02 8D 01 D4			mva		#$02 chactl
    58 A65F A9 22 85 07				mva		#$22 sdmctl
    59 						
    60 						;swap in new display list and vector handlers
    61 A663 78					sei
    62 A664 A9 00 85 05 A9 03 + 		mwa		#_disp_dlist sdlstl
    63 A66C 58					cli
    64 						
    65 						;turn on NMIs
    66 A66D A9 40 8D 0E D4			mva		#$40 nmien
    67 						
    68 						;wait for vertical blank
    69 A672 20 ED A0				jsr		_waitVBL
    70 						
    71 						;init params
    72 A675 A9 00 85 20				mva		#0 _disp_row
    73 A679 A9 02 85 21				mva		#2 _disp_col
    74 A67D 20 31 A7				jsr		_disp_recompRowAddr
    75 						
    76 						;replace putchar vector
