   623 				;==========================================================================
   624 0AD0			.proc DOSGetByte
   625 						;check if the FCB is open
   626 0AD0 A0 85				ldy		#CIOStatNotOpen
   627 0AD2 BD 07 09				lda		dos_fcb_table[0].secbuf,x
   628 0AD5 10 01				bpl		is_open
   629 0AD7 60					rts
   630 0AD8			is_open:
   631 						;stash IOCB#
   632 0AD8 8E BA 09				stx		dos_iocb
   633 						
   634 						;set sector pointer
   635 0ADB BD 07 09				lda		dos_fcb_table[0].secbuf,x
   636 0ADE AA					tax
   637 0ADF 20 2E 0C				jsr		DOSSetSectorPointer
   638 						
   639 						;get byte offset
   640 0AE2 AE BA 09				ldx		dos_iocb
   641 0AE5 BD 08 09				lda		dos_fcb_table[0].offset,x
   642 						
   643 						;check if we're at the end of the data area
   644 0AE8 A0 7F				ldy		#127
   645 0AEA D1 47				cmp		(zsba),y
   646 0AEC D0 34				bne		still_bytes
   647 						
   648 						;yes -- read next sector
   649 0AEE A8					tay
   650 0AEF B1 47				lda		(zsba),y
   651 0AF1 29 03				and		#3
   652 0AF3 8D BE 09				sta		dos_sechi
   653 0AF6 C8					iny
   654 0AF7 B1 47				lda		(zsba),y
   655 0AF9 8D BD 09				sta		dos_seclo
   656 0AFC D0 08				bne		nextsec_valid
   657 0AFE AC BE 09				ldy		dos_sechi
   658 0B01 D0 03				bne		nextsec_valid
   659 						
   660 						;huh... we're at EOF.
   661 0B03 A0 88				ldy		#CIOStatEndOfFile
   662 0B05 60					rts
   663 						
   664 0B06			nextsec_valid:
   665 0B06 BD 07 09				lda		dos_fcb_table[0].secbuf,x
   666 0B09 AA					tax
   667 0B0A 20 E9 0B				jsr		DOSReadSectorByVar
   668 						
   669 						;stash new sector number
   670 0B0D AE BA 09				ldx		dos_iocb
   671 0B10 AD BD 09 8D 09 09 + 		mwa		dos_seclo dos_fcb_table[0].sector
   672 						
   673 						;reset offset
   674 0B1C A9 00				lda		#0
   675 0B1E 8D 08 09				sta		dos_fcb_table[0].offset
   676 0B21 A8					tay
   677 						
   678 0B22			still_bytes:
   679 						;check if we can burst (retaddr >= $c000, cmd=get byte)
   680 0B22 BA					tsx
   681 0B23 BC 02 01				ldy		$0102,x
   682 0B26 C0 C0				cpy		#$c0
   683 0B28 90 34				bcc		no_burst
   684 0B2A A4 22				ldy		iccomz
   685 0B2C C0 07				cpy		#CIOCmdGetChars
   686 0B2E D0 2E				bne		no_burst
   687 						
   688 0B30 48					pha
   689 0B31 A0 7F				ldy		#127
   690 0B33 B1 47				lda		(zsba),y
   691 0B35 85 43				sta		zbufp
   692 0B37 C6 43				dec		zbufp
   693 0B39 68					pla
   694 0B3A A8					tay
   695 0B3B A2 00				ldx		#0
   696 0B3D F0 1A				beq		burst_loop_start
   697
   698 0B3F			burst_loop:
   699 0B3F A5 28				lda		icbllz
   700 0B41 4A					lsr
   701 0B42 05 29				ora		icblhz
   702 0B44 F0 19				beq		burst_exit
   703 						
   704 0B46 B1 47				lda		(zsba),y
   705 0B48 81 24				sta		(icbalz,x)
   706 0B4A E6 24 D0 02 E6 25			inw		icbalz
   707 0B50 A5 28 D0 02 C6 29 + 		dew		icbllz
   708 0B58 C8					iny
   709 0B59			burst_loop_start:
   710 0B59 C4 43				cpy		zbufp
   711 0B5B D0 E2				bne		burst_loop
   712 0B5D 98					tya
   713 						
   714 0B5E			no_burst:
   715 0B5E A8					tay
   716 0B5F			burst_exit:
   717 0B5F B1 47				lda		(zsba),y
   718 0B61 48					pha
   719 0B62 C8					iny
   720 0B63 AE BA 09				ldx		dos_iocb
   721 0B66 98					tya
   722 0B67 9D 08 09				sta		dos_fcb_table[0].offset,x
   723 0B6A 98					tya
   724 0B6B A0 7F				ldy		#127
   725 0B6D D1 47				cmp		(zsba),y
   726 0B6F D0 0F				bne		not_at_eof
   727 						
   728 0B71			at_eof:
   729 						;check if sector link is zero
   730 0B71 A0 7D				ldy		#125
   731 0B73 B1 47				lda		(zsba),y
   732 0B75 29 03				and		#3
   733 0B77 C8					iny
   734 0B78 11 47				ora		(zsba),y
   735 0B7A D0 04				bne		not_at_eof
   736 						
   737 						;return EOF imminent
   738 0B7C 68					pla
   739 0B7D A0 03				ldy		#3
   740 0B7F 60					rts
   741 						
   742 0B80			not_at_eof:
   743 0B80 68					pla
   744 0B81 A0 01				ldy		#1
   745 0B83 60					rts
   746 				.endp
