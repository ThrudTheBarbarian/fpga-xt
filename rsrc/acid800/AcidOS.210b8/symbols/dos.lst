   881 0C20 AD BD 09 9D 97 09			mva		dos_seclo dos_secbuf_seclo,x
   882 0C26 AD BE 09 9D 9F 09			mva		dos_sechi dos_secbuf_sechi,x
   883 						
   884 						;all done
