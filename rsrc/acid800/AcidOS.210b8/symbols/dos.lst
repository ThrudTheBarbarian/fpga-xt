   770 				;==========================================================================
   771 0B9B			.proc DOSSpecial
   772 0B9B 60					rts
   773 				.endp
   774
   775 				;==========================================================================
   776 				; Search for a filename.
   777 				;
   778 				; Entry:
   779 				;	dos_filename	Filename pattern to search for
   780 				;
   781 				; Exit:
   782 				;	Y		CIO status
   783 				;	A		Base index of directory entry
   784 				;	ZSBA	Directory sector
   785 				;
   786 0B9C			.proc DOSSearchFilename
   787 						;start with sector 361
   788 0B9C A9 69				lda		#<361
   789 0B9E 8D BB 09				sta		dos_dsidx
   790 						
   791 0BA1			dirsec_loop:
   792 0BA1 A2 00				ldx		#0
   793 0BA3 A0 01				ldy		#>361
   794 0BA5 AD BB 09				lda		dos_dsidx
   795 0BA8 20 E3 0B				jsr		DOSReadSector
   796 						
   797 						;check if this is the end of the directory
   798 0BAB A0 00				ldy		#0
   799 0BAD B1 47				lda		(zsba),y
   800 0BAF F0 2F				beq		terminate_search
   801 						
   802 						;check if entry is deleted
   803 0BB1 30 1A				bmi		no_match
   804 						
   805 						;check each filename for a match
   806 0BB3 A0 05				ldy		#5
   807 0BB5			dirent_loop:
   808 0BB5 A2 F5				ldx		#$f5
   809 0BB7			fntest_loop:
   810 0BB7 BD BA 08				lda		dos_filename-$f5,x
   811 0BBA C9 3F				cmp		#'?'
   812 0BBC D0 00				bne		skip_wild
