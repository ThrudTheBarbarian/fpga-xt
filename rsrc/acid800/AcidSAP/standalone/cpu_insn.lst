  1405 				;-----------------------------------------------
  1406 437A			.nowarn .proc _runSeg
  1407 					
  1408 					;begin relocation
  1409 437A A9 93 8D E0 02 A9 + 	mwa		#relocloop runad
  1410
  1411 					.ifdef SEGS_IN_ROM
  1412 4384 AE 8D 02			ldx		_lastMod
  1413 4387 BD 00 BF 85 C0		mva		segaddrlo,x a0
  1414 438C BD 80 BF 85 C1		mva		segaddrhi,x a0+1
  1415 					.else
