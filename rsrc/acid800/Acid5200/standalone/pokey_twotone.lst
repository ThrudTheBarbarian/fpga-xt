   214 A73E			.proc	_disp_putraw
   215 						;convert to internal encoding
   216 A73E 48					pha
   217 A73F 2A					rol
   218 A740 2A					rol
   219 A741 2A					rol
   220 A742 2A					rol
   221 A743 29 03				and		#3
   222 A745 AA					tax
   223 A746 68					pla
   224 A747 5D 4F A7				eor		convtab,x
   225 						
   226 						;store character
   227 A74A A4 21				ldy		_disp_col
   228 A74C 91 22				sta		(_disp_rowptr),y
   229
   230 						;all done
   231 A74E 60					rts
   232 						
   233 A74F			convtab:
   234 A74F 40					dta		$40
   235 A750 20					dta		$20
   236 A751 60					dta		$60
   237 A752 00					dta		$00
   238
   239 				.endp
