    45 				;==========================================================================
    46 A519			.proc _kybd_handler
    47 					;The bass-ackward design of the 5200 keyboard causes an IRQ to occur
    48 					;every 32 scanlines while a key is held down. We require keys to be
    49 					;released for at least one full frame before we recognize another
    50 					;one.
    51 A519 AE 8F 02			ldx		keydel
    52 A51C D0 03 8D 8E 02		sne:sta	ch
    53 A521 A9 02			lda		#2
    54 A523 8D 8F 02			sta		keydel
    55 A526 68				pla
    56 A527 A8				tay
    57 A528 68				pla
    58 A529 AA				tax
    59 A52A 68				pla
    60 A52B 40				rti
    61 				.endp
    62
    63 				;==========================================================================
    64 A52C			.proc _vbd_handler
    65 A52C AD 8F 02			lda		keydel
    66 A52F F0 03 CE 8F 02		seq:dec	keydel
    67 					
    68 A534 68 A8 68 AA 68		plr
    69 A539 40				rti
    70 				.endp
    71
