  1417 					.endif
  1418 					
  1419 					.ifndef SEGS_LZPACK
  1420 					
  1421 					;==== uncompressed version
  1422
  1423 4391 A0 00			ldy		#0
  1424 4393			relocloop:
  1425 					;load starting address
  1426 4393 B1 C0 85 C2			mva		(a0),y a1
  1427 4397 E6 C0 D0 02 E6 C1		inw		a0
  1428 439D B1 C0 85 C3			mva		(a0),y a1+1
  1429 43A1 E6 C0 D0 02 E6 C1		inw		a0
  1430 					
  1431 					;skip $ffff words
  1432 43A7 A5 C2			lda		a1
  1433 43A9 25 C3			and		a1+1
  1434 43AB C9 FF			cmp		#$ff
  1435 43AD F0 E4			beq		relocloop
  1436 					
  1437 					;load ending address
  1438 43AF B1 C0 85 C4			mva		(a0),y a2
  1439 43B3 E6 C0 D0 02 E6 C1		inw		a0
  1440 43B9 B1 C0 85 C5			mva		(a0),y a2+1
  1441 43BD E6 C0 D0 02 E6 C1		inw		a0
  1442 43C3 E6 C4 D0 02 E6 C5		inw		a2
  1443 					
  1444 					;copy data (slow, but oh well)
  1445 43C9			copyloop:
  1446 43C9 B1 C0			lda		(a0),y
  1447 43CB 91 C2			sta		(a1),y
  1448 43CD E6 C0 D0 02 E6 C1		inw		a0
  1449 43D3 E6 C2 D0 02 E6 C3		inw		a1
  1450 43D9 A5 C2			lda		a1
  1451 43DB C5 C4			cmp		a2
  1452 43DD D0 EA			bne		copyloop
  1453 43DF A5 C3			lda		a1+1
  1454 43E1 C5 C5			cmp		a2+1
  1455 43E3 D0 E4			bne		copyloop
  1456 					
  1457 					;init a segment
  1458 43E5 A9 F8 8D E2 02 A9 + 	mwa		#definit initad
  1459 43EF 20 F5 43			jsr		doinit
  1460 43F2 6C E0 02			jmp		(runad)
  1461
  1462 43F5			doinit:
  1463 43F5 6C E2 02			jmp		(initad)
  1464 					
  1465 43F8			definit:
  1466 43F8 60				rts
  1467
  1468 					.else
  1469 					
  1470 					;==== compressed version
  1471 					;
  1472 					;loader:
  1473 					;	a3		destination
  1474 					;	d6/d7	segment end address
  1475 					;
  1476 					;decompressor:
  1477 					;	a0		raw source stream
  1478 					;	a1		run source pointer
  1479 					;	a2		window pointer ($1000-1fff)
  1480 					;	d0		literal/run flag bits
  1481 					;	d1		remaining flag bits shifter
  1482 					;	d2		run length counter
  1483 					;	d3		temporary
  1484 					;	d4		superflag bits
  1485 					;	d5		superflag shifter
  1486
  1487 					lda		#0
  1488 					sta		d0
  1489 					sta		d1
  1490 					sta		d2
  1491 					sta		d5
  1492 					sta		a2
  1493 					lda		#$10
  1494 					sta		a2+1
  1495 				relocloop:
  1496 					ldy		#0
  1497 					;load starting address
  1498 					jsr		getbyte
  1499 					sta		a3
  1500 					jsr		getbyte
  1501 					sta		a3+1
  1502 					
  1503 					;skip $ffff words
  1504 					and		a3
  1505 					cmp		#$ff
  1506 					beq		relocloop
  1507 					
  1508 					;load ending address
  1509 					jsr		getbyte
  1510 					sta		d6
  1511 					jsr		getbyte
  1512 					sta		d7
  1513 					inw		d6
  1514 					
  1515 					;copy data (slow, but oh well)
  1516 				copyloop:
  1517 					jsr		getbyte
  1518 					sta		(a3),y
  1519 					inw		a3
  1520 					lda		a3
  1521 					cmp		d6
  1522 					bne		copyloop
  1523 					lda		a3+1
  1524 					cmp		d7
  1525 					bne		copyloop
  1526 					
  1527 					;init a segment
  1528 					mwa		#definit initad
  1529 					jsr		doinit
  1530 					jmp		(runad)
  1531
  1532 				doinit:
  1533 					jmp		(initad)
  1534 					
  1535 				getbyte:
  1536 					;check if we have a run in progress
  1537 					lda		d2
  1538 					bne		getrunbyte
  1539
  1540 					;check if we need to reload flag bits
  1541 					asl		d1
  1542 					bne		havebits
  1543 					
  1544 					;check if we need to reload superflag bits
  1545 					asl		d5
  1546 					bne		havesuperbits
  1547 					
  1548 					;load next superflag byte
  1549 					jsr		getrawbyte
  1550 					sta		d4
  1551 					lda		#$7f
  1552 					sta		d5
  1553 					
  1554 				havesuperbits:
  1555 					;pull next superflag and check if it's all literals (0)
  1556 					asl		d4
  1557 					bcc		all_literals
  1558 					
  1559 					;nope... read next byte as flags byte
  1560 					jsr		getrawbyte
  1561 					sta		d0
  1562
  1563 				all_literals:
  1564 					lda		#$7f
  1565 					sta		d1
  1566 				havebits:
  1567 					asl		d0
  1568 					bcs		isrun
  1569 					
  1570 					;store byte into window
  1571 					jsr		getrawbyte
  1572 					jmp		putwinbyte
  1573
  1574 				isrun:
  1575 					;load offset/run bytes
  1576 					jsr		getrawbyte
  1577 					sta		d3
  1578 					jsr		getrawbyte
  1579 					sta		d2
  1580 					
  1581 					;compute run source from current position and offset
  1582 					lda		a2
  1583 					clc
  1584 					sbc		d3
  1585 					sta		a1
  1586 					lda		a2+1
  1587 					sbc		d2
  1588 					and		#$0f
  1589 					ora		#$10
  1590 					sta		a1+1
  1591 					
  1592 					;compute length and stash run length
  1593 					lda		d2
  1594 					lsr
  1595 					lsr
  1596 					lsr
  1597 					lsr
  1598 					add		#3
  1599 					sta		d2
  1600 				getrunbyte:
  1601 					dec		d2
  1602 					ldy		#0
  1603 					lda		(a1),y
  1604 					inc		a1
  1605 					bne		putwinbyte
  1606 					inc		a1+1
  1607 					pha
  1608 					lda		a1+1
  1609 					and		#$0f
  1610 					ora		#$10
  1611 					sta		a1+1
  1612 					pla
  1613 					jmp		putwinbyte
  1614 					
  1615 				getrawbyte:
  1616 					lda		(a0),y
  1617 					inw		a0
  1618 					rts
  1619 					
  1620 				putwinbyte:
  1621 					sta		(a2),y
  1622 					inc		a2
  1623 					seq:rts
  1624 					ldy		a2+1
  1625 					iny
  1626 					cpy		#$20
  1627 					sne:ldy	#$10
  1628 					sty		a2+1
  1629 					ldy		#0
  1630 				definit:
  1631 					rts	
  1632 					
  1633 					.endif
  1634 				.endp
  1635 				.endif
