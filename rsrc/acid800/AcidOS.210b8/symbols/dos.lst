    34 						opt		o+
    35 						org		$0700
    36 						
    37 				base:
    38 0700 00					dta		0			;flags
    39 0701 03					dta		3
    40 0702 00 07				dta		a($0700)
    41 0704 09 08				dta		a(DOSInit)
    42 0706 4C 14 07				jmp		boot					;$0706 ($0714)
    43 0709 03			bcb_maxfiles	dta		3				;$0709 ($03)
    44 070A 01			bcb_drivebits	dta		1				;$070A ($03)
    45 070B 00			bcb_allocdirc	dta		0				;$070B ($00) (unused)
    46 070C 3E 0C		bcb_secbuf		dta		a(dos_sectorbuffers)	;$070C ($1A7C)
    47 070E 01			bcb_bootflag	dta		$01				;$070E ($01)
    48 070F 04 00		bcb_firstsec	dta		a(4)			;$070F ($0004) first sector of DOS.SYS
    49 0711 7D			bcb_linkoffset	dta		125				;$0711 ($7D)
    50 0712 80 08		bcb_loadaddr	dta		a($0880)		;$0712 ($07CB)
    51 						
    52 0714			boot:
    53 						;replace serial vectors
    54 0714 A2 03				ldx		#3
    55 0716 BD 6C 07 9D 0A 02 + 		mva:rpl	newvecs,x vserin,x-
    56 						
    57 						;read sectors
    58 071F AD 12 07 8D 04 03 + 		mwa		bcb_loadaddr dbuflo
    59 072B A9 52 8D 02 03			mva		#'R' dcomnd
    60
    61 0730 AD 0F 07				lda		bcb_firstsec
    62 0733 AE 10 07				ldx		bcb_firstsec+1
    63 0736			next_sector:
    64 0736 8D 0A 03				sta		daux1
    65 0739 8E 0B 03				stx		daux2
    66 073C 20 53 E4				jsr		dskinv
    67 073F 30 29				bmi		error
    68 						
    69 0741 AD 04 03				lda		dbuflo
    70 0744 85 47				sta		zsba
    71 0746 18					clc
    72 0747 6D 11 07				adc		bcb_linkoffset
    73 074A 8D 04 03				sta		dbuflo
    74 074D AD 05 03				lda		dbufhi
    75 0750 85 48				sta		zsba+1
    76 0752 69 00				adc		#0
    77 0754 8D 05 03				sta		dbufhi
    78 						
    79 0757 AC 11 07				ldy		bcb_linkoffset
    80 075A B1 47				lda		(zsba),y
    81 075C 29 03				and		#$03
    82 075E AA					tax
    83 075F C8					iny
    84 0760 B1 47				lda		(zsba),y
    85 0762 D0 D2				bne		next_sector
    86 0764 E0 00				cpx		#0
    87 0766 D0 CE				bne		next_sector
    88 0768 18					clc
    89 0769 60					rts
    90 076A			error:
    91 076A 38					sec
    92 076B 60					rts
    93 						
    94 076C			newvecs:
    95 076C 70 07				dta		a(SIOInputReadyHandler)
    96 076E BF 07				dta		a(SIOOutputReadyHandler)
    97 				//		dta		a(SIOOutputCompleteHandler)
    98
    99 				;==============================================================================
   100 				; SIO serial input routine
   101 				;
   102 				; DOS 2.0S replaces (VSERIN), so it's critical that this routine follow the
   103 				; rules compatible with DOS. The rules are as follows:
   104 				;
   105 				;	BUFRLO/BUFRHI:	Points to next byte to read. Note that this is different
   106 				;					from (VSEROR)!
   107 				;	BFENLO/BFENHI:	Points one after last byte in buffer.
   108 				;	BUFRFL:			Set when all data bytes have been read.
   109 				;	NOCKSM:			Set if no checksum byte is expected. Cleared after checked.
   110 				;	RECVDN:			Set when receive is complete, including any checksum.	
   111 				;
   112 0770			.proc SIOInputReadyHandler
   113 0770 A5 38			lda		bufrfl
   114 0772 D0 20			bne		receiveChecksum
   115
   116 					;receive data byte
   117 0774 98				tya
   118 0775 48				pha
   119 0776 AD 0D D2			lda		serin
   120 0779 A0 00			ldy		#$00
   121 077B 91 32			sta		(bufrlo),y
   122 077D 18				clc
   123 077E 65 31			adc		chksum
   124 0780 69 00			adc		#$00
   125 0782 85 31			sta		chksum
   126 					
   127 					;bump buffer pointer
   128 0784 E6 32 D0 02 E6 33		inw		bufrlo
   129 					
   130 					;check for EOB
   131 078A A5 32			lda		bufrlo
   132 078C C5 34			cmp		bfenlo
   133 078E F0 15			beq		possiblyEnd
   134 0790			xit:
   135 0790 68				pla
   136 0791 A8				tay
   137 0792 68				pla
   138 0793 40				rti
   139 					
   140 0794			receiveChecksum:
   141 					;read and compare checksum
   142 0794 AD 0D D2			lda		serin
   143 0797 C5 31			cmp		chksum
   144 0799 F0 04			beq		checksumOK
   145 					
   146 079B A9 8F 85 30			mva		#SIOErrorChecksum	status
   147 079F			checksumOK:
   148 					
   149 					;set receive done flag
   150 079F A9 FF 85 39			mva		#$ff	recvdn
   151
   152 					;exit
   153 07A3 68				pla
   154 07A4 40				rti
   155 					
   156 07A5			possiblyEnd:	
   157 07A5 A5 33			lda		bufrhi
   158 07A7 C5 35			cmp		bfenhi
   159 07A9 D0 E5			bne		xit
   160
   161 07AB A9 FF 85 38			mva		#$ff	bufrfl
   162 					
   163 					;should there be a checksum?
   164 07AF A5 3C			lda		nocksm
   165 07B1 D0 03			bne		skipChecksum
   166 07B3 4C 90 07			jmp		xit
   167
   168 07B6			skipChecksum:
   169 					;set receive done flag
   170 07B6 85 39			sta		recvdn
   171 					
   172 					;clear no checksum flag
   173 07B8 A9 00			lda		#0
   174 07BA 85 3C			sta		nocksm
   175 07BC 4C 90 07			jmp		xit
   176 				.endp
   177
   178 				;==============================================================================
   179 				; SIO serial output ready routine
   180 				;
   181 				; DOS 2.0S replaces (VSEROR), so it's critical that this routine follow the
   182 				; rules compatible with DOS. The rules are as follows:
   183 				;
   184 				;	BUFRLO/BUFRHI:	On entry, points to one LESS than the next byte to write.
   185 				;	BFENLO/BFENHI:	Points to byte immediately after buffer.
   186 				;	CHKSUM:			Holds running checksum as bytes are output.
   187 				;	CHKSNT:			$00 if checksum not yet sent, $FF if checksum sent.
   188 				;	POKMSK:			Used to enable the serial output complete IRQ after sending
   189 				;					checksum.
   190 				;
   191 07BF			.proc SIOOutputReadyHandler
   192 					;increment buffer pointer
   193 07BF E6 32			inc		bufrlo
   194 07C1 D0 02			bne		addrcc
   195 07C3 E6 33			inc		bufrhi
   196 07C5			addrcc:
   197
   198 					;compare against buffer end
   199 07C5 A5 32			lda		bufrlo
   200 07C7 C5 34			cmp		bfenlo
   201 07C9 A5 33			lda		bufrhi
   202 07CB E5 35			sbc		bfenhi			;set flags according to (dst - end)
   203 07CD B0 13			bcs		doChecksum
   204
   205 					;save Y
   206 07CF 98				tya
   207 07D0 48				pha
   208
   209 					;send out next byte
   210 07D1 A0 00			ldy		#0
   211 07D3 B1 32			lda		(bufrlo),y
   212 07D5 8D 0D D2			sta		serout
   213 					
   214 					;update checksum
   215 07D8 65 31			adc		chksum
   216 07DA 69 00			adc		#0
   217 07DC 85 31			sta		chksum
   218
   219 					;restore registers and exit
   220 07DE 68				pla
   221 07DF A8				tay
   222 07E0 68				pla
   223 07E1 40				rti
   224 					
   225 07E2			doChecksum:
   226 					;send checksum
   227 07E2 A5 31			lda		chksum
   228 07E4 8D 0D D2			sta		serout
   229 					
   230 					;set checksum sent flag
   231 07E7 A9 FF 85 3B			mva		#$ff	chksnt
   232 					
   233 					;enable output complete IRQ and disable serial output IRQ
   234 07EB A5 10			lda		pokmsk
   235 07ED 09 08			ora		#$08
   236 07EF 29 EF			and		#$ef
   237 07F1 85 10			sta		pokmsk
   238 07F3 8D 0E D2			sta		irqen
   239 					
   240 07F6 68				pla
   241 07F7 40				rti
   242 				.endp
   243
   244 				;==============================================================================
   245 07F8			.proc SIOOutputCompleteHandler
   246 					;check that we've sent the checksum
   247 07F8 A5 3B			lda		chksnt
   248 07FA F0 0B			beq		xit
   249 					
   250 					;we're done sending the checksum
   251 07FC 85 3A			sta		xmtdon
   252 					
   253 					;need to shut off this interrupt as it is not latched
   254 07FE A5 10			lda		pokmsk
   255 0800 29 F7			and		#$f7
   256 0802 85 10			sta		pokmsk
   257 0804 8D 0E D2			sta		irqen
   258
   259 0807			xit:
   260 0807 68				pla
   261 0808 40				rti
   262 				.endp
   263
   264 				;==========================================================================
   265 0809			.proc DOSInit
   266 0809 A2 00				ldx		#0
   267 080B			search_loop:
   268 080B BD 1A 03				lda		hatabs,x
   269 080E F0 08				beq		found_slot
   270 0810 E8					inx
   271 0811 E8					inx
   272 0812 E8					inx
   273 0813 E0 21				cpx		#33
   274 0815 D0 F4				bne		search_loop
   275 0817 60					rts
   276 						
   277 0818			found_slot:
   278 0818 A9 44 9D 1A 03			mva		#'D' hatabs,x
   279 081D A9 C3 9D 1B 03 A9 + 		mwa		#DOSHandlerTable hatabs+1,x
   280 						
   281 						;set MEMLO
   282 0827 AE 09 07				ldx		bcb_maxfiles
   283 082A E8					inx
   284 082B 8A					txa
   285 082C 0A					asl
   286 082D A8					tay
   287 082E A9 00				lda		#0
   288 0830 6A					ror
   289 0831 69 3E				adc		#<dos_sectorbuffers
   290 0833 8D E7 02				sta		memlo
   291 0836 98					tya
   292 0837 69 0C				adc		#>dos_sectorbuffers
   293 0839 8D E8 02				sta		memlo+1
   294 						
   295 						;attempt to load AUTORUN.SYS with IOCB #1
   296 083C A9 03 8D 52 03			mva		#CIOCmdOpen iccmd+$10
   297 0841 A9 71 8D 54 03 A9 + 		mwa		#autorunsys_fname icbal+$10
   298 084B A9 04 8D 5A 03			mva		#$04 icax1+$10
   299 0850 A2 10				ldx		#$10
   300 0852 20 56 E4				jsr		ciov
   301 0855 30 0B				bmi		load_failed
   302 						
   303 						;load the executable
   304 0857 20 7F 08				jsr		DOSLoadExecutable
   305 085A B0 06				bcs		load_failed
   306 						
   307 085C 20 67 08				jsr		close_iocb
   308 085F 6C E0 02				jmp		(runad)
   309 						
   310 0862			load_failed:
   311 						;close IOCB #1
   312 0862 20 67 08				jsr		close_iocb
   313 						
   314 						
   315 0865 18					clc
   316 0866 60					rts
   317 						
   318 0867			close_iocb:
   319 0867 A9 0C 8D 52 03			mva		#CIOCmdClose iccmd+$10
   320 086C A2 10				ldx		#$10
   321 086E 4C 56 E4				jmp		ciov
   322 						
   323 0871			autorunsys_fname:
   324 0871 44 3A 41 55 54 4F + 		dta		'D:AUTORUN.SYS',$9b
   325 				.endp
