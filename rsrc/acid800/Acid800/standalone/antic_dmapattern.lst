    23 				; MEMORY MAP (800)
    24 				;
    25 				;	$0000-007F		OS zero page
    26 				;	$0080-00BF		Module zero page
    27 				;	$00C0-00DF		Library zero page
    28 				;	$00E0-00EF		80-column zero page
    29 				;	$0100-01FF		6502 stack
    30 				;	$0200-03FF		OS database
    31 				;	$0400-09FF		Boot loader / unused
    32 				;	$0A00-0AFF		Boot loader / Veronica support resident page
    33 				;	$0B00-0BFF		Boot loader / sector load buffer
    34 				;	$0C00-0FFF		Boot loader / 16K display
    35 				;	$1000-18FF		Resident test driver (full suite only)
    36 				;	$1900-19FF		Segment tables (full suite only)
    37 				;	$1A00-1FFF		Library code
    38 				;	$2000-3FFF		Module run area
    39 				;	$4000-5FFF		Segment load area / Extended memory window
    40 				;	$6000-7FFF		80-column screen A / Extended memory window
    41 				;	$9000-9BFF		80-column driver
    42 				;	$9C00-9FFF		Unused (display list if cart)
    43 				;	$A000-BFFF		80-column screen B
    44 				;
    45 				; MEMORY MAP (5200)
    46 				;
    47 				;	$0000-001F		OS zero page
    48 				;	$0020-003F		Display zero page
    49 				;	$0080-00BF		Module zero page
    50 				;	$00C0-00DF		Library zero page
    51 				;	$0100-01FF		6502 stack
    52 				;	$0200-021F		OS database
    53 				;	$0220-027F		Unused
    54 				;	$0280-02FF		Library database
    55 				;	$0300-07FF		Display memory
    56 				;	$0800-0FFF		Unused
    57 				;	$1000-1FFF		LZ decompression history window
    58 				;	$2000-3FFF		Module run area
    59 				;	$4000-BFFF		Cartridge library code and module store
    60 				;
