   790 				;==========================================================================
   791 				.nowarn .proc _printf
   792 					sta	a0
   793 					sty	a0+1
   794 					ldy	#0
   795 					sty	d0
   796 				charloop:
   797 					lda	(a0),y
   798 					beq	done
   799 					inw	a0
   800 					cmp	#'%'
   801 					beq	special
   802 				escaped:
   803 					jsr	putbyte
   804 				nextchar:
   805 					ldy	#0
   806 					jmp	charloop
   807 				done:
   808 					rts
   809 				special:
   810 					inc	d0
   811 					ldx	d0
   812 					lda	(a0),y
   813 					inw	a0
   814 					cmp #'d'
   815 					bne	notdec
   816 					tya
   817 					sty	a1
   818 					ldy	#6
   819 					sei
   820 					sed
   821 				decloop1:
   822 					rol	d0,x
   823 					adc	a1
   824 					sta	a1
   825 					dey
   826 					bne	decloop1
   827 					sty	a1+1
   828 					ldy	#2
   829 				decloop2:
   830 					rol	d0,x
   831 					adc	a1
   832 					sta	a1
   833 					rol	a1+1
   834 					dey
   835 					bne	decloop2
   836 					cld
   837 					cli
   838 					lda	a1+1
   839 					beq	decdigit2
   840 					tax
   841 					lda	_hexdig,x
   842 					jsr	putbyte
   843 					lda	a1
   844 					jsr	puthex
   845 					jmp	nextchar
   846 				decdigit2:
   847 					lda	a1
   848 					cmp	#$10
   849 					bcc	decdigit1
   850 					jsr	puthex
   851 					jmp	nextchar
   852 				decdigit1:
   853 					tax
   854 					lda	_hexdig,x
   855 					jmp	escaped
   856
   857 				notdec:
   858 					cmp	#'x'
   859 					bne	nothex
   860 					lda	d0,x
   861 					jsr	puthex
   862 					jmp	nextchar
   863
   864 				nothex:
   865 					cmp	#'X'
   866 					bne	nothexword
   867 					inc	d0
   868 					lda	d1,x
   869 					jsr	puthex
   870 					ldx	d0
   871 					lda	d0-1,x
   872 					jsr	puthex
   873 					jmp	nextchar
   874
   875 				nothexword:
   876 					cmp #'D'
   877 					bne	notdecword
   878
   879 					ldy	#8
   880 					lda	#0
   881 					sta	a1
   882 					sta a1+1
   883 					sta	a2
   884 					sei
   885 					sed
   886 				decword1:
   887 					rol	d1,x
   888 					lda	a1
   889 					adc	a1
   890 					sta	a1
   891 					lda	a1+1
   892 					adc	a1+1
   893 					sta	a1+1
   894 					dey
   895 					bne	decword1
   896 					
   897 					ldy	#8
   898 				decword2:
   899 					rol	d0,x
   900 					lda	a1
   901 					adc	a1
   902 					sta	a1
   903 					lda	a1+1
   904 					adc	a1+1
   905 					sta	a1+1
   906 					lda	a2
   907 					adc	a2
   908 					sta	a2
   909 					dey
   910 					bne	decword2
   911 					cld
   912 					cli
   913 					
   914 					tax
   915 					beq	decword3
   916 					jsr	puthexcond
   917 					lda	a1+1
   918 					jsr	puthex
   919 					lda	a1
   920 					jsr	puthex
   921 					jmp	nextchar
   922
   923 				decword3:
   924 					lda	a1+1
   925 					beq	decword4
   926 					lda	a1
   927 					jsr	puthex
   928 					jmp	nextchar
   929 					
   930 				decword4:
   931 					lda	a1
   932 					jsr	puthex
   933 					jmp	nextchar
   934
   935 				notdecword:
   936 					cmp #'c'
   937 					bne	notchar
   938 					inc	d0
   939 					lda	d0,x
   940 					jsr	putbyte
   941 					jmp	nextchar
   942 					
   943 				notchar:
   944 					cmp #'s'
   945 					bne	notstr
   946 					
   947 					inc	d0
   948 					lda	d0,x
   949 					sta	a1
   950 					lda	d0+1,x
   951 					sta	a1+1
   952
   953 				strloop:
   954 					ldy	#0
   955 					lda	(a1),y
   956 					beq	strdone
   957 					jsr	putbyte2
   958 					inw	a1
   959 					jmp	strloop
   960
   961 				strdone:
   962 					jmp	nextchar
   963 					
   964 				notstr:
   965 					dec	d0
   966 					jmp	escaped
   967 					
   968 				puthexcond:
   969 					cmp	#$10
   970 					bcs	puthex
   971 					tax
   972 					lda	_hexdig,x
   973 					jmp	putbyte	
   974 				puthex:	
   975 					pha
   976 					lsr
   977 					lsr
   978 					lsr
   979 					lsr
   980 					tax
   981 					lda	_hexdig,x
   982 					jsr	putbyte
   983 					pla
   984 					and	#$0f
   985 					tax
   986 					lda	_hexdig,x
   987 					jmp	putbyte
   988
   989 				putbyte:
   990 					tax
   991 					jsr	putbyte2
   992 					txa
   993 					rts
   994 					
   995 				putbyte2:
   996 					jmp	(_vputchar)
   997 				.endp
