   220 						.ifdef SYS5200
   221 A146 A9 FF 85 C9 A9 3F + 		mwa		#$3FFF d1
   222 						.else
   223 						mwa		memtop d1
   224 						.endif
   225 						
   226 A14E AD 8B 02				lda		_cpuMode
   227 A151 0A					asl
   228 A152 AD 8B 02				lda		_cpuMode
   229 A155 2A					rol
   230
   231 A156 AA					tax
   232 A157 BD B9 A1 85 CB			mva		cpu_lo_tab,x d3
   233 A15C BD BD A1 85 CC			mva		cpu_hi_tab,x d3+1
   234 						
   235 A161 20 59 41				jsr		_imprintf
   236 A164 48 49 4D 45 4D 3A + 		dta		c"HIMEM: $%X  CPU: %s",$9B,0
   237 						
   238 						;checksum the ROM and report it
   239 				.ifdef SYS5200
   240 A179 A9 F0 85 C1 A9 00 + 		mwa		#$f0 a0+1
   241 				.else
   242 						mwa		#$d8 a0+1
   243 				.endif
   244 A181 A0 00				ldy		#0
   245 A183 84 C0				sty		a0
   246 A185 84 C9				sty		d1
   247 A187 84 CA				sty		d2
   248 A189 18					clc
   249 A18A			chk_loop:
   250 A18A A5 C9				lda		d1
   251 A18C 71 C0				adc		(a0),y
   252 A18E 85 C9				sta		d1
   253 A190 C8					iny
   254 A191 A5 CA				lda		d2
   255 A193 71 C0				adc		(a0),y
   256 A195 85 CA				sta		d2
   257 A197 C8					iny
   258 A198 D0 F0				bne		chk_loop
   259 A19A E6 C1				inc		a0+1
   260 A19C D0 EC				bne		chk_loop
   261 						
   262 A19E 20 59 41				jsr		_imprintf
   263 A1A1 4F 53 20 72 6F 6D + 		dta		c"OS rom checksum: $%X",$9B,$9B,0
   264 						
   265 A1B8 60					rts
   266 						
   267 A1B9			cpu_lo_tab:
   268 A1B9 C1					dta		<(str6502)
   269 A1BA CC					dta		<(str65C816_16)
   270 A1BB C6					dta		<(str65C02)
   271 A1BC D7					dta		<(str65C816_24)
   272
   273 A1BD			cpu_hi_tab:
   274 A1BD A1					dta		>(str6502)
   275 A1BE A1					dta		>(str65C816_16)
   276 A1BF A1					dta		>(str65C02)
   277 A1C0 A1					dta		>(str65C816_24)
   278
   279 A1C1			str6502:
   280 A1C1 36 35 30 32 00			dta		c"6502",0
   281 A1C6			str65C02:
   282 A1C6 36 35 43 30 32 00			dta		c"65C02",0
   283 A1CC			str65C816_16:
   284 A1CC 36 35 43 38 31 36 + 		dta		c"65C816[16]",0
   285 A1D7			str65C816_24:
