   769 				;==========================================================================
   770 				.nowarn .proc _print
   771 					sta	a0
   772 					sty	a0+1
   773 				charloop:
   774 					ldy	#0
   775 					lda	(a0),y
   776 					beq	done
   777 					inw	a0
   778 					jsr	_printf.putbyte
   779 					jmp	charloop
   780 				done:
   781 					rts
   782 				.endp
