   398 				;=======================================================================
   399 				.nowarn .proc _log_printf
   400 						sta		a0
   401 						sty		a0+1
   402 						ldy		#0
   403 						sty		d0
   404 						
   405 				charloop:
   406 						lda		(a0),y
   407 						beq		done
   408 						inw		a0
   409 						cmp		#'%'
   410 						beq		special
   411 				escaped:
   412 						jsr		_log_putchar
   413 				nextchar:
   414 						ldy		#0
   415 						beq		charloop
   416
   417 				done:
   418 						rts
   419
   420 				special:
   421 						inc		d0
   422 						ldx		d0
   423 						lda		(a0),y
   424 						inw		a0
   425 						cmp		 #'d'
   426 						bne		notdec
   427 						tya
   428 						sty		a1
   429 						ldy		#6
   430 						sei
   431 						sed
   432 				decloop1:
   433 						rol		d0,x
   434 						adc		a1
   435 						sta		a1
   436 						dey
   437 						bne		decloop1
   438 						sty		a1+1
   439 						ldy		#2
   440 				decloop2:
   441 						rol		d0,x
   442 						adc		a1
   443 						sta		a1
   444 						rol		a1+1
   445 						dey
   446 						bne		decloop2
   447 						cld
   448 						cli
   449 						lda		a1+1
   450 						beq		decdigit2
   451 						tax
   452 						lda		_hexdig,x
   453 						jsr		putbyte
   454 						lda		a1
   455 						jmp		puthex_nextchar
   456 						
   457 				decdigit2:
   458 						lda		a1
   459 						cmp		#$10
   460 						bcc		decdigit1
   461 						jmp		puthex_nextchar
   462 						
   463 				decdigit1:
   464 						tax
   465 						lda		_hexdig,x
   466 						jmp		escaped
   467
   468 				notdec:
   469 						cmp		#'x'
   470 						bne		nothex
   471 						lda		d0,x
   472 						jmp		puthex_nextchar
   473
   474 				nothex:
   475 						cmp		#'X'
   476 						bne		nothexword
   477 						inc		d0
   478 						lda		d1,x
   479 						jsr		puthex
   480 						ldx		d0
   481 						lda		d0-1,x
   482 						jmp		puthex_nextchar
   483
   484 				nothexword:
   485 						cmp		 #'D'
   486 						bne		notdecword
   487
   488 						ldy		#8
   489 						lda		#0
   490 						sta		a1
   491 						sta		a1+1
   492 						sta		a2
   493 						sei
   494 						sed
   495 				decword1:
   496 						rol		d1,x
   497 						lda		a1
   498 						adc		a1
   499 						sta		a1
   500 						lda		a1+1
   501 						adc		a1+1
   502 						sta		a1+1
   503 						dey
   504 						bne		decword1
   505 					
   506 						ldy		#8
   507 				decword2:
   508 						rol		d0,x
   509 						lda		a1
   510 						adc		a1
   511 						sta		a1
   512 						lda		a1+1
   513 						adc		a1+1
   514 						sta		a1+1
   515 						lda		a2
   516 						adc		a2
   517 						sta		a2
   518 						dey
   519 						bne		decword2
   520 						cld
   521 						cli
   522 					
   523 						tax
   524 						beq		decword3
   525 						jsr		puthexcond
   526 						
   527 						lda		a1+1
   528 						jsr		puthex
   529 						lda		a1
   530 						jmp		puthex_nextchar
   531
   532 				decword3:
   533 						lda		a1+1
   534 						beq		decword4
   535 						jsr		puthexcond
   536 						lda		a1
   537 				puthex_nextchar:
   538 						jsr		puthex
   539 						jmp		nextchar
   540 					
   541 				decword4:
   542 						lda		a1
   543 						jsr		puthexcond
   544 						jmp		nextchar
   545
   546 				notdecword:
   547 						cmp		 #'c'
   548 						bne		notchar
   549 						lda		d0,x
   550 						jsr		putbyte
   551 				strdone:
   552 						jmp		nextchar
   553 					
   554 				notchar:
   555 						cmp		 #'s'
   556 						bne		notstr
   557 					
   558 						inc		d0
   559 						lda		d0,x
   560 						sta		a1
   561 						lda		d0+1,x
   562 						sta		a1+1
   563
   564 				strloop:
   565 						ldy		#0
   566 						lda		(a1),y
   567 						beq		strdone
   568 						jsr		_log_putchar
   569 						inw		a1
   570 						jmp		strloop
   571 					
   572 				notstr:
   573 						cmp		#'f'
   574 						bne		notfloat
   575
   576 						inc		d0
   577 						lda		d0+1,x
   578 						tay
   579 						lda		d0,x
   580 						tax
   581 						jsr		fld0r
   582 						jsr		fasc
   583 						ldx		inbuff
   584 				nextfloatchar:
   585 						lda		+(lbuff&$ff00),x
   586 						inx
   587 						pha
   588 						and		#$7f
   589 						jsr		_log_putchar
   590 						pla
   591 						bpl		nextfloatchar
   592 						jmp		nextchar
