   421 9189			.proc	rewriteDisplayList
   422 9189 A9 00				lda		#0
   423 918B 85 E2				sta		rowptr1
   424 918D 85 E4				sta		rowptr2
   425 918F A9 98 85 E3				mva		#>dlist1 rowptr1+1
   426 9193 A9 9C 85 E5				mva		#>dlist2 rowptr2+1
   427 9197 A0 00				ldy		#0
   428 9199 A2 00				ldx		#0
   429 						
   430 						;24 blank lines
   431 919B A9 70				lda		#$70
   432 919D 20 E6 91				jsr		putbyte
   433 91A0 20 E6 91				jsr		putbyte
   434 91A3 20 E6 91				jsr		putbyte
   435 						
   436 						;192 LMS lines
   437 91A6			lineloop:
   438 91A6 A9 00 85 E8				mva		#0 cha
   439 91AA			rowloop:
   440 91AA A9 4F				lda		#$4F
   441 91AC 20 E6 91				jsr		putbyte
   442 91AF BD 1E 92				lda		rowaddrlo,x
   443 91B2 20 E6 91				jsr		putbyte
   444 91B5 BD 36 92				lda		rowaddrhi,x
   445 91B8 18					clc
   446 91B9 65 E8				adc		cha
   447 91BB 09 60				ora		#$60
   448 91BD 91 E2				sta		(rowptr1),y
   449 91BF 49 C0				eor		#$c0
   450 91C1 91 E4				sta		(rowptr2),y
   451 91C3 20 EA 91				jsr		putbyte1
   452 91C6 E6 E8				inc		cha
   453 91C8 A5 E8				lda		cha
   454 91CA C9 08				cmp		#8
   455 91CC D0 DC				bne		rowloop
   456 91CE E8					inx
   457 91CF E0 18				cpx		#24
   458 91D1 D0 D3				bne		lineloop
   459 						
   460 						;add wait for VBL insn
   461 91D3 A9 41				lda		#$41
   462 91D5 20 E6 91				jsr		putbyte
   463 91D8 A9 00				lda		#<dlist1
   464 91DA 20 E6 91				jsr		putbyte
   465 91DD A9 9C				lda		#>dlist2
   466 91DF 91 E2				sta		(rowptr1),y
   467 91E1 A9 98				lda		#>dlist1
   468 91E3 91 E4				sta		(rowptr2),y
   469 91E5 60					rts
   470 						
   471 91E6			putbyte:
   472 91E6 91 E2				sta		(rowptr1),y
   473 91E8 91 E4				sta		(rowptr2),y
   474 91EA			putbyte1:
   475 91EA C8					iny
   476 91EB D0 04				bne		putbyte2
   477 91ED E6 E3				inc		rowptr1+1
   478 91EF E6 E5				inc		rowptr2+1
   479 91F1			putbyte2:
   480 91F1 60					rts
   481 				.endp
