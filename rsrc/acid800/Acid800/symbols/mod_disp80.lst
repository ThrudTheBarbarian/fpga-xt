   221 907E			.proc	scroll80
   222 						;rotate row lines
   223 907E AD 1E 92				lda		rowaddrlo
   224 9081 48					pha
   225 9082 AD 36 92				lda		rowaddrhi
   226 9085 48					pha
   227 						
   228 9086 A2 E9				ldx		#$e9
   229 9088			shiftloop:
   230 9088 BD 36 91				lda		rowaddrlo-$e8,x
   231 908B 9D 35 91				sta		rowaddrlo-$e9,x
   232 908E BD 4E 91				lda		rowaddrhi-$e8,x
   233 9091 9D 4D 91				sta		rowaddrhi-$e9,x
   234 9094 E8					inx
   235 9095 D0 F1				bne		shiftloop
   236 						
   237 9097 68					pla
   238 9098 8D 4D 92				sta		rowaddrhi+23
   239 909B 68					pla
   240 909C 8D 35 92				sta		rowaddrlo+23
   241 						
   242 						;remake display list
   243 909F 20 89 91				jsr		rewriteDisplayList
   244 						
   245 						;clear row 23
   246 90A2 AD 4D 92				lda		rowaddrhi+23
   247 90A5 09 60				ora		#$60
   248 90A7 85 E3				sta		rowptr1+1
   249 90A9 49 C0				eor		#$c0
   250 90AB 85 E5				sta		rowptr2+1
   251 90AD AD 35 92				lda		rowaddrlo+23
   252 90B0 85 E2				sta		rowptr1
   253 90B2 85 E4				sta		rowptr2
   254 						
   255 90B4 A9 00				lda		#0
   256 90B6 A2 08				ldx		#8
   257 90B8			yloop:
   258 90B8 A0 27				ldy		#39
   259 90BA			xloop:
   260 90BA 91 E2				sta		(rowptr1),y
   261 90BC 91 E4				sta		(rowptr2),y
   262 90BE 88					dey
   263 90BF 10 F9				bpl		xloop
   264 90C1 E6 E3				inc		rowptr1+1
   265 90C3 E6 E5				inc		rowptr2+1
   266 90C5 CA					dex
   267 90C6 D0 F0				bne		yloop
   268 						
   269 90C8 A9 17				lda		#23
   270 90CA 85 E0				sta		row
   271 90CC 4C CF 90				jmp		recompRowAddr
   272 				.endp
