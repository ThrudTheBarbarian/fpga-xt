  1227 				;==========================================================================
  1228 				; Exit:
  1229 				;	A = $fe		WTF -- didn't hit any of the code.
  1230 				;	A = $00		Address read from bank $00, jumped to code in bank $00
  1231 				;	A = $01		Address read from bank $01, jumped to code in bank $00
  1232 				;	A = $02		Address read from bank $00, jumped to code in bank $01
  1233 				;	A = $03		Address read from bank $01, jumped to code in bank $01
  1234 				;
  1235 				; Remarks:
  1236 				;	JMP (abs) reads the jump address from bank 0 and jumps to that address
  1237 				;	in the current program bank. Therefore, calling this in bank $01 should
  1238 				;	give A=$02.
  1239 				;
  1240 3CB7			.proc JmpTest
  1241 3CB7 A9 FE				lda.b	#$fe
  1242 3CB9 6C C1 3C				jmp		(addr)
  1243 3CBC			pt2:
  1244 3CBC 1A					inc
  1245 3CBD			pt1:
  1246 3CBD 18					clc
  1247 3CBE 69 02				adc.b	#2				;patched to 4 in bank $01
  1248 = 3CBF			addval = *-1
  1249 3CC0 6B					rtl
  1250
  1251 3CC1			addr:
  1252 3CC1 BD 3C				dta		a(pt1)			;patched to pt2 in bank $01
  1253 				.endp
  1254
  1255 				;==========================================================================
  1256 				; Exit:
  1257 				;	A = $fe		WTF -- didn't hit any of the code.
  1258 				;	A = $ff		WTF -- indexing didn't occur.
  1259 				;	A = $00		Address read from bank $00, jumped to code in bank $00
  1260 				;	A = $01		Address read from bank $01, jumped to code in bank $00
  1261 				;	A = $02		Address read from bank $00, jumped to code in bank $01
  1262 				;	A = $03		Address read from bank $01, jumped to code in bank $01
  1263 				;
  1264 				; Remarks:
  1265 				;	JMP (abs,X) reads the jump address from the current program bank and
  1266 				;	jumps to that address in the current program bank. Therefore, calling
  1267 				;	this in bank $01 should give A=$03.
  1268 				;
  1269 3CC3			.proc JmpXTest
  1270 3CC3 A9 FE				lda.b	#$fe
  1271 3CC5 A2 FE FF				ldx.w	#$fffe
  1272 3CC8 7C D5 3C				jmp		(addr+2,X)
  1273 3CCB			pt2:
  1274 3CCB 1A					inc
  1275 3CCC			pt1:
  1276 3CCC 18					clc
  1277 3CCD 69 02				adc.b	#2				;patched to 4 in bank $01
  1278 = 3CCE			addval = *-1
  1279 3CCF 6B					rtl
  1280 3CD0			pt3:
  1281 3CD0 A9 FF				lda.b	#$ff
  1282 3CD2 6B					rtl
  1283 						
  1284 3CD3			addr:
  1285 3CD3 CC 3C				dta		a(pt1)			;patched to pt2 in bank $01
  1286 3CD5 D0 3C				dta		a(pt3)
  1287 				.endp
  1288
  1289 				;==========================================================================
  1290 				; Exit:
  1291 				;	A = $fe		WTF -- didn't hit any of the code.
  1292 				;	A = $ff		WTF -- indexing didn't occur.
  1293 				;	A = $00		Address read from bank $00, jumped to code in bank $00
  1294 				;	A = $01		Address read from bank $01, jumped to code in bank $00
  1295 				;	A = $02		Address read from bank $00, jumped to code in bank $01
  1296 				;	A = $03		Address read from bank $01, jumped to code in bank $01
  1297 				;
  1298 				; Remarks:
  1299 				;	JSR (abs,X) reads the jump address from the current program bank and
  1300 				;	jumps to that address in the current program bank. Therefore, calling
  1301 				;	this in bank $01 should give A=$03.
  1302 				;
  1303 3CD7			.proc JsrXTest
  1304 3CD7 A9 FE				lda.b	#$fe
  1305 3CD9 A2 FE FF				ldx.w	#$fffe
  1306 3CDC FC EA 3C				jsr		(addr+2,X)
  1307 3CDF 6B					rtl
  1308 3CE0			pt2:
  1309 3CE0 1A					inc
  1310 3CE1			pt1:
  1311 3CE1 18					clc
  1312 3CE2 69 02				adc.b	#2				;patched to 4 in bank $01
  1313 = 3CE3			addval = *-1
  1314 3CE4 60					rts
  1315 3CE5			pt3:
  1316 3CE5 A9 FF				lda.b	#$ff
  1317 3CE7 60					rts
  1318
  1319 3CE8			addr:
  1320 3CE8 E1 3C				dta		a(pt1)			;patched to pt2 in bank $01
  1321 3CEA E5 3C				dta		a(pt3)
  1322 				.endp
  1323
