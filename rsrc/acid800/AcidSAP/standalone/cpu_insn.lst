  1251 				; _loadSeg()
  1252 				;
  1253 				; Module loader.
  1254 				;
  1255 				;	X = index of module to load
  1256 				;
  1257 				.ifdef SEGS_MIN_MEM
  1258 				.nowarn .proc	_loadSeg
  1259 					;get starting sector
  1260 					mva		segaddrlo,x	daux1
  1261 					mva		segaddrhi,x	daux2
  1262 						
  1263 					;get ending sector
  1264 					lda		segaddrlo+1,x
  1265 					sub		daux1
  1266 					sta		d7
  1267
  1268 					;setup sector load command and relocation
  1269 					mva		#'R' dcomnd
  1270 					mva		#1 dunit
  1271 					lda		#$00
  1272 					sta		dbuflo
  1273 					sta		a0
  1274 					sta		runad+1
  1275 					lda		#$0b
  1276 					sta		dbufhi
  1277 					sta		a0+1
  1278 					
  1279 					;preload first two sectors
  1280 					jsr		step_sector
  1281 				relocloop:
  1282 					;load starting address
  1283 					mva		(a0),y a1
  1284 					iny:sne:jsr step_sector
  1285 					mva		(a0),y a1+1
  1286 					iny:sne:jsr step_sector
  1287 					
  1288 					;skip $ffff words
  1289 					lda		a1
  1290 					and		a1+1
  1291 					cmp		#$ff
  1292 					beq		relocloop
  1293 					
  1294 					;load ending address
  1295 					mva		(a0),y a2
  1296 					iny:sne:jsr step_sector
  1297 					mva		(a0),y a2+1
  1298 					iny:sne:jsr step_sector
  1299 					inw		a2
  1300
  1301 					mwa		#definit initad
  1302 					
  1303 					;copy data (slow, but oh well)
  1304 					ldx		#0
  1305 				copyloop:
  1306 					lda		(a0),y
  1307 					sta		(a1,x)
  1308 					iny:sne:jsr step_sector
  1309 					inw		a1
  1310 					lda		a1
  1311 					cmp		a2
  1312 					bne		copyloop
  1313 					lda		a1+1
  1314 					cmp		a2+1
  1315 					bne		copyloop
  1316 					
  1317 					;init a segment
  1318 					jsr		doinit
  1319 					
  1320 					;check if we're done
  1321 					lda		runad+1
  1322 					beq		relocloop
  1323 					rts
  1324
  1325 				doinit:
  1326 					jmp		(initad)
  1327 					
  1328 				step_sector:
  1329 					lda		d7
  1330 					beq		no_sectors_left
  1331 					jsr		dskinv
  1332 					dec		d7
  1333 					inw		daux1
  1334 					lda		dbuflo
  1335 					eor		#$80
  1336 					sta		dbuflo
  1337 					bne		step_sector
  1338 				no_sectors_left:
  1339 					ldy		#0
  1340 					ldx		#0
  1341 				definit:
  1342 					rts
  1343 				.endp
  1344 				.else
  1345 4376			.nowarn .proc	_loadSeg
  1346 				.ifdef SEGS_IN_ROM
  1347 4376 8E 8D 02			stx		_lastMod
  1348 4379 60				rts
  1349 				.else
  1350 					;get starting sector
  1351 					mva		segaddrlo,x	daux1
  1352 					mva		segaddrhi,x	daux2
  1353 						
  1354 					;get ending sector
  1355 					mva		segaddrlo+1,x	a0
  1356 					mva		segaddrhi+1,x	a0+1
  1357
  1358 					;load sectors starting at $4000
  1359 				sectorloop:
  1360 					mva		#'R' dcomnd
  1361 					mva		#1 dunit
  1362 					mwa		#$4000 dbuflo
  1363 						
  1364 					jsr		dskinv
  1365 					tya
  1366 					bmi		sectorloop
  1367 					
  1368 					lda		#$80
  1369 					eor		dbuflo
  1370 					sta		dbuflo
  1371 					sne:inc	dbufhi
  1372 					
  1373 					inc		daux1
  1374 					sne:inc	daux2
  1375 					
  1376 					lda		daux1
  1377 					cmp		a0
  1378 					bne		sectorloop
  1379 					lda		daux2
  1380 					cmp		a0+1
  1381 					bne		sectorloop
  1382 					rts
  1383 				.endif
  1384 				.endp
  1385 				.endif
