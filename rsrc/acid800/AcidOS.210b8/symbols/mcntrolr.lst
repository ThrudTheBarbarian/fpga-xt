   122 				.nowarn .proc _log_keyboardirq
   123 						lda		#>next
   124 						pha
   125 						lda		#<next
   126 						pha
   127 						php
   128 						pha
   129 						jmp		$ffff
   130 = 2626			chainaddr = *-2
   131
   132 				next:
   133 						lda		ch
   134 						cmp		#$bf		;CTRL+A
   135 						bne		not_ctrla
   136 						
   137 						;eat the key
   138 						lda		#$ff
   139 						sta		ch
   140 						
   141 						;toggle display flag
   142 						eor		_log_visible
   143 						sta		_log_visible
   144 						bmi		is_visible
   145 						mwa		_log_dlsave sdlstl
   146 				is_visible:
   147 				not_ctrla:
   148 						pla
   149 						rti
   150 				.endp
