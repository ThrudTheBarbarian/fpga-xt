   251 A75C			.proc	_disp_rewriteDisplayList
   252 A75C A9 00 85 22 A9 03 + 		mwa		#$0300 _disp_rowptr
   253 A764 A0 00				ldy		#0
   254 						
   255 						;24 blank lines
   256 A766 A9 70				lda		#$70
   257 A768 91 22 C8				sta:iny	(_disp_rowptr),y
   258 A76B 91 22 C8				sta:iny	(_disp_rowptr),y
   259 A76E 91 22 C8				sta:iny	(_disp_rowptr),y
   260 						
   261 						;24 LMS lines
   262 A771 A2 00				ldx		#0
   263 A773			lineloop:
   264 A773 A9 42 91 22 C8			mva:iny	#$42				(_disp_rowptr),y
   265 A778 BD 80 03 91 22 C8			mva:iny	_disp_rowaddrlo,x	(_disp_rowptr),y
   266 A77E BD 98 03 91 22 C8			mva:iny	_disp_rowaddrhi,x	(_disp_rowptr),y
   267 A784 E8					inx
   268 A785 E0 18				cpx		#24
   269 A787 D0 EA				bne		lineloop
   270 						
   271 						;add wait for VBL insn
   272 A789 A9 41 91 22 C8			mva:iny	#$41		(_disp_rowptr),y
   273 A78E A9 00 91 22 C8			mva:iny	#<$0300		(_disp_rowptr),y
   274 A793 A9 03 91 22				mva		#>$0300		(_disp_rowptr),y
   275 A797 60					rts		
   276 				.endp
