   407 9176 E6 E3				inc		rowptr1+1
   408 9178 E6 E5				inc		rowptr2+1
   409 917A CA					dex
   410 917B D0 ED				bne		loop
   411 917D A5 E3				lda		rowptr1+1
   412 917F 38					sec
   413 9180 E9 08				sbc		#$08
   414 9182 85 E3				sta		rowptr1+1
   415 9184 49 C0				eor		#$c0
   416 9186 85 E5				sta		rowptr2+1
   417 9188 60					rts
   418 				.endp
