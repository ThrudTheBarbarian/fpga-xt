    29 				.macro _MODULEADDRHI
    30 					dta >(mod_:1)
    31 				.endm	
    32
    33 				.macro _MODULEADDRLO
    34 					dta <(mod_:1)
    35 				.endm	
    36 					
    37 = 0000			.def ?module_count = 0
    38
    39 				.macro _MODULELABEL1
    40 					.def mod_:1 = *
    41 				.endm
    42
    43 				.macro _MODULELABEL
    44 					;workaround for annoying MADS bug where MACRO and REPT parameters don't nest properly
    45 					.rept :1+1
    46 					.if # == :1
    47 						_MODULELABEL1 #
    48 					.endif
    49 					.endr
    50 				.endm
    51
    52 				.macro _MODULE
    53 					_MODULELABEL ?module_count
    54 				
    55 					ins	:1
    56 					.def :?module_count = :?module_count + 1
    57 				.endm
