     2 215E 49 6E 63 6F 72 72 + 	dta		c"Incorrect timing for mode %x-%c",0
Source: antic_dmapattern.s
   293 						
   294 217E			bitscancomplete:
   295 						;========================== END SCAN LOOP ===========================
   296 						
   297 						;continue until we've done all 7 offsets
   298 217E A6 96				ldx		delyidx
   299 2180 E8					inx
   300 2181 E8					inx
   301 2182 E0 0E				cpx		#14
   302 2184 F0 03 4C 40 20			seq:jmp	offsetloop
   303 						
   304 						;========================= END OFFSET LOOP ==========================
   305 						
   306 						;bump up test pointer by test size (16 bytes)
   307 2189 A5 94				lda		testptr
   308 218B 18					clc
   309 218C 69 10				adc		#16
   310 218E 85 94				sta		testptr
   311 2190 90 02 E6 95				scc:inc	testptr+1
   312 						
   313 						;continue if we still have tests
   314 2194 A0 00				ldy		#0
   315 2196 B1 94				lda		(testptr),y
   316 2198 F0 03				beq		done
   317 219A 4C 3E 20				jmp		testloop
   318 						
   319 219D			done:
   320 						;all done!
   321 219D 4C CE 1D				jmp		_testPassed
