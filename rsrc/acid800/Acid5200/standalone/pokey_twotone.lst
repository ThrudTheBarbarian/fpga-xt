    81 				;==========================================================================
    82 A68B			.proc	_disp_putchar
    83 A68B 85 24				sta		_disp_cha
    84 A68D 98					tya
    85 A68E 48					pha
    86 						
    87 A68F 20 53 A7				jsr		_disp_toggleCursor
    88 						
    89 A692 A5 24				lda		_disp_cha
    90 						
    91 						;check for newline
    92 A694 C9 9B				cmp		#$9b
    93 A696 F0 30				beq		newline
    94 						
    95 						;check for clear line
    96 A698 C9 9C				cmp		#$9c
    97 A69A F0 26				beq		isclearline
    98 						
    99 						;check for clear screen
   100 A69C C9 7D				cmp		#$7d
   101 A69E F0 11				beq		isclearscrn
   102
   103 						;draw raw character
   104 A6A0 20 3E A7				jsr		_disp_putraw
   105 						
   106 						;update position and exit
   107 A6A3 E6 21				inc		_disp_col
   108 A6A5 A5 21				lda		_disp_col
   109 A6A7 C9 27				cmp		#39
   110 A6A9 B0 1D				bcs		newline
   111 A6AB			alldone:
   112 A6AB 20 53 A7				jsr		_disp_toggleCursor
   113
   114 A6AE 68					pla
   115 A6AF A8					tay
   116 A6B0 60					rts
   117 						
   118 A6B1			isclearscrn:
   119 A6B1 20 98 A7				jsr		_disp_clearScreen
   120 A6B4 A9 00 85 20				mva		#0 _disp_row
   121 A6B8 A9 02 85 21				mva		#2 _disp_col
   122 A6BC 20 31 A7				jsr		_disp_recompRowAddr
   123 A6BF 4C AB A6				jmp		alldone
   124 				 
   125 A6C2			isclearline:
   126 A6C2 20 E1 A6				jsr		_disp_clearLine
   127 A6C5 4C AB A6				jmp		alldone
   128 						
   129 A6C8			newline:
   130 						;reset X position
   131 A6C8 A9 02 85 21				mva		#2 _disp_col
   132 						
   133 						;increment Y position
   134 A6CC E6 20				inc		_disp_row
   135 						
   136 						;check if we've gone over
   137 A6CE A5 20				lda		_disp_row
   138 A6D0 C9 18				cmp		#24
   139 A6D2 90 07				bcc		noscroll
   140 						
   141 						;whoops... looks like we'll have to scroll
   142 A6D4 A9 17 85 20				mva		#23 _disp_row
   143 A6D8 20 F1 A6				jsr		_disp_scroll
   144
   145 A6DB			noscroll:
   146 A6DB 20 31 A7				jsr		_disp_recompRowAddr
   147 A6DE 4C AB A6				jmp		alldone
   148 				.endp
