   531 				.nowarn .proc	_crt0init
   532 				.ifdef SYSSAP
   533 					jsr		_crt0init_sap
   534 				.endif
   535
   536 					;clear zero page and database
   537 				.ifdef SYS5200
   538 					ldx		#$20
   539 					lda		#0
   540 				zploop:
   541 					sta		0,x
   542 					inx
   543 					bne		zploop
   544 					ldx		#$80
   545 				dbloop:
   546 					sta		$0200,x
   547 					inx
   548 					bne		dbloop
   549 				.endif
   550
   551 					;clear options (keep in sync with options.s)
   552 					ldx		#6
   553 					lda		#0
   554 					.ifdef SYS5200
   555 					sta:rpl	$02f0,x-
   556 					.else
   557 					sta:rpl	$1a00,x-
   558 					.endif
   559 					
   560 					;detect CPU
   561 					ldy		#CPUMODE_6502
   562 					sed
   563 					lda		#$99
   564 					clc
   565 					adc		#$01
   566 					cld
   567 					bne		detdone
   568 					
   569 					;we have at least a 65C02... check for 65C816
   570 					ldy		#CPUMODE_65C02
   571
   572 					sec
   573 					opt		c+
   574 					rep		#$01
   575 					bcs		detdone
   576 					sep		#$01
   577 					bcc		detdone
   578 					
   579 					ldy		#CPUMODE_65C816_16
   580 					
   581 					;check for 24-bit addressing
   582 					lda		d3+$10000
   583 					tax
   584 					eor		#$f5
   585 					sta		d3
   586 					txa
   587 					cmp		d3+$10000
   588 					sne
   589 					iny
   590 					
   591 					opt		c-
   592 					
   593 				detdone:
   594 					sty		_cpuMode
   595
   596 				.ifdef SYS5200
   597 					jsr		_crt0init_5200
   598 				.endif
   599
   600 				.ifdef SYS800
   601 					;init putchar handler
   602 					mwa		icptl _vputchar
   603 					inw		_vputchar
   604 				.endif
   605
   606 					rts
   607 				.endp
