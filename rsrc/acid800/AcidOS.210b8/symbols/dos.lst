   758 				;==========================================================================
   759 0B8E			.proc DOSGetStatus
   760 0B8E A0 85				ldy		#CIOStatNotOpen
   761 0B90 BD 07 09				lda		dos_fcb_table[0].secbuf,x
   762 0B93 30 03				bmi		not_open
   763 0B95 A0 01				ldy		#1
   764 0B97 60					rts
   765 0B98			not_open:
   766 0B98 A4 49				ldy		errno
   767 0B9A 60					rts
   768 				.endp
