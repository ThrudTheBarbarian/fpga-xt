   209 A0EC			.proc	printBanner
   210 A0EC 20 46 41				jsr		_imprint
   211 A0EF 7D					dta		$7d
   212 						.ifdef SYS5200
   213 A0F0 41 6C 74 69 72 72 + 		dta		c"Altirra Acid5200 test, V1.2",$9B
   214 						.else
