   392 915C			.proc	toggleCursor80
   393 915C A2 08				ldx		#8
   394 915E A5 E1				lda		col
   395 9160 4A					lsr
   396 9161 A8					tay
   397 9162 A9 F0				lda		#$f0
   398 9164 90 02 A9 0F				scc:lda	#$0f
   399 9168 85 E9				sta		chb
   400 916A			loop:
