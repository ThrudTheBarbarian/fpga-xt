   496 9204 91 E2				sta		(rowptr1),y
   497 9206 91 E4				sta		(rowptr2),y
   498 9208 C8					iny
   499 9209 D0 F9				bne		yloop
   500 920B E6 E3				inc		rowptr1+1
   501 920D E6 E5				inc		rowptr2+1
   502 920F CA					dex
   503 9210 D0 F0				bne		xloop
   504 9212 60					rts
   505 				.endp
   506
   507 				;=========================================================================
   508 9213			.proc	vbiHandler
   509 9213 AD 31 02				lda		sdlsth
   510 9216 49 04				eor		#$04
   511 9218 8D 31 02				sta		sdlsth
   512 921B 4C 62 E4				jmp		xitvbv
   513 				.endp
   514 				;=========================================================================	
   515 				; We use a bit of a screwed up memory layout here, reminiscent of the
   516 				; Apple II. Six lines are packed at a time into a page, and four pages
   517 				; make up one row across all 24 lines. The row pages are arranged such
   518 				; stepping down a character row simply involves incrementing the high
   519 				; byte.
   520 				;		
   521 921E			rowaddrlo:
   522 921E 00 28 50 78 A0 C8 + 		:4 dta $00, $28, $50, $78, $a0, $c8
   523 						
   524 9236			rowaddrhi:
   525 9236 00 00 00 00 00 00			:6 dta $00
   526 923C 08 08 08 08 08 08			:6 dta $08
   527 9242 10 10 10 10 10 10			:6 dta $10
   528 9248 18 18 18 18 18 18			:6 dta $18
   529
   530 				;=========================================================================	
   531
   532 = 9800			dlist1	equ		$9800
   533 = 9C00			dlist2	equ		$9c00
   534
   535 02E0-02E1> 00 20				run		main
   536 						end
