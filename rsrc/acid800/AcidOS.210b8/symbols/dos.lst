   846 				;==========================================================================
   847 				; Entry:
   848 				;	Y:A		Sector number
   849 				;	X		Sector buffer index
   850 				;
   851 = 0BE9			DOSReadSectorByVar = DOSReadSector.by_var
   852 0BE3			.proc DOSReadSector
   853 0BE3 8D BD 09				sta		dos_seclo
   854 0BE6 8C BE 09				sty		dos_sechi
   855 0BE9			by_var:
   856 0BE9 20 2E 0C				jsr		DOSSetSectorPointer
   857
   858 0BEC DD 97 09				cmp		dos_secbuf_seclo,x
   859 0BEF D0 09				bne		wrong_sector
   860 0BF1 98					tya
   861 0BF2 DD 9F 09				cmp		dos_secbuf_sechi,x
   862 0BF5 D0 03				bne		wrong_sector
