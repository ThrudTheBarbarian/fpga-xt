# Aristo2 -> GEM theme recipe.  name  type  files...
# type: sprite (1 file) | h3 (left center right) | v3 (top center bottom) |
#       nine (tl tc tr  cl cc cr  bl bc br)
# A file token may carry "@90/@180/@270" to rotate it (reuse arrows etc.).

# --- window frame + titlebar -------------------------------------------------
window              nine    window-standard-top-left window-standard-top-center window-standard-top-right window-standard-center-left window-standard-center-center window-standard-center-right window-standard-bottom-left window-standard-bottom-center window-standard-bottom-right
titlebar            h3      window-standard-head-left window-standard-head-center window-standard-head-right
titlebar.inactive   h3      window-standard-head-inactive-left window-standard-head-inactive-center window-standard-head-inactive-right
close               sprite  window-standard-close-button
minimize            sprite  window-standard-minimize-button
maximize            sprite  window-standard-maximize-button

# --- buttons -----------------------------------------------------------------
button              h3      button-bezel-left button-bezel-center button-bezel-right
button.selected     h3      button-bezel-highlighted-left button-bezel-highlighted-center button-bezel-highlighted-right
button.disabled     h3      button-bezel-disabled-left button-bezel-disabled-center button-bezel-disabled-right

# --- text field / popup / combo (with states) --------------------------------
textfield           nine    textfield-bezel-square-0 textfield-bezel-square-1 textfield-bezel-square-2 textfield-bezel-square-3 textfield-bezel-square-4 textfield-bezel-square-5 textfield-bezel-square-6 textfield-bezel-square-7 textfield-bezel-square-8
textfield.focused   nine    textfield-bezel-square-focused-0 textfield-bezel-square-focused-1 textfield-bezel-square-focused-2 textfield-bezel-square-focused-3 textfield-bezel-square-focused-4 textfield-bezel-square-focused-5 textfield-bezel-square-focused-6 textfield-bezel-square-focused-7 textfield-bezel-square-focused-8
textfield.disabled  nine    textfield-bezel-square-disabled-0 textfield-bezel-square-disabled-1 textfield-bezel-square-disabled-2 textfield-bezel-square-disabled-3 textfield-bezel-square-disabled-4 textfield-bezel-square-disabled-5 textfield-bezel-square-disabled-6 textfield-bezel-square-disabled-7 textfield-bezel-square-disabled-8
popup               h3      popup-bezel-left popup-bezel-center popup-bezel-right
popup.disabled      h3      popup-bezel-disabled-left popup-bezel-disabled-center popup-bezel-disabled-right
combo               h3      combobox-bezel-left combobox-bezel-center combobox-bezel-right
combo.focused       h3      combobox-bezel-focused-left combobox-bezel-focused-center combobox-bezel-focused-right
combo.disabled      h3      combobox-bezel-disabled-left combobox-bezel-disabled-center combobox-bezel-disabled-right

# --- checkbox / radio (with states) ------------------------------------------
check               sprite  check-box-image
check.selected      sprite  check-box-image-selected
check.mixed         sprite  check-box-image-mixed
check.pressed       sprite  check-box-image-selected-highlighted
radio               sprite  radio-image
radio.selected      sprite  radio-image-selected
radio.pressed       sprite  radio-image-selected-highlighted

# --- scrollbar: vertical (legacy always-on track = a single tileable strip) --
vscroll.track       sprite  scroller-legacy-vertical-track-center
vscroll.thumb       v3      scroller-vertical-knob-top scroller-vertical-knob-center scroller-vertical-knob-bottom
vscroll.up          sprite  datepicker-calendar-arrow-left@90
vscroll.down        sprite  datepicker-calendar-arrow-right@90

# --- scrollbar: horizontal ---------------------------------------------------
hscroll.track       sprite  scroller-legacy-horizontal-track-center
hscroll.thumb       h3      scroller-horizontal-knob-left scroller-horizontal-knob-center scroller-horizontal-knob-right
hscroll.left        sprite  datepicker-calendar-arrow-left
hscroll.right       sprite  datepicker-calendar-arrow-right

# --- sliders -----------------------------------------------------------------
slider.htrack       h3      horizontal-track-left horizontal-track-center horizontal-track-right
slider.vtrack       v3      vertical-track-top vertical-track-center vertical-track-bottom
slider.knob         sprite  knob
slider.knob.hi      sprite  knob-highlighted
slider.circular     sprite  slider-circular-bezel
slider.circular.knob sprite slider-circular-knob

# --- stepper -----------------------------------------------------------------
stepper.up          h3      stepper-bezel-big-up-left stepper-bezel-big-up-center stepper-bezel-big-up-right
stepper.down        h3      stepper-bezel-big-down-left stepper-bezel-big-down-center stepper-bezel-big-down-right

# --- menu --------------------------------------------------------------------
menu                nine    menu-window-rounded-0 menu-window-1 menu-window-rounded-2 menu-window-3 menu-window-4 menu-window-5 menu-window-rounded-6 menu-window-7 menu-window-rounded-8
menu.tick           sprite  menu-item-on-state

# --- table view --------------------------------------------------------------
header              sprite  tableview-headerview
header.pressed      sprite  tableview-headerview-pressed
