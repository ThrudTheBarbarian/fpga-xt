   414 				;==========================================================================
   415 09CF			.proc DOSOpen
   416 						;check if FCB is already open
   417 09CF AD 07 09				lda		dos_fcb_table[0].secbuf
   418 09D2 30 09				bmi		fcb_closed
   419 09D4 A0 81				ldy		#CIOStatIOCBInUse
   420 09D6 60					rts
   421
   422 09D7			too_many_open:
   423 09D7 A0 A1				ldy		#CIOStatTooManyFiles
   424 09D9 60					rts
   425
   426 09DA			fnerr:
   427 09DA A0 A5				ldy		#CIOStatFileNameErr
   428 09DC 60					rts
   429
   430 09DD			fcb_closed:
   431 						;try to find an available sector buffer
   432 09DD 20 98 0A				jsr		DOSFindOpenBuffer
   433 09E0 F0 F5				beq		too_many_open
   434
   435 09E2 A0 00				ldy		#0
   436 09E4 B1 24				lda		(icbalz),y
   437 09E6 C9 44				cmp		#'D'
   438 09E8 F0 02				beq		drvlet_ok
   439 09EA A0 82				ldy		#CIOStatUnkDevice
   440 09EC			drvlet_ok:
   441 09EC C8					iny
   442 						
   443 						;validate optional digit
   444 09ED B1 24				lda		(icbalz),y
   445 09EF C9 31				cmp		#'1'
   446 09F1 90 07				bcc		not_digit
   447 09F3 C9 3A				cmp		#'9'+1
   448 09F5 B0 03				bcs		not_digit
   449 09F7 C8					iny
   450 09F8 B1 24				lda		(icbalz),y
   451 09FA			not_digit:
   452
   453 						;validate colon
   454 09FA C9 3A				cmp		#':'
   455 09FC D0 DC				bne		fnerr
   456 09FE C8					iny
   457 						
   458 						;parse filename
   459 09FF 8E BA 09				stx		dos_iocb
   460 0A02 A2 00				ldx		#0
   461
   462 0A04 B1 24				lda		(icbalz),y
   463 0A06 C9 2A				cmp		#'*'
   464 0A08 D0 04				bne		filename_notstar
   465 0A0A			filename_starfill:
   466 0A0A A9 3F				lda		#'?'
   467 0A0C D0 1E				bne		filename_fill_loop
   468 0A0E			filename_notstar:
   469 0A0E 20 AF 0A				jsr		DOSIsupperWild
   470 0A11			filename_1stok:
   471 0A11 9D AF 09				sta		dos_filename,x
   472 0A14 E8					inx
   473 0A15 C8					iny
   474 						
   475 0A16			filename_loop:
   476 0A16 B1 24				lda		(icbalz),y
   477 0A18 C9 2A				cmp		#'*'
   478 0A1A F0 EE				beq		filename_starfill
   479 0A1C 20 A5 0A				jsr		DOSIsalnumWild
   480 0A1F B0 09				bcs		filename_done
   481 0A21 9D AF 09				sta		dos_filename,x
   482 0A24 C8					iny
   483 0A25 E8					inx
   484 0A26 E0 08				cpx		#8
   485 0A28 D0 EC				bne		filename_loop
   486 						
   487 0A2A			filename_done:
   488 						;pad filename to spaces
   489 0A2A A9 20				lda		#' '
   490 0A2C			filename_fill_loop:
   491 0A2C E0 08				cpx		#8
   492 0A2E F0 06				beq		filename_full
   493 0A30 9D AF 09				sta		dos_filename,x
   494 0A33 E8					inx
   495 0A34 D0 F6				bne		filename_fill_loop
   496 0A36			filename_full:
   497
   498 0A36 B1 24				lda		(icbalz),y
   499 0A38 C9 2E				cmp		#'.'
   500 0A3A D0 19				bne		ext_done
   501 0A3C C8					iny
   502
   503 						;parse extension
   504 0A3D			ext_loop:
   505 0A3D B1 24				lda		(icbalz),y
   506 0A3F C9 2A				cmp		#'*'
   507 0A41 D0 04				bne		ext_notstar
   508 0A43 A9 3F				lda		#'?'
   509 0A45 D0 10				bne		ext_fill_loop
   510 0A47			ext_notstar:
   511 0A47 20 A5 0A				jsr		DOSIsalnumWild
   512 0A4A B0 09				bcs		ext_done
   513 0A4C 9D AF 09				sta		dos_filename,x
   514 0A4F C8					iny
   515 0A50 E8					inx
   516 0A51 E0 0B				cpx		#11
   517 0A53 D0 E8				bne		ext_loop
   518 						
   519 0A55			ext_done:
   520 						;pad filename to spaces
   521 0A55 A9 20				lda		#' '
   522 0A57			ext_fill_loop:
   523 0A57 E0 0B				cpx		#11
   524 0A59 F0 06				beq		ext_full
   525 0A5B 9D AF 09				sta		dos_filename,x
   526 0A5E E8					inx
   527 0A5F D0 F6				bne		ext_fill_loop
   528 0A61			ext_full:
   529
   530 						;search directory
   531 0A61 20 9C 0B				jsr		DOSSearchFilename
   532 0A64 10 01				bpl		found
   533 0A66 60					rts
   534 						
   535 0A67			found:
   536 						;restore IOCB#
   537 0A67 AE BA 09				ldx		dos_iocb
   538 						
   539 						;set up FCB
   540 0A6A 18					clc
   541 0A6B 69 03				adc		#3
   542 0A6D A8					tay
   543 0A6E B1 47				lda		(zsba),y
   544 0A70 9D 09 09				sta		dos_fcb_table[0].sector,x
   545 0A73 C8					iny
   546 0A74 B1 47				lda		(zsba),y
   547 0A76 9D 0A 09				sta		dos_fcb_table[0].sector+1,x
   548 						
   549 0A79 A9 00				lda		#0
   550 0A7B 9D 08 09				sta		dos_fcb_table[0].offset,x
   551
   552 						;find open sector buffer (we confirmed there was one earlier)
   553 0A7E 20 98 0A				jsr		DOSFindOpenBuffer
   554 0A81 9D 07 09				sta		dos_fcb_table[0].secbuf,x
   555 0A84 8A					txa
   556 0A85 99 A7 09				sta		dos_secbuf_fcbidx,y
   557 						
   558 						;read first sector
   559 0A88 BC 0A 09				ldy		dos_fcb_table[0].sector+1,x
   560 0A8B BD 09 09				lda		dos_fcb_table[0].sector,x
   561 0A8E 48					pha
   562 0A8F BD 07 09				lda		dos_fcb_table[0].secbuf,x
   563 0A92 AA					tax
   564 0A93 68					pla
   565 0A94 20 E3 0B				jsr		DOSReadSector
   566
   567 0A97 60					rts
   568 				.endp
   569
   570 				;==========================================================================
   571 0A98			.proc DOSFindOpenBuffer
   572 0A98 AC 09 07				ldy		bcb_maxfiles
   573 0A9B			search_loop:
   574 0A9B B9 A7 09				lda		dos_secbuf_fcbidx,y
   575 0A9E 30 03				bmi		found_unused
   576 0AA0 88					dey
   577 0AA1 D0 F8				bne		search_loop
   578 0AA3			found_unused:
   579 0AA3 98					tya
   580 0AA4 60					rts
   581 				.endp
   582
   583 				;==========================================================================
   584 				; Result:
   585 				;	C=0		Alphanumeric or ?
   586 				;	C=1		Not alphanumeric or ?
   587 				;
   588 = 0AAF			DOSIsupperWild = DOSIsalnumWild.isupperwild_entry
   589 0AA5			.proc DOSIsalnumWild
   590 0AA5 C9 30				cmp		#'0'
   591 0AA7 90 04				bcc		not_digit
   592 0AA9 C9 3A				cmp		#'9'+1
   593 0AAB 90 0F				bcc		done
   594 0AAD			not_digit:
   595 0AAD 29 DF				and		#$df
   596 0AAF			isupperwild_entry:
   597 0AAF C9 41				cmp		#'A'
   598 0AB1 90 08				bcc		fail
   599 0AB3 C9 5B				cmp		#'Z'+1
   600 0AB5 90 05				bcc		done
   601 0AB7 C9 3F				cmp		#'?'
   602 0AB9 F0 01				beq		done
   603 0ABB			fail:
   604 0ABB 38					sec
   605 0ABC			done:
   606 0ABC 60					rts
   607 				.endp
