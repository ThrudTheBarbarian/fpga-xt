   405 09C3			.proc DOSHandlerTable
   406 09C3 CE 09				dta		a(DOSOpen-1)
   407 09C5 BC 0A				dta		a(DOSClose-1)
   408 09C7 CF 0A				dta		a(DOSGetByte-1)
   409 09C9 83 0B				dta		a(DOSPutByte-1)
   410 09CB 8D 0B				dta		a(DOSGetStatus-1)
   411 09CD 9A 0B				dta		a(DOSSpecial-1)
   412 				.endp
