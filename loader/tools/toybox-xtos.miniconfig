# toybox-xtos.miniconfig — the XTOS toy set, applied over allnoconfig
# (KCONFIG_ALLCONFIG + scripts/genconfig.sh -n, same flow as toybox's own
# macos_defconfig). Everything not listed stays off. tools/build-toybox.sh
# drives the build; the loader Makefile links the objects into
# /System/bin/toybox (a PIC .so, DT_NEEDED libc.so).
#
# Shape notes:
# - TOYBOX_FORCE_NOMMU: no fork on the loader; toysh's child paths become
#   vfork+re-exec, which the posix shim maps onto SYS_spawn.
# - toysh (CONFIG_SH) lives in toys/pending/ but is the standard toybox shell.

CONFIG_TOYBOX=y
CONFIG_TOYBOX_FORCE_NOMMU=y

# shell
CONFIG_SH=y

# coreutils
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_LS=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_PWD=y
CONFIG_RMDIR=y
CONFIG_LN=y
CONFIG_UNLINK=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_MKTEMP=y
CONFIG_TOUCH=y
CONFIG_STAT=y
CONFIG_DU=y
CONFIG_DF=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_SLEEP=y
CONFIG_NICE=y
CONFIG_ENV=y
CONFIG_PRINTENV=y
CONFIG_PRINTF=y
CONFIG_DATE=y
CONFIG_CAL=y
CONFIG_WHICH=y
CONFIG_GETOPT=y
CONFIG_TIME=y
# i2c tools drive /OS/dev/i2c-0 via the Linux i2c-dev ioctls (SYS_ioctl).
# i2ctransfer stays out: it needs I2C_RDWR message arrays, not implemented.
CONFIG_I2CDETECT=y
CONFIG_I2CDUMP=y
CONFIG_I2CGET=y
CONFIG_I2CSET=y
# network clients over the PL0 socket ABI (netcat is nc's full name here)
CONFIG_NETCAT=y
CONFIG_WGET=y
# full-screen tools: the kernel tty has a real raw mode (XT_TTY_SETMODE via
# tcsetattr) and poll() waits honestly on console input, so these are usable.
CONFIG_VI=y
CONFIG_HEXEDIT=y
CONFIG_ARCH=y
CONFIG_UNAME=y

# text / pipeline filters
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_SED=y
CONFIG_FIND=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TEE=y
CONFIG_TAC=y
CONFIG_NL=y
CONFIG_OD=y
CONFIG_STRINGS=y
CONFIG_EXPAND=y
CONFIG_FOLD=y
CONFIG_SPLIT=y
CONFIG_CMP=y
CONFIG_CKSUM=y
CONFIG_CRC32=y
CONFIG_COUNT=y
CONFIG_TS=y
CONFIG_ASCII=y
CONFIG_CLEAR=y
CONFIG_FILE=y
CONFIG_PATCH=y
CONFIG_UNIX2DOS=y
CONFIG_DOS2UNIX=y

# encoders / hashes / archives
CONFIG_BASE32=y
CONFIG_BASE64=y
CONFIG_UUENCODE=y
CONFIG_UUDECODE=y
CONFIG_UUIDGEN=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA224SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA384SUM=y
CONFIG_SHA512SUM=y
CONFIG_TAR=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y

# process tools (need /OS/Proc + SYS_kill). timeout stays out: it is built
# around ASYNC SIGCHLD delivery (handler + siglongjmp), which the soft-signal
# system cannot drive.
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PS=y
CONFIG_TOP=y

# the multiplexer's help
CONFIG_TOYBOX_HELP=y
CONFIG_TOYBOX_HELP_DASHDASH=y
CONFIG_HELP=y
