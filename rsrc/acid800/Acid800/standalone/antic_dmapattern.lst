   468 227E BD 00 36 85 C0			mva		lfsrlo1,x a0
   469 2283 BD 00 37 85 C1			mva		lfsrhi1,x a0+1
   470 2288 A5 91				lda		rand2
   471 228A D1 C0				cmp		(a0),y
