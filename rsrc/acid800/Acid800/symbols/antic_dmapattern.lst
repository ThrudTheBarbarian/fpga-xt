  1387 				;==========================================================================
  1388 				; _runSeg()
  1389 				;
  1390 				; Module relocator and executor.
  1391 				;
  1392 				; The last segment loaded by _loadSeg() is relocated and executed.
  1393 				;
  1394
  1395 				.ifdef SEGS_MIN_MEM
  1396
  1397 				;-----------------------------------------------
  1398 				; Minimum memory implementation.
  1399 				.nowarn .proc _runSeg
  1400 					jmp		(runad)
  1401 				.endp
  1402
  1403 				.else
  1404
  1405 				;-----------------------------------------------
  1406 				.nowarn .proc _runSeg
  1407 					
  1408 					;begin relocation
  1409 					mwa		#relocloop runad
  1410
  1411 					.ifdef SEGS_IN_ROM
  1412 					ldx		_lastMod
  1413 					mva		segaddrlo,x a0
  1414 					mva		segaddrhi,x a0+1
  1415 					.else
  1416 					mwa		#$4000 a0
  1417 					.endif
  1418 					
  1419 					.ifndef SEGS_LZPACK
  1420 					
  1421 					;==== uncompressed version
  1422
  1423 					ldy		#0
  1424 				relocloop:
  1425 					;load starting address
  1426 					mva		(a0),y a1
  1427 					inw		a0
  1428 					mva		(a0),y a1+1
  1429 					inw		a0
  1430 					
  1431 					;skip $ffff words
  1432 					lda		a1
  1433 					and		a1+1
  1434 					cmp		#$ff
  1435 					beq		relocloop
  1436 					
  1437 					;load ending address
  1438 					mva		(a0),y a2
  1439 					inw		a0
  1440 					mva		(a0),y a2+1
  1441 					inw		a0
  1442 					inw		a2
  1443 					
  1444 					;copy data (slow, but oh well)
  1445 				copyloop:
  1446 					lda		(a0),y
  1447 					sta		(a1),y
  1448 					inw		a0
  1449 					inw		a1
  1450 					lda		a1
  1451 					cmp		a2
  1452 					bne		copyloop
  1453 					lda		a1+1
  1454 					cmp		a2+1
  1455 					bne		copyloop
  1456 					
  1457 					;init a segment
  1458 					mwa		#definit initad
  1459 					jsr		doinit
  1460 					jmp		(runad)
  1461
  1462 				doinit:
  1463 					jmp		(initad)
  1464 					
  1465 				definit:
  1466 					rts
  1467
  1468 					.else
  1469 					
  1470 					;==== compressed version
  1471 					;
  1472 					;loader:
  1473 					;	a3		destination
  1474 					;	d6/d7	segment end address
  1475 					;
  1476 					;decompressor:
  1477 					;	a0		raw source stream
  1478 					;	a1		run source pointer
  1479 					;	a2		window pointer ($1000-1fff)
  1480 					;	d0		literal/run flag bits
  1481 					;	d1		remaining flag bits shifter
  1482 					;	d2		run length counter
  1483 					;	d3		temporary
  1484 					;	d4		superflag bits
  1485 					;	d5		superflag shifter
  1486
  1487 					lda		#0
  1488 					sta		d0
  1489 					sta		d1
  1490 					sta		d2
  1491 					sta		d5
  1492 					sta		a2
  1493 					lda		#$10
  1494 					sta		a2+1
  1495 				relocloop:
  1496 					ldy		#0
  1497 					;load starting address
  1498 					jsr		getbyte
  1499 					sta		a3
  1500 					jsr		getbyte
  1501 					sta		a3+1
  1502 					
  1503 					;skip $ffff words
  1504 					and		a3
  1505 					cmp		#$ff
  1506 					beq		relocloop
  1507 					
  1508 					;load ending address
  1509 					jsr		getbyte
  1510 					sta		d6
  1511 					jsr		getbyte
  1512 					sta		d7
  1513 					inw		d6
  1514 					
  1515 					;copy data (slow, but oh well)
  1516 				copyloop:
  1517 					jsr		getbyte
  1518 					sta		(a3),y
  1519 					inw		a3
  1520 					lda		a3
  1521 					cmp		d6
  1522 					bne		copyloop
  1523 					lda		a3+1
  1524 					cmp		d7
  1525 					bne		copyloop
  1526 					
  1527 					;init a segment
  1528 					mwa		#definit initad
  1529 					jsr		doinit
  1530 					jmp		(runad)
  1531
  1532 				doinit:
  1533 					jmp		(initad)
  1534 					
  1535 				getbyte:
  1536 					;check if we have a run in progress
  1537 					lda		d2
  1538 					bne		getrunbyte
  1539
  1540 					;check if we need to reload flag bits
  1541 					asl		d1
  1542 					bne		havebits
  1543 					
  1544 					;check if we need to reload superflag bits
  1545 					asl		d5
  1546 					bne		havesuperbits
  1547 					
  1548 					;load next superflag byte
  1549 					jsr		getrawbyte
  1550 					sta		d4
  1551 					lda		#$7f
  1552 					sta		d5
  1553 					
  1554 				havesuperbits:
  1555 					;pull next superflag and check if it's all literals (0)
  1556 					asl		d4
  1557 					bcc		all_literals
  1558 					
  1559 					;nope... read next byte as flags byte
  1560 					jsr		getrawbyte
  1561 					sta		d0
  1562
  1563 				all_literals:
  1564 					lda		#$7f
  1565 					sta		d1
  1566 				havebits:
  1567 					asl		d0
  1568 					bcs		isrun
  1569 					
  1570 					;store byte into window
  1571 					jsr		getrawbyte
  1572 					jmp		putwinbyte
  1573
  1574 				isrun:
  1575 					;load offset/run bytes
  1576 					jsr		getrawbyte
  1577 					sta		d3
  1578 					jsr		getrawbyte
  1579 					sta		d2
  1580 					
  1581 					;compute run source from current position and offset
  1582 					lda		a2
  1583 					clc
  1584 					sbc		d3
  1585 					sta		a1
  1586 					lda		a2+1
  1587 					sbc		d2
  1588 					and		#$0f
  1589 					ora		#$10
  1590 					sta		a1+1
  1591 					
  1592 					;compute length and stash run length
  1593 					lda		d2
  1594 					lsr
  1595 					lsr
  1596 					lsr
  1597 					lsr
  1598 					add		#3
  1599 					sta		d2
  1600 				getrunbyte:
  1601 					dec		d2
  1602 					ldy		#0
  1603 					lda		(a1),y
  1604 					inc		a1
  1605 					bne		putwinbyte
  1606 					inc		a1+1
  1607 					pha
  1608 					lda		a1+1
  1609 					and		#$0f
  1610 					ora		#$10
  1611 					sta		a1+1
  1612 					pla
  1613 					jmp		putwinbyte
  1614 					
  1615 				getrawbyte:
  1616 					lda		(a0),y
  1617 					inw		a0
  1618 					rts
  1619 					
  1620 				putwinbyte:
  1621 					sta		(a2),y
  1622 					inc		a2
  1623 					seq:rts
  1624 					ldy		a2+1
  1625 					iny
  1626 					cpy		#$20
  1627 					sne:ldy	#$10
  1628 					sty		a2+1
  1629 					ldy		#0
  1630 				definit:
  1631 					rts	
  1632 					
  1633 					.endif
  1634 				.endp
  1635 				.endif
  1636
  1637 				;==========================================================================
  1638 				_hexdig	dta		c"0123456789ABCDEF"
  1639
  1640 				;==========================================================================
  1641 				; segment table
  1642 				;
  1643 				.ifndef SYS800
  1644 				segaddrlo	equ	$bf00
  1645 				segaddrhi	equ	$bf80
  1646 				.else
  1647 = 1900			segaddrlo	equ	$1900
  1648 = 1980			segaddrhi	equ	$1980
  1649 				.endif
  1650
  1651 = 0900			_veronicaLaunch = $0900
  1652
  1653 				;==========================================================================
  1654 				; platform-specific library
  1655 				;
  1656 				.ifdef SYS5200
  1657 					icl		'lib5200.s'
  1658 				.endif
  1659 				.ifdef SYSSAP
  1660 					icl		'libsap.s'
  1661 				.endif
  1662
  1663 				;==========================================================================
  1664 				.ifndef STANDALONE
  1665 				.ifdef SYS5200
  1666 					opt	o+
  1667 				.else
  1668 					opt	h+o+
  1669 				.endif
  1670 				.endif
    27
    28 						org		$0080
    29 				quickrs:
    30 FFFF> 0080-009A> 00 00 + 		:16 dta $00
    31 0090 00			rand1	dta		0			;first random value
    32 0091 00			rand2	dta		0			;second random value, 114 cycles past first
    33 0092 00 00		randpos	dta		a(0)		;random position index (1-511)
    34 0094 00 00		testptr	dta		a(0)		;pointer to current test data
    35
    36 0096 00			delyidx	dta		0			;profiling cycle delay (doubled; must be even)
    37 0097 00			profrdy	dta		0			;set when DLI handler should execute test
    38 0098 00			dispslc	dta		0			;display slice (0-3)
    39
    40 0099 00			xsave	dta		0			;DLI X register save
    41 009A 00			ysave	dta		0			;DLI Y register save
    42
    43 009B					org		$2000
    44
    45 				;==========================================================================
    46 				; ANTIC DMA pattern test
    47 				;
    48 				; This test involves quite a bit more trickery than usual, so it deserves
    49 				; some explanation.
    50 				;
    51 				; What we're trying to do is determine which cycles are blocked by ANTIC
    52 				; DMA during a scan line. However, the CPU can't monitor this directly
    53 				; since it's halted, and there isn't a convenient and reliable cycle
    54 				; timer on the A8. High-speed POTs *almost* work for this but have a glitch
    55 				; in HBLANK. Therefore, we use trusty RANDOM instead. In 9-bit mode, we
    56 				; can *almost* read the entire LFSR, but unfortunately we're short one bit.
    57 				; To determine the true position, we take two samples exactly one scanline
    58 				; apart. We can then look up through a series of carefully constructed
    59 				; tables:
    60 				;
    61 				;	lfsrtab		RANDOM values in cycle order (Pad byte + 511 entries).
    62 				;	lfsrlo/hi0	One-based index given RANDOM value, assuming high bit = 0.
    63 				;	lfsrlo/hi1	One-based index given RANDOM value, assuming high bit = 1.
    64 				;
    65 				; Given the first value, we can look up its two possible indices, and
    66 				; check the second value 114 cycles later in the sequence table to select
    67 				; the right once. We then walk down the expected bitmask and LFSR sequence
    68 				; in parallel, counting off the *unhalted* cycles, and checking the LFSR
    69 				; values against the recorded RANDOM values in the scanline. We can't
    70 				; just search the sequence, because all values except 00 occur twice, and
    71 				; the duplicates are sometimes very close (FF FF occurs in it).
    72 				;
    73 				; That leaves sampling RANDOM during the scanline. We can't possibly do it
    74 				; every cycle; the best that the 6502 can do is once every 7 cycles.
    75 				; To work around this we need seven sampling passes all skewed by one
    76 				; cycle apart.
    77 				;
    78 				; Optimizing the sampling passes
    79 				; ------------------------------
    80 				; We have 50 tests to do and 7 passes to do on each test. Older versions
    81 				; of this test used to do one pass a frame, which was annoyingly long
    82 				; at six seconds. The display list has been tightened up and four passes
    83 				; are now done a frame, speeding the test up to a second and a half.
    84 				; The main obstacle to further speedups is the LFSR scanning routine, which
    85 				; takes a few dozen scanlines to analyze the results of a pass.
    86
    87 2000			main:
    88 2000-20C1> A0 23				ldy		#>testname
    89 2002 A9 E4				lda		#<testname
    90 2004 20 4E 1D				jsr		_testInit
    91 						
    92 						;generate 9-bit LFSR tables
    93 2007 20 EC 21				jsr		genlfsr9
    94 						
    95 						;kill screen
    96 200A 20 F7 1A				jsr		_screenOff
    97 200D 20 7B 1A				jsr		_interruptsOff
    98
    99 						;wait for vertical blank and swap in new display list
   100 2010 20 1F 1B				jsr		_waitVBL
   101 						
   102 2013 A9 A0 8D 00 02 A9 + 		mwa		#dli vdslst
   103 201D A9 00 8D 02 D4 A9 + 		mwa		#dlist dlistl
   104 2027 A9 22 8D 00 D4			mva		#$22 dmactl
   105 202C A9 80 8D 0E D4			mva		#$80 nmien
   106
   107 						;switch to 9-bit lfsr
   108 2031 A9 80 8D 08 D2			mva		#$80 audctl
   109 						
   110 						;begin test loop
   111 2036 A9 00 85 94 A9 38 + 		mwa		#testdata testptr
   112 						
   113 						;============================ MODE LOOP =============================
   114 						;This is where we loop through each ANTIC mode in turn.
   115 203E			testloop:
   116 203E A2 00				ldx		#0
   117 						
   118 						;=========================== OFFSET LOOP ============================
   119 						;This is where we loop through unblocked cycle offsets 0-6 for the
   120 						;mode line.
   121 2040			offsetloop:
   122 2040 86 96				stx		delyidx
   123 						
   124 						;wait for scanline 16 every four display slices, as that's what fits
   125 2042 A5 98				lda		dispslc
   126 2044 E6 98				inc		dispslc
   127 2046 29 03				and		#3
   128 2048 D0 07				bne		nowaitvbl
   129 						
   130 204A A9 08				lda		#8
   131 204C CD 0B D4 D0 FB			cmp:rne	vcount
   132 						
   133 2051			nowaitvbl:
   134 						;turn off playfield and display list DMA
   135 2051 A9 00 8D 00 D4			mva		#0 dmactl
   136 						
   137 						;wait for end of scanline
   138 2056 8D 0A D4				sta		wsync
   139 						
   140 						;reset display list -- it's a little too tight to do this before the
   141 						;the display list read, so we safely wait past it and blow a scanline;
   142 						;this requires a minimum of 18 cycles of delay
   143 2059 48 68				pha:pla
   144 205B 48 68				pha:pla
   145 205D 68 68				pla:pla
   146 205F A9 00 8D 02 D4 A9 + 		mwa		#dlist dlistl
   147 						
   148 						;wait for wsync again and turn display DMA back on
   149 2069 A9 22				lda		#$22
   150 206B 8D 0A D4				sta		wsync
   151 206E 8D 00 D4				sta		dmactl
   152
   153 						;signal DLI handler to run
   154 2071 A9 FF 85 97				mva		#$ff profrdy
   155 						
   156 						;wait for DLI to occur
   157 2075 A5 97 D0 FC				lda:rne	profrdy
   158 						
   159 						;set up LFSR index to point to the right location -- we need to be four
   160 						;scanlines + 7 cycles past (106 -> 113) = 463 cycles ahead, but we need
   161 						;one cycle less since we increment at the start below
   162 2079 A5 C0				lda		a0
   163 207B 18					clc
   164 207C 69 5C				adc		#<[462-114]
   165 207E 85 C0				sta		a0
   166 2080 A5 C1				lda		a0+1
   167 2082 29 01				and		#$01
   168 2084 69 01				adc		#>[462-114]
   169 2086			lfsrptrnorm:
   170 2086 C9 02				cmp		#2
   171 2088 90 0B				bcc		lfsrptrok
   172 208A 29 01				and		#1
   173 208C E6 C0				inc		a0
   174 208E D0 05				bne		lfsrptrok
   175 2090 18					clc
   176 2091 69 01				adc		#1
   177 2093 90 F1				bcc		lfsrptrnorm
   178 2095			lfsrptrok:
   179 2095 09 30				ora		#>lfsrtab
   180 2097 85 C1				sta		a0+1
   181 						
   182 						;compute the initial index in unblocked cycles; we need to skip this many
   183 						;in the data.
   184 2099 A5 96				lda		delyidx
   185 209B 4A					lsr
   186 209C AA					tax
   187 209D E8					inx
   188 						
   189 						;============================ SCAN LOOP =============================
   190 						;Here we walk through the test data every 7 unblocked cycles, checking
   191 						;that LFSR values are as expected.
   192 						;
   193 						;	X		Number of unblocked cycles left to advance
   194 						;	Y		Index into test data
   195 						;	A0		Current LFSR data pointer
   196 						;	D0		Current test data; shifted left
   197 						;	D1		Bit counter ($01, $02, $04....)
   198 						;	D2		Temporary
   199 						;	D3		result index
   200 						
   201 						;reset result index
   202 209E A9 00 85 CB				mva		#0 d3
   203 						
   204 						;load first test byte and bit indicator
   205 20A2 A0 01				ldy		#1
   206 20A4 84 C9				sty		d1
   207 20A6 18 A5 94 69 02 8D + 		adw		testptr #2 testpt2
   208 20B5 B1 94 85 C8				mva		(testptr),y d0
   209 						
   210 20B9 A4 C0				ldy		a0
   211 20BB A9 00 85 C0				mva		#0 a0
   212 20BF 4C 26 21				jmp		sevenloop
   213 						
   214 20C2					.align	256
   215
   216 2100			lfsrinc2:
   217 2100-23F6> 48				pha
   218 2101 E6 C1				inc		a0+1
   219 2103 A5 C1				lda		a0+1
   220 2105 C9 32				cmp		#$32
   221 2107 68					pla
   222 2108 90 21				bcc		lfsrinc1
   223 210A C8					iny
   224 210B 48					pha
   225 210C A9 30 85 C1				mva		#>lfsrtab a0+1
   226 2110 68					pla
   227 2111 B0 18				bcs		lfsrinc1
   228
   229 2113			load_new_byte:		
   230 						;load next test byte
   231 2113 AD 00 00				lda.w	$0
   232 = 2114			testpt2 = *-2
   233
   234 2116 EE 14 21 D0 03 EE + 		inw		testpt2
   235 						
   236 						;check if we're done
   237 211E C9 A5				cmp		#$a5
   238 2120 F0 5C				beq		bitscancomplete
   239 						
   240 						;reset byte flag
   241 2122 E6 C9				inc		d1
   242 2124 D0 0C				bne		samebyte
   243
   244 2126			sevenloop:
   245 2126 A5 C8				lda		d0
   246 2128			bitloop:
   247 2128			isblocked:
   248 						;advance to next LFSR index
   249 2128 C8					iny
   250 2129 F0 D5				beq		lfsrinc2
   251 212B			lfsrinc1:
   252
   253 						;advance to next bit in test stream
   254 212B 2A					rol
   255 212C 26 CA				rol		d2
   256 212E 06 C9				asl		d1
   257 2130 B0 E1				bcs		load_new_byte		
   258 2132			samebyte:
   259 						;keep going if this is a blocked cycle
   260 2132 66 CA				ror		d2
   261 2134 B0 F2				bcs		isblocked
   262 						
   263 						;keep going if we still need to skip unblocked cycles
   264 2136 CA					dex
   265 2137 D0 EF				bne		bitloop
   266 						
   267 2139 85 C8				sta		d0
   268 						
   269 						;check if the LFSR value matches
   270 213B A6 CB				ldx		d3
   271 213D E6 CB				inc		d3
   272 213F B5 80				lda		quickrs,x
   273 2141 D1 C0				cmp		(a0),y
   274 2143 D0 05				bne		randfail
   275
   276 						;go back to check another value 7 unblocked cycles later
   277 2145 A2 07				ldx		#7
   278 2147 4C 26 21				jmp		sevenloop
   279 						
   280 214A			randfail:
   281 						;uh oh....
   282 214A A0 00				ldy		#0
   283 214C B1 94				lda		(testptr),y
   284 214E 4A					lsr
   285 214F 4A					lsr
   286 2150 85 C9				sta		d1
   287 2152 B1 94				lda		(testptr),y
   288 2154 29 03				and		#3
   289 2156 18					clc
   290 2157 69 61				adc		#'a'
   291 2159 85 CA				sta		d2
   292 215B					_FAIL	c"Incorrect timing for mode %x-%c"
Macro: _FAIL [Source: library.s]
