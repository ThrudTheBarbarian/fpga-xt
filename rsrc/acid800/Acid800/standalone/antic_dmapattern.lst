   452 				; unrand
   453 				;
   454 				; Converts rand1/rand2 pair into randpos index.
   455 				;
   456 2268			.proc	unrand
   457 						;try first with high bit = 0
   458 2268 A6 90				ldx		rand1
   459 226A BD 00 34 85 C0			mva		lfsrlo0,x a0
   460 226F BD 00 35 85 C1			mva		lfsrhi0,x a0+1
