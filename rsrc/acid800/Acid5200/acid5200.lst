    75 9FC6			.proc main
    76 9FC6			restart:
    77 9FC6 A9 00				lda		#0
    78 9FC8 8D F1 02				sta		passed
    79 9FCB 8D F2 02				sta		failed
    80 9FCE 8D F3 02				sta		skipped
    81 9FD1 A9 01				lda		#TEST_FIRST
    82 9FD3 8D F0 02				sta		testidx
    83
    84 						;print banner
    85 9FD6 20 EC A0				jsr		printBanner
    86 						
    87 						;do countdown
    88 9FD9 A9 00 8D 8E 02			mva		#0 ch
    89 						.ifndef SYS5200
    90 						mva		#0 ch1
    91 						.endif
    92 9FDE A9 05				lda		#5
    93 9FE0			waitloop:
    94 9FE0 48					pha
    95 9FE1 85 C9				sta		d1
    96 9FE3 20 59 41				jsr		_imprintf
    97 9FE6 50 72 65 73 73 20 + 		dta		c"Press key for options... %d",0
    98
    99 						;wait for a key for one second
   100 A002 A9 32				lda		#50
   101 A004 AE 14 C0				ldx		pal
   102 A007 E0 0F				cpx		#$0f
   103 A009 D0 02 A9 3C				sne:lda	#60
   104 A00D 18					clc
   105 						.ifdef SYS5200
   106 A00E 65 02				adc		rtclok+1
   107 						.else
   108 						adc		rtclok+2
   109 						.endif
   110 A010			waitloop2:
   111 A010 AE 8E 02				ldx		ch
   112 A013 F0 33				beq		nokey
   113 						
   114 A015 A9 00 8D 8E 02			mva		#0 ch
   115 						
   116 A01A 20 46 41				jsr		_imprint
   117 A01D 9C 4C 6F 61 64 69 + 		dta		$9c,c"Loading option module...",$9b,0
   118 						
   119 A038 A2 00				ldx		#MOD_OPTIONS
   120 A03A 20 D6 43				jsr		_loadSeg
   121 						
   122 A03D 20 46 41				jsr		_imprint
   123 A040 9C 00				dta		$9c,0
   124 						
   125 A042 20 DA 43				jsr		_runSeg
   126 A045 4C 57 A0				jmp		starttests
   127 						
   128 A048			nokey:
   129 						.ifdef SYS5200
   130 A048 C5 02				cmp		rtclok+1
   131 						.else
   132 						cmp		rtclok+2
   133 						.endif
   134 A04A D0 C4				bne		waitloop2
   135
   136 A04C 20 46 41				jsr		_imprint
   137 A04F 9C 00				dta		$9c,0
   138 					
   139 						;next second
   140 A051 68					pla
   141 A052 38					sec
   142 A053 E9 01				sbc		#1
   143 A055 D0 89				bne		waitloop
   144 						
   145 A057			starttests:
   146 						.ifndef SYS5200
   147 						;check if a button is down
   148 						lda		consol
   149 						and		#7
   150 						cmp		#7
   151 						beq		buttonsup
   152 						
   153 						jsr		_imprint
   154 						dta		c"Waiting for console buttons to release.",$9b,$9b,0
   155
   156 				waitbtns:
   157 						lda		consol
   158 						and		#7
   159 						cmp		#7
   160 						bne		waitbtns
   161 						
   162 				buttonsup:
   163 						.endif
   164
   165 A057			testloop:
   166 A057 AE F0 02				ldx		testidx
   167 A05A EE F0 02				inc		testidx
   168 A05D A9 BB 8D 86 02 A9 + 		mwa		#testnext _exitTest
   169 A067 20 E2 A1				jsr		runtest
   170 A06A AD F1 02 85 C9			mva		passed d1
   171 A06F AD F2 02 85 CA			mva		failed d2
   172 A074 AD F3 02 85 CB			mva		skipped d3
   173 A079 20 59 41				jsr		_imprintf
   174 A07C 41 6C 6C 20 74 65 + 		dta		c"All tests complete.",$9B
   175 A090 50 61 73 73 65 64 + 		dta		c"Passed: %d  Failed: %d  Skipped: %d",$9B,0
   176 						
   177 A0B5 20 03 41				jsr		_waitKeyPrompt
   178 A0B8 4C C6 9F				jmp		restart
   179
   180 A0BB			testnext:
   181 A0BB 10 11				bpl		notfail
   182 						
   183 						;test was failed
   184 A0BD AD F4 02				lda		opt_wait
   185 A0C0 0D F5 02				ora		opt_waitfail
   186 A0C3 10 03 20 03 41			spl:jsr	_waitKeyPrompt
   187
   188 A0C8 EE F2 02				inc		failed
   189 A0CB 4C 57 A0				jmp		testloop
   190 A0CE			notfail:
   191 A0CE F0 0E				beq		waspass
   192 						
   193 						;test was skipped
   194 A0D0 AD F4 02				lda		opt_wait
   195 A0D3 10 03 20 03 41			spl:jsr	_waitKeyPrompt
   196 						
   197 A0D8 EE F3 02				inc		skipped
   198 A0DB 4C 57 A0				jmp		testloop
   199 						
   200 A0DE			waspass:
   201 						;test was passed
   202 A0DE AD F4 02				lda		opt_wait
   203 A0E1 10 03 20 03 41			spl:jsr	_waitKeyPrompt
   204 						
   205 A0E6 EE F1 02				inc		passed
   206 A0E9 4C 57 A0				jmp		testloop
   207 				.endp
