   997 						;====== 8-bit two-tone timer 1 STIMER preemption tests ==============
   998 						;Measures the last cycle on which STIMER can be strobed to affect
   999 						;the timing of the next IRQ.
  1000 						;
  1001 						;			AUDF1*2		AUDF1*3
  1002 						; AUDF1=0	10c/11c		16c/17c		*extrapolated
  1003 						; AUDF1=8	26c/27c		40c/41c
  1004 						; AUDF1=10	30c/31c		46c/47c
  1005
