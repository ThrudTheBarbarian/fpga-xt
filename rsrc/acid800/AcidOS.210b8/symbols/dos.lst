   609 				;==========================================================================
   610 0ABD			.proc DOSClose
   611 0ABD A0 85				ldy		#CIOStatNotOpen
   612 0ABF BD 07 09				lda		dos_fcb_table[0].secbuf,x
   613 0AC2 30 09				bmi		done
   614 0AC4 A8					tay
   615 0AC5 A9 FF				lda		#$ff
   616 0AC7 99 A7 09				sta		dos_secbuf_fcbidx,y
   617 0ACA 9D 07 09				sta		dos_fcb_table[0].secbuf,x
   618 0ACD			done:
   619 0ACD A0 01				ldy		#1
   620 0ACF 60					rts
   621 				.endp
