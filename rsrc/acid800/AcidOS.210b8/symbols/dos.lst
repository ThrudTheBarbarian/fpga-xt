   373 				.struct FCB
   374 = 0000			secbuf	.byte
   375 = 0001			offset	.byte
   376 = 0002			sector	.word
   377 = 0004			pad1	.dword
   378 = 0008			pad2	.dword
   379 = 000C			pad3	.dword
   380 				.ends
