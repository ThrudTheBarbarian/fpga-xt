   382 				.nowarn .proc _log_imprintf
   383 						pla
   384 						tax
   385 						pla
   386 						tay
   387 						inx
   388 						sne:iny
   389 						txa
   390 						jsr		_log_printf
   391 						lda		a0+1
   392 						pha
