  1419 					.ifndef SEGS_LZPACK
  1420 					
  1421 					;==== uncompressed version
  1422
  1423 					ldy		#0
  1424 				relocloop:
  1425 					;load starting address
  1426 					mva		(a0),y a1
  1427 					inw		a0
  1428 					mva		(a0),y a1+1
  1429 					inw		a0
  1430 					
  1431 					;skip $ffff words
  1432 					lda		a1
  1433 					and		a1+1
  1434 					cmp		#$ff
  1435 					beq		relocloop
  1436 					
  1437 					;load ending address
  1438 					mva		(a0),y a2
  1439 					inw		a0
  1440 					mva		(a0),y a2+1
  1441 					inw		a0
  1442 					inw		a2
  1443 					
  1444 					;copy data (slow, but oh well)
  1445 				copyloop:
  1446 					lda		(a0),y
  1447 					sta		(a1),y
  1448 					inw		a0
  1449 					inw		a1
  1450 					lda		a1
  1451 					cmp		a2
  1452 					bne		copyloop
  1453 					lda		a1+1
  1454 					cmp		a2+1
  1455 					bne		copyloop
  1456 					
  1457 					;init a segment
  1458 					mwa		#definit initad
  1459 					jsr		doinit
  1460 					jmp		(runad)
  1461
  1462 				doinit:
  1463 					jmp		(initad)
  1464 					
  1465 				definit:
  1466 					rts
  1467
  1468 					.else
  1469 					
  1470 					;==== compressed version
  1471 					;
  1472 					;loader:
  1473 					;	a3		destination
  1474 					;	d6/d7	segment end address
  1475 					;
  1476 					;decompressor:
  1477 					;	a0		raw source stream
  1478 					;	a1		run source pointer
  1479 					;	a2		window pointer ($1000-1fff)
  1480 					;	d0		literal/run flag bits
  1481 					;	d1		remaining flag bits shifter
  1482 					;	d2		run length counter
  1483 					;	d3		temporary
  1484 					;	d4		superflag bits
  1485 					;	d5		superflag shifter
  1486
  1487 A3F1 A9 00			lda		#0
  1488 A3F3 85 C8			sta		d0
  1489 A3F5 85 C9			sta		d1
  1490 A3F7 85 CA			sta		d2
  1491 A3F9 85 CD			sta		d5
  1492 A3FB 85 C4			sta		a2
  1493 A3FD A9 10			lda		#$10
  1494 A3FF 85 C5			sta		a2+1
  1495 A401			relocloop:
  1496 A401 A0 00			ldy		#0
  1497 					;load starting address
  1498 A403 20 4D A4			jsr		getbyte
  1499 A406 85 C6			sta		a3
  1500 A408 20 4D A4			jsr		getbyte
  1501 A40B 85 C7			sta		a3+1
  1502 					
  1503 					;skip $ffff words
  1504 A40D 25 C6			and		a3
  1505 A40F C9 FF			cmp		#$ff
  1506 A411 F0 EE			beq		relocloop
  1507 					
  1508 					;load ending address
  1509 A413 20 4D A4			jsr		getbyte
  1510 A416 85 CE			sta		d6
  1511 A418 20 4D A4			jsr		getbyte
  1512 A41B 85 CF			sta		d7
  1513 A41D E6 CE D0 02 E6 CF		inw		d6
  1514 					
  1515 					;copy data (slow, but oh well)
  1516 A423			copyloop:
  1517 A423 20 4D A4			jsr		getbyte
  1518 A426 91 C6			sta		(a3),y
  1519 A428 E6 C6 D0 02 E6 C7		inw		a3
  1520 A42E A5 C6			lda		a3
  1521 A430 C5 CE			cmp		d6
  1522 A432 D0 EF			bne		copyloop
  1523 A434 A5 C7			lda		a3+1
  1524 A436 C5 CF			cmp		d7
  1525 A438 D0 E9			bne		copyloop
  1526 					
  1527 					;init a segment
  1528 A43A A9 D5 8D E2 02 A9 + 	mwa		#definit initad
  1529 A444 20 4A A4			jsr		doinit
  1530 A447 6C E0 02			jmp		(runad)
  1531
  1532 A44A			doinit:
  1533 A44A 6C E2 02			jmp		(initad)
  1534 					
  1535 A44D			getbyte:
  1536 					;check if we have a run in progress
  1537 A44D A5 CA			lda		d2
  1538 A44F D0 4E			bne		getrunbyte
  1539
  1540 					;check if we need to reload flag bits
  1541 A451 06 C9			asl		d1
  1542 A453 D0 1A			bne		havebits
  1543 					
  1544 					;check if we need to reload superflag bits
  1545 A455 06 CD			asl		d5
  1546 A457 D0 09			bne		havesuperbits
  1547 					
  1548 					;load next superflag byte
  1549 A459 20 B8 A4			jsr		getrawbyte
  1550 A45C 85 CC			sta		d4
  1551 A45E A9 7F			lda		#$7f
  1552 A460 85 CD			sta		d5
  1553 					
  1554 A462			havesuperbits:
