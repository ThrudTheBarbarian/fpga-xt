   382 				;==========================================================================
   383 0907 FF 00 00 00 00 00 + dos_fcb_table dta FCB [8] (255,0,0,0,0,0)
   384
   385 0997			dos_secbuf_seclo:
   386 0997 00 00 00 00 00 00 + 		:8 dta 0
   387
   388 099F			dos_secbuf_sechi:
   389 099F 00 00 00 00 00 00 + 		:8 dta 0
   390 						
   391 09A7			dos_secbuf_fcbidx:
   392 09A7 FF FF FF FF FF FF + 		:8 dta $ff
   393 						
   394 09AF			dos_filename:
   395 09AF 00 00 00 00 00 00 + 		:11 dta 0
   396 						
   397 09BA 00			dos_iocb	dta		0
   398 09BB 00			dos_dsidx	dta		0			;dirent scan: directory sector index
   399 09BC 00			dos_secbidx	dta		0
   400 09BD 00			dos_seclo	dta		0
   401 09BE 00			dos_sechi	dta		0
   402 09BF 00 00 00 00		dos_segadrs	dta		a(0), a(0)
