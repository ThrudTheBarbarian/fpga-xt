   274 				;==========================================================================
   275 90CF			.proc	recompRowAddr
   276 90CF A6 E0				ldx		row
   277 90D1 BD 1E 92				lda		rowaddrlo,x
   278 90D4 85 E2				sta		rowptr1
   279 90D6 85 E4				sta		rowptr2
   280 90D8 BD 36 92				lda		rowaddrhi,x
   281 90DB 09 60				ora		#$60
   282 90DD 85 E3				sta		rowptr1+1
   283 90DF 49 C0				eor		#$c0
   284 90E1 85 E5				sta		rowptr2+1
   285 90E3 60					rts
   286 				.endp
