   753 				;=======================================================================
   754 				.nowarn .proc _RunTests
   755 				test_loop:
   756 						;read next test line
   757 						mva		#$80 icbll+$20
   758 						mva		#$00 icblh+$20
   759 						ldx		#$20
   760 						jsr		ciov
   761 						bpl		testOK
   762 						jmp		_ExecMenu
   763 				testOK:
   764 						;replace EOL with 0
   765 						ldx		#$ff
   766 						lda		#$9b
   767 				eol_loop:
   768 						inx
   769 						cmp		$0480,x
   770 						bne		eol_loop
   771 						lda		#0
   772 						sta		$0480,x
   773
   774 						mwa		#$0482 d1
   775 						jsr		_log_imprintf
   776 						dta		'--- Test %s ---',$9B,'Loading...',0
   777 								
   778 						;store return stack ptr
   779 						tsx
   780 						inx
   781 						inx
   782 						sta		_test_sp
   783 						
   784 						;load segment
   785 						mva		#'D' $0480
   786 						mva		#':' $0481
   787 						ldx		#$04
   788 						lda		#$80
   789 						jsr		_load_seg
   790 						bmi		fail
   791 						
   792 						;clear loading message
   793 						jsr		_log_imprint
   794 						dta		$9c,0
   795 						
   796 						;run segment
   797 						jsr		_run_seg
   798 						jmp		test_loop
   799 						
   800 				fail:
   801 						sty		d1
   802 						jsr		_log_imprintf
   803 						dta		'FAILED to load: %x',$9b,0
   804 						jsr		_waitKeyPrompt
   805 						jmp		test_loop
   806 				.endp
