  1411 					.ifdef SEGS_IN_ROM
  1412 A3E4 AE E4 02			ldx		_lastMod
  1413 A3E7 BD 00 BF 85 C0		mva		segaddrlo,x a0
  1414 A3EC BD 80 BF 85 C1		mva		segaddrhi,x a0+1
