   212 				;=======================================================================
   213 				.nowarn .proc _log_cls
   214 						ldy		#0
   215 						sty		_log_lncnt
   216 						tya
   217 				clearloop:
   218 						sta		_log_display,y
   219 						sta		_log_displayend-$300,y
   220 						sta		_log_displayend-$200,y
   221 						sta		_log_displayend-$100,y
   222 						iny
   223 						bne		clearloop
   224 						mwa		#_log_display _log_curln
   225 						bne		_log_clearline.xit
   226 				.endp
