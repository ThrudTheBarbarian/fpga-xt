     5 2A8F					_TEST_ENTRY
Macro: _TEST_ENTRY [Source: library.s]
     5 FFFF> 02E0-02E1> 00 2C			run		main
Source: mcntrolr.s
     6
     7 				;==========================================================================
     8 2A8F					org		$80
     9 						opt		o-
    10
    11 0080			CMODES	.enum
    12 = 0000					MultiJoy8
    13 = 0001					Count
    14 						.ende
    15
    16 0080			cmode	dta		0
    17
    18 				;==========================================================================
    19 						opt		o+
    20 0081					org		$2c00
    21
    22 2C00			.proc	main
    23 2C00-2CB0> A9 00 85 80			mva		#0 cmode
    24 2C04 20 61 2C				jsr		RedrawScreen
    25 						
    26 2C07			poll_loop:
    27 2C07 A5 14				lda		rtclok+2
    28 2C09 C5 14 F0 FC				cmp:req	rtclok+2
    29
    30 2C0D 20 13 2C				jsr		Poll		
    31 						
    32 2C10 4C 07 2C				jmp		poll_loop
    33 				.endp
    34
    35 				;==========================================================================
    36 2C13			.proc Poll
    37 2C13 A6 80				ldx		cmode
    38 2C15 BD 1F 2C				lda		disp_hi_table,x
    39 2C18 48					pha
    40 2C19 BD 1E 2C				lda		disp_lo_table,x
    41 2C1C 48					pha
    42 2C1D 60					rts
    43 						
    44 2C1E			disp_lo_table:
    45 2C1E 1F					dta		<[PollMultiJoy8-1]
    46
    47 2C1F			disp_hi_table:
    48 2C1F 2C					dta		>[PollMultiJoy8-1]
    49 				.endp
    50
    51 				;==========================================================================
    52 2C20			.proc PollMultiJoy8
    53 						;switch to DDRA
    54 2C20 AD 02 D3				lda		pactl
    55 2C23 29 FB				and		#$fb
    56 2C25 8D 02 D3				sta		pactl
    57 						
    58 						;enable bits 4-7 for output
    59 2C28 AD 00 D3				lda		porta
    60 2C2B 09 F0				ora		#$f0
    61 2C2D 8D 00 D3				sta		porta
    62 						
    63 						;switch to ORA
    64 2C30 AD 02 D3				lda		pactl
    65 2C33 09 04				ora		#$04
    66 2C35 8D 02 D3				sta		pactl
    67 						
    68 						;select controller
    69 2C38 A5 14				lda		rtclok+2
    70 2C3A 29 07				and		#$07
    71 2C3C A8					tay
    72 2C3D 0A					asl
    73 2C3E 0A					asl
    74 2C3F 0A					asl
    75 2C40 0A					asl
    76 2C41 8D 00 D3				sta		porta
    77 						
    78 						;wait at least 30 cycles
    79 2C44 A2 06				ldx		#6
    80 2C46 CA D0 FD				dex:rne
    81 						
    82 						;poll controller
    83 2C49 AD 00 D3				lda		porta
    84 2C4C 29 0F				and		#$0f
    85 						
    86 						;update screen
    87 2C4E 85 B1				sta		d1
    88 						
    89 2C50 C8					iny
    90 2C51 C8					iny
    91 2C52 C8					iny
    92 2C53 98					tya
    93 2C54 AA					tax
    94 2C55 A9 02				lda		#2
    95 2C57 20 73 26				jsr		_log_gotoxy
    96 2C5A 20 A7 27				jsr		_log_imprintf
    97 2C5D 25 78 00				dta		'%x',0
    98
    99 2C60 60					rts
   100 				.endp
   101
   102 				;==========================================================================
   103 2C61			.proc RedrawScreen
   104 2C61 20 80 27				jsr		_log_imprint
   105 2C64 7D					dta		$7d
   106 2C65 C1 E3 E9 E4 CF D3 + 		dta		'AcidOS manual controller test'*,$9b
   107 2C83 43 6F 6E 74 72 6F + 		dta		'Controller mode: '
   108 2C94 00					dta		0
   109
   110 2C95 A6 80				ldx		cmode
   111 2C97 BD A5 2C 85 C3			mva		cname_lo_tab,x _log_srcptr
   112 2C9C BD A6 2C 85 C4			mva		cname_hi_tab,x _log_srcptr+1
   113 2CA1 20 A2 27				jsr		_log_print
   114 2CA4 60					rts
   115
   116 2CA5			cname_lo_tab:
   117 2CA5 A7					dta		<cname_multijoy8
   118 						
   119 2CA6			cname_hi_tab:
   120 2CA6 2C					dta		>cname_multijoy8
   121 						
   122 2CA7			cname_multijoy8:
   123 2CA7 4D 75 6C 74 69 4A + 		dta		'MultiJoy8',0
   124 				.endp
   125
