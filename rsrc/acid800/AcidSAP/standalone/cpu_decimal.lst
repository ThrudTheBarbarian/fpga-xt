   452 				.macro _ASSERT1
   453 					lda	:1
   454 					cmp	#:2
   455 					beq	pass
   456 					
   457 					sta	d1
   458 					jsr	_testFailed
   459 					dta	:3,0
   460 				pass:
   461 				.endm
