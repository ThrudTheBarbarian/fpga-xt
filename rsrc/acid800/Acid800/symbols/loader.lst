   112 078D			relocdata:
   113 078D FF FF 00 1A 06 1A + 		ins		'menu.obx'
   114 						
   115 0F4E 00 00 00 00 00 00 + 		:((0-*)&$7f) dta 0
   116 0F80			testtable:
