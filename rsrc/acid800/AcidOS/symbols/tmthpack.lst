   152 				;=======================================================================
   153 				.nowarn .proc _log_deferred_vbi
   154 						bit		_log_visible
   155 						bpl		dl_ok
   156 						
   157 						lda		sdlstl
   158 						ldx		sdlsth
   159 						cmp		#<_log_dlist
   160 						bne		dl_replaced
   161 						cpx		#>_log_dlist
   162 						beq		dl_ok
   163 				dl_replaced:
   164 						sta		_log_dlsave
   165 						stx		_log_dlsave+1
   166 						php
   167 						sei
   168 						lda		#<_log_dlist
   169 						sta		sdlstl
   170 						lda		#>_log_dlist
   171 						sta		sdlsth
   172 						plp
