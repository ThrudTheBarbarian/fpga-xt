  1346 				.ifdef SEGS_IN_ROM
  1347 					stx		_lastMod
  1348 					rts
  1349 				.else
  1350 					;get starting sector
  1351 					mva		segaddrlo,x	daux1
  1352 					mva		segaddrhi,x	daux2
  1353 						
  1354 					;get ending sector
  1355 					mva		segaddrlo+1,x	a0
  1356 					mva		segaddrhi+1,x	a0+1
  1357
  1358 					;load sectors starting at $4000
  1359 				sectorloop:
  1360 					mva		#'R' dcomnd
  1361 					mva		#1 dunit
  1362 					mwa		#$4000 dbuflo
  1363 						
  1364 					jsr		dskinv
  1365 					tya
  1366 					bmi		sectorloop
  1367 					
  1368 					lda		#$80
  1369 					eor		dbuflo
  1370 					sta		dbuflo
  1371 					sne:inc	dbufhi
  1372 					
  1373 					inc		daux1
  1374 					sne:inc	daux2
  1375 					
  1376 					lda		daux1
  1377 					cmp		a0
  1378 					bne		sectorloop
  1379 					lda		daux2
  1380 					cmp		a0+1
  1381 					bne		sectorloop
  1382 					rts
  1383 				.endif
  1384 				.endp
  1385 				.endif
