   207 906B 91 E4				sta		(rowptr2),y
   208 906D 88					dey
   209 906E D0 F9				bne		yloop
   210 9070 E6 E3				inc		rowptr1+1
   211 9072 E6 E5				inc		rowptr2+1
   212 9074 CA					dex
