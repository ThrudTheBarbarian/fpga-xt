   328 087F			.proc DOSLoadExecutable
   329 087F A9 02 8D E0 02 A9 + 		mwa		#default_run runad
   330 0889			segment_loop:
   331 0889 A9 02 8D E2 02 A9 + 		mwa		#default_run initad
   332 						
   333 0893 A9 BF 8D 54 03 A9 + 		mwa		#dos_segadrs icbal+$10
   334 089D A9 02 8D 58 03 A9 + 		mwa		#2 icbll+$10
   335 08A7 A9 07 8D 52 03			mva		#CIOCmdGetChars iccmd+$10
   336 08AC 20 56 E4				jsr		ciov
   337 08AF 10 06				bpl		startaddr_ok
   338 08B1 C0 88				cpy		#CIOStatEndOfFile
   339 08B3 D0 4D				bne		load_error
   340 08B5 18					clc
   341 08B6 60					rts
   342
   343 08B7			startaddr_ok:
   344 						;check for $FFFF marker
   345 08B7 AD BF 09				lda		dos_segadrs
   346 08BA 2D C0 09				and		dos_segadrs+1
   347 08BD C9 FF				cmp		#$ff
   348 08BF F0 C8				beq		segment_loop
   349
   350 08C1 A9 C1 8D 54 03 A9 + 		mwa		#dos_segadrs+2 icbal+$10
   351 08CB 20 56 E4				jsr		ciov
   352 08CE 30 32				bmi		load_error
   353 						
   354 08D0 38 AD C1 09 ED BF + 		sbw		dos_segadrs+2 dos_segadrs icbll+$10
   355 08E3 EE 58 03 D0 03 EE + 		inw		icbll+$10
   356 08EB AD BF 09 8D 54 03 + 		mwa		dos_segadrs icbal+$10
   357 08F7 20 56 E4				jsr		ciov
   358 08FA 30 06				bmi		load_error
   359 						
   360 08FC 20 04 09				jsr		do_init
   361 08FF 4C 89 08				jmp		segment_loop
   362 						
   363 0902			default_run:
   364 0902			load_error:
   365 0902 38					sec
   366 0903 60					rts
   367 						
   368 0904			do_init:
   369 0904 6C E2 02				jmp		(initad)
   370 				.endp
