   205 				;==========================================================================
   206 A731			.proc	_disp_recompRowAddr
   207 A731 A6 20				ldx		_disp_row
   208 A733 BD 80 03 85 22			mva		_disp_rowaddrlo,x _disp_rowptr
   209 A738 BD 98 03 85 23			mva		_disp_rowaddrhi,x _disp_rowptr+1
   210 A73D 60					rts
   211 				.endp
