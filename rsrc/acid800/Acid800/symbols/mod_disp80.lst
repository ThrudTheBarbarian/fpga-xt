   289 90E4			.proc	putraw80
   290 						;convert to internal encoding
   291 90E4 48					pha
   292 90E5 4A					lsr
   293 90E6 4A					lsr
   294 90E7 4A					lsr
   295 90E8 4A					lsr
   296 90E9 4A					lsr
   297 90EA 29 03				and		#3
   298 90EC AA					tax
   299 90ED 68					pla
   300 90EE 5D 58 91				eor		convtab,x
   301 						
   302 						;compute character address
   303 90F1 2A					rol
   304 90F2 2A					rol
   305 90F3 2A					rol
   306 90F4 AA					tax
   307 90F5 29 F8				and		#$f8
   308 90F7 85 E6				sta		chaddr
   309 90F9 8A					txa
   310 90FA 2A					rol
   311 90FB 29 03				and		#$03
   312 90FD 09 E0				ora		#$e0
   313 90FF 85 E7				sta		chaddr+1
   314 						
   315 						;start row loop
   316 9101 A9 00				lda		#0
   317 9103 85 EA				sta		rowcntr
   318 9105			rowloop:
   319 						;convert a row
   320 9105 A4 EA				ldy		rowcntr
   321 9107 B1 E6				lda		(chaddr),y
   322 9109 0A					asl
   323 910A A2 04				ldx		#4
   324 910C			bitloop:
   325 910C 6A					ror
   326 910D 66 E8				ror		cha
   327 910F 6A					ror
   328 9110 66 E9				ror		chb
   329 9112 CA					dex
   330 9113 D0 F7				bne		bitloop
   331 						
   332 						;shift down if needed
   333 9115 A5 E1				lda		col
   334 9117 A2 F0				ldx		#$f0
   335 9119 4A					lsr
   336 911A A8					tay
   337 911B 90 0B				bcc		leftside
   338 						
   339 911D A2 04				ldx		#4
   340 911F			shiftloop:
   341 911F 46 E8				lsr		cha
   342 9121 46 E9				lsr		chb
   343 9123 CA					dex
   344 9124 D0 F9				bne		shiftloop
   345 9126 A2 0F				ldx		#$0f
   346 9128			leftside:
   347
   348 						;merge in character
   349 9128 86 EB				stx		mask
   350
   351 912A B1 E2				lda		(rowptr1),y
   352 912C 45 E8				eor		cha
   353 912E 25 EB				and		mask
   354 9130 51 E2				eor		(rowptr1),y
   355 9132 91 E2				sta		(rowptr1),y
   356 9134 E6 E3				inc		rowptr1+1
   357
   358 9136 B1 E4				lda		(rowptr2),y
   359 9138 45 E9				eor		chb
   360 913A 25 EB				and		mask
   361 913C 51 E4				eor		(rowptr2),y
   362 913E 91 E4				sta		(rowptr2),y
   363 9140 E6 E5				inc		rowptr2+1
   364
   365 						;do more rows		
   366 9142 E6 EA				inc		rowcntr
   367 9144 A5 EA				lda		rowcntr
   368 9146 C9 08				cmp		#8
   369 9148 D0 BB				bne		rowloop
   370 						
   371 						;restore row pointers
   372 914A 38					sec
   373 914B A5 E3				lda		rowptr1+1
   374 914D E9 08				sbc		#$08
   375 914F 85 E3				sta		rowptr1+1
   376 9151 A5 E5				lda		rowptr2+1
   377 9153 E9 08				sbc		#$08
   378 9155 85 E5				sta		rowptr2+1
   379
   380 						;all done
   381 9157 60					rts
   382 						
   383 9158			convtab:
   384 9158 40					dta		$40
   385 9159 20					dta		$20
   386 915A 60					dta		$60
   387 915B 00					dta		$00
   388
   389 				.endp
