   744 				.nowarn .proc _ExecMenu
   745 						ldx		#>menu_exe
   746 						lda		#<menu_exe
   747 						jmp		_Exec
   748
   749 				menu_exe:
   750 						dta		'D:MENU.EXE',$9B		
   751 				.endp
