    58 2025 8C 00 A0				sty		$A000
    59 2028 EC 00 80				cpx		$8000
    60 202B F0 02 69 01				seq:adc	#1
    61 202F CC 00 A0				cpy		$A000
    62 2032 F0 02 69 01				seq:adc	#1
