#!/usr/bin/env bash
# grab — capture the board's screen to a PNG on the Mac.
#
#   ./grab            -> ./grab.png
#   ./grab foo        -> ./foo.png     (in the CALLING directory)
#   ./grab shots/foo  -> ./shots/foo.png
#
# fbgrab writes the plane to the SD root (NOT /tmp: the ramfs truncates at 1MB and a
# 1080p PPM is 6.2MB), we pull it over ssh and convert with sips (macOS built-in).
# BOARD can override the host (mDNS may be cold right after a boot — see sdpush).
set -euo pipefail

BOARD="${BOARD:-xtos.local}"
FALLBACK="192.168.192.179"
NAME="${1:-grab}"
NAME="${NAME%.png}"                       # "foo.png" and "foo" both -> foo.png
OUT="${NAME}.png"
TMP="$(mktemp /tmp/grab.XXXXXX.ppm)"
trap 'rm -f "$TMP"' EXIT

host="$BOARD"
if ! ping -c1 -t 2 "$host" >/dev/null 2>&1; then
    host="$FALLBACK"
    ping -c1 -t 2 "$host" >/dev/null 2>&1 || { echo "grab: board unreachable ($BOARD, $FALLBACK)" >&2; exit 1; }
fi

ssh -o ConnectTimeout=10 "root@$host" 'fbgrab /grab.ppm >/dev/null && cat /grab.ppm && rm -f /grab.ppm' > "$TMP"
[ -s "$TMP" ] || { echo "grab: empty capture from $host" >&2; exit 1; }
sips -s format png "$TMP" --out "$OUT" >/dev/null
echo "grab: $OUT ($(stat -f%z "$OUT") bytes, from $host)"
