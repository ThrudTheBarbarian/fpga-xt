   871 						
   872 						;issue a disk sector read
   873 0BFD AD BD 09 8D 0A 03 + 		mwa		dos_seclo daux1
   874 0C09 A5 47 8D 04 03 A5 + 		mwa		zsba dbuflo
   875 0C13 A9 52 8D 02 03			mva		#'R' dcomnd
   876 0C18 20 53 E4				jsr		dskinv
   877 0C1B 30 10				bmi		error
   878 						
