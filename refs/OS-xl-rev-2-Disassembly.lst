                  *               1. Bring closer to Coding Standard (object :
                  *                  R. K. Nordin 11/01/83


      = E510      IND     =       *       ;entry
E510  A082                LDY     #NONDEV ;nonexistent device error

E512  4C70E6      IND1    JMP     SSC     ;set status and complete operation,:




                  **      LHO - Load Peripheral Handler for OPEN
                  *
                  *       ENTRY   JSR     LHO
                  *
