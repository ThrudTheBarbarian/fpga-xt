C8A5  6D8F02              ADC     NEWADR+1
C8A8  8537                STA     LTEMP+1
C8AA  A000                LDY     #0
C8AC  B136                LDA     (LTEMP),Y       ;get the content of offset+:
C8AE  18                  CLC
C8AF  7DD102              ADC     LOADAD,X        ;do relocating fixup
C8B2  9136                STA     (LTEMP),Y       ;restore the being fixed va:
C8B4  60                  RTS                     ;return






