    94 						
    95 						;check for clear line
    96 A280 C9 9C				cmp		#$9c
    97 A282 F0 26				beq		isclearline
    98 						
    99 						;check for clear screen
   100 A284 C9 7D				cmp		#$7d
   101 A286 F0 11				beq		isclearscrn
