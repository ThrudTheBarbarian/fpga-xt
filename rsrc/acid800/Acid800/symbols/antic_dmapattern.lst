  1055 					ldx		#0
  1056 					stx		icax1
  1057 					mva		#$0c icax2
  1058 					jsr		ciov
  1059 					
  1060 				iocb0_open:
  1061 				.endif
  1062
  1063 					jsr		_crt0init
  1064 					
  1065 					pla
  1066 					tay
  1067 					pla
  1068 					.endif
  1069 					
  1070 					jsr	_print
  1071 					jsr	_imprint
  1072 					dta	c"...",0
  1073 					
  1074 					.ifdef STANDALONE
  1075 					mwa	#_testEnd _exitTest
  1076 					.else
  1077 					:10 nop
  1078 					.endif
  1079 					
  1080 					rts
