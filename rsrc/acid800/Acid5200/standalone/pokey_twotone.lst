   151 A6E1			.proc	_disp_clearLine
   152 A6E1 A9 00				lda		#0
   153 A6E3 A0 28				ldy		#40
   154 A6E5			yloop:
   155 A6E5 91 22				sta		(_disp_rowptr),y
   156 A6E7 88					dey
   157 A6E8 10 FB				bpl		yloop
   158 						
   159 A6EA A9 02 85 21				mva		#2 _disp_col
   160 						
   161 A6EE 4C 31 A7				jmp		_disp_recompRowAddr
   162 				.endp
   163
   164 				;==========================================================================
   165 A6F1			.proc	_disp_scroll
   166 						;rotate row lines
   167 A6F1 AD 80 03				lda		_disp_rowaddrlo
   168 A6F4 48					pha
   169 A6F5 AD 98 03				lda		_disp_rowaddrhi
   170 A6F8 48					pha
   171 						
   172 A6F9 A2 E9				ldx		#$e9
   173 A6FB			shiftloop:
   174 A6FB BD 98 02				lda		_disp_rowaddrlo-$e8,x
   175 A6FE 9D 97 02				sta		_disp_rowaddrlo-$e9,x
   176 A701 BD B0 02				lda		_disp_rowaddrhi-$e8,x
   177 A704 9D AF 02				sta		_disp_rowaddrhi-$e9,x
   178 A707 E8					inx
   179 A708 D0 F1				bne		shiftloop
   180 						
   181 A70A 68					pla
   182 A70B 8D AF 03				sta		_disp_rowaddrhi+23
   183 A70E 68					pla
   184 A70F 8D 97 03				sta		_disp_rowaddrlo+23
   185 						
   186 						;remake display list
   187 A712 20 5C A7				jsr		_disp_rewriteDisplayList
   188 						
   189 						;clear row 23
   190 A715 AD AF 03 85 23			mva		_disp_rowaddrhi+23 _disp_rowptr+1
   191 A71A AD 97 03 85 22			mva		_disp_rowaddrlo+23 _disp_rowptr
   192 						
   193 A71F A9 00				lda		#0
   194 A721 A0 27				ldy		#39
   195 A723			xloop:
   196 A723 91 22				sta		(_disp_rowptr),y
   197 A725 88					dey
   198 A726 10 FB				bpl		xloop
   199 A728 E6 23				inc		_disp_rowptr+1
   200 						
   201 A72A A9 17 85 20				mva		#23 _disp_row
   202 A72E 4C 31 A7				jmp		_disp_recompRowAddr
   203 				.endp
